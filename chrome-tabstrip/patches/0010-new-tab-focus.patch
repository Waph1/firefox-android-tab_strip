+package org.mozilla.fenix.patchfeatures
+
+import androidx.navigation.NavController
+import androidx.navigation.findNavController
+import org.mozilla.fenix.HomeActivity
+import org.mozilla.fenix.NavGraphDirections
+import org.mozilla.fenix.R
+import org.mozilla.fenix.ext.components
+
+/**
+ * Optional feature "new tab with the address bar focused" (`0010-new-tab-focus.patch`): the new tab button of the tab
+ * strip opens a new tab with the address bar already focused, ready to type an address or a search, whatever the
+ * settings of the homepage (upstream focuses it only with some of them).
+ */
+object NewTabFocusFeature : PatchFeatureHooks {
+    override fun openNewTab(activity: HomeActivity): Boolean {
+        openNewTabWithFocus(
+            isPrivate = activity.browsingModeManager.mode.isPrivate,
+            isHomepageAsNewTab = activity.components.settings.enableHomepageAsNewTab,
+            addHomepageTab = { isPrivate ->
+                activity.components.useCases.fenixBrowserUseCases.addNewHomepageTab(private = isPrivate)
+            },
+            navController = activity.findNavController(R.id.container),
+        )
+        return true
+    }
+}
+
+/**
+ * Opens a new tab like Firefox does, then shows the homepage with the address bar focused.
+ *
+ * @param isPrivate Whether the new tab is private, like the tabs shown by the tab strip.
+ * @param isHomepageAsNewTab Whether Firefox shows the homepage in a new tab of its own (otherwise the homepage is shown
+ *   without a tab, and the tab is created when an address or a search is entered).
+ * @param addHomepageTab Adds and selects a new homepage tab, private or not.
+ * @param navController The [NavController] used to show the homepage.
+ */
+internal fun openNewTabWithFocus(
+    isPrivate: Boolean,
+    isHomepageAsNewTab: Boolean,
+    addHomepageTab: (isPrivate: Boolean) -> Unit,
+    navController: NavController,
+) {
+    if (isHomepageAsNewTab) {
+        addHomepageTab(isPrivate)
+    }
+    navController.navigate(NavGraphDirections.actionGlobalHome(focusOnAddressBar = true))
+}
