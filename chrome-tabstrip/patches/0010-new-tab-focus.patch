+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import androidx.navigation.NavController
+import io.mockk.mockk
+import io.mockk.verify
+import io.mockk.verifyOrder
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.mozilla.fenix.NavGraphDirections
+
+class NewTabFocusFeatureTest {
+    private val navController: NavController = mockk(relaxed = true)
+    private val addHomepageTab: (Boolean) -> Unit = mockk(relaxed = true)
+
+    @Test
+    fun `GIVEN the homepage has no tab of its own WHEN a new tab is opened THEN the homepage is focused`() {
+        openNewTabWithFocus(isPrivate = false, isHomepageAsNewTab = false, addHomepageTab, navController)
+
+        verify(exactly = 0) { addHomepageTab(any()) }
+        verify { navController.navigate(NavGraphDirections.actionGlobalHome(focusOnAddressBar = true)) }
+    }
+
+    @Test
+    fun `GIVEN the homepage is shown in a new tab WHEN a new tab is opened THEN it is added, then focused`() {
+        openNewTabWithFocus(isPrivate = true, isHomepageAsNewTab = true, addHomepageTab, navController)
+
+        verifyOrder {
+            addHomepageTab(true)
+            navController.navigate(NavGraphDirections.actionGlobalHome(focusOnAddressBar = true))
+        }
+    }
+
+    @Test
+    fun `GIVEN the patch of the feature is applied THEN the feature opens the new tabs of the tab strip`() {
+        assertTrue(NewTabFocusFeature in PatchFeatureHooks.all)
+    }
+}
