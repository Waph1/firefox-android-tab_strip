+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class TabStripModeToggleTest {
+
+    @Test
+    fun `GIVEN only normal tabs WHEN showing normal tabs THEN there is no private mode toggle`() {
+        val browserState =
+            BrowserState(
+                tabs =
+                    listOf(
+                        createTab(id = "1", url = "https://www.mozilla.org"),
+                        createTab(id = "2", url = "https://www.example.com"),
