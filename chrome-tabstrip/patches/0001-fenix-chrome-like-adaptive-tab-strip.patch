+// Geometry and timings modelled on the tab strip of Chrome for Android (StripLayoutHelper / TabUiThemeUtil).
+private val minTabWidth = 108.dp
+private val maxTabWidth = 265.dp
+private val minTabWidthForCloseButton = 156.dp
+private val tabTopMargin = 6.dp
+private val folioCornerRadius = 10.dp
+private val folioFootRadius = 8.dp
+private val stripHorizontalPadding = 8.dp
+private val tabContentStartPadding = 12.dp
+private val tabContentEndPadding = 4.dp
+private val faviconSize = 16.dp
+private val faviconTitleSpacing = 8.dp
+private val closeButtonSize = 28.dp
