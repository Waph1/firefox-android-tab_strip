+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.browser.desktopmode
+
+import io.mockk.coEvery
+import io.mockk.coVerify
+import io.mockk.mockk
+import io.mockk.verify
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.runTest
+import mozilla.components.browser.state.action.BrowserAction
+import mozilla.components.browser.state.action.ContentAction
+import mozilla.components.browser.state.action.DefaultDesktopModeAction
+import mozilla.components.browser.state.action.EngineAction
+import mozilla.components.browser.state.action.TabListAction
+import mozilla.components.browser.state.selector.findCustomTab
+import mozilla.components.browser.state.selector.findTab
+import mozilla.components.browser.state.state.BrowserState
+import mozilla.components.browser.state.state.CustomTabSessionState
+import mozilla.components.browser.state.state.SessionState
+import mozilla.components.browser.state.state.TabSessionState
+import mozilla.components.browser.state.state.createCustomTab
+import mozilla.components.browser.state.state.createTab
+import mozilla.components.browser.state.state.recover.RecoverableTab
+import mozilla.components.browser.state.state.recover.TabState
+import mozilla.components.browser.state.store.BrowserStore
+import mozilla.components.concept.engine.EngineSession
+import mozilla.components.lib.state.Middleware
+import mozilla.components.support.test.robolectric.testContext
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mozilla.fenix.GleanMetrics.DesktopMode
+import org.mozilla.fenix.helpers.FenixGleanTestRule
+import org.robolectric.RobolectricTestRunner
+
+@RunWith(RobolectricTestRunner::class)
+class AdaptiveDesktopModeMiddlewareTest {
+
+    @get:Rule val gleanTestRule = FenixGleanTestRule(testContext)
+
+    private val testDispatcher = StandardTestDispatcher()
+    private val scope = CoroutineScope(testDispatcher)
+    private val isLargeWindow = MutableStateFlow<Boolean?>(null)
+
+    // Saved preferences: like upstream, desktop sites by default in large windows only.
+    private val desktopBrowsingPreference = mutableMapOf(true to true, false to false)
+    private var savedTabsWithOwnDesktopMode = emptySet<String>()
+
+    private val repository: AdaptiveDesktopModeRepository =
+        mockk {
+            coEvery { getDesktopBrowsingEnabled(any()) } answers { desktopBrowsingPreference.getValue(firstArg()) }
+            coEvery { setDesktopBrowsingEnabled(any(), any()) } answers {
+                desktopBrowsingPreference[firstArg()] = secondArg()
+                true
+            }
+            coEvery { getTabsWithOwnDesktopMode() } answers { savedTabsWithOwnDesktopMode }
+            coEvery { setTabsWithOwnDesktopMode(any()) } answers { savedTabsWithOwnDesktopMode = firstArg() }
+        }
+
+    // Stands in for the EngineMiddleware: the engine session reports the new desktop mode of the tab.
+    private val engineMiddleware: Middleware<BrowserState, BrowserAction> = { store, next, action ->
+        if (action is EngineAction.ToggleDesktopModeAction) {
+            store.dispatch(ContentAction.UpdateTabDesktopMode(action.tabId, action.enable))
+        } else {
+            next(action)
+        }
+    }
+
+    @After
+    fun tearDown() {
+        scope.cancel()
+    }
+
+    @Test
+    fun `GIVEN no window reported yet WHEN the store is created THEN the preference of the initial window is used`() =
+        runTest(testDispatcher) {
+            val store =
+                createStore(isInitialWindowLarge = true, tabs = listOf(createTab("https://a.com", id = "a")))
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertTrue(store.state.desktopMode)
+            assertTrue(store.desktopModeOf("a"))
+        }
+
+    @Test
+    fun `GIVEN a large window WHEN the store is created THEN the tabs follow the preference of large windows`() =
+        runTest(testDispatcher) {
+            isLargeWindow.value = true
+            val store =
+                createStore(
+                    isInitialWindowLarge = false,
+                    tabs =
+                        listOf(
+                            createTab("https://a.com", id = "a", desktopMode = false),
+                            createTab("https://b.com", id = "b", desktopMode = true),
+                        ),
+                )
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertTrue(store.state.desktopMode)
+            assertTrue(store.desktopModeOf("a"))
+            assertTrue(store.desktopModeOf("b"))
+        }
+
+    @Test
+    fun `GIVEN an unfolded foldable WHEN it is folded THEN the selected tab is reloaded in the mobile version`() =
+        runTest(testDispatcher) {
+            isLargeWindow.value = true
+            val selectedSession: EngineSession = mockk(relaxed = true)
+            val backgroundSession: EngineSession = mockk(relaxed = true)
+            val store =
+                createStore(
+                    tabs =
+                        listOf(
+                            createTab("https://a.com", id = "a", desktopMode = true, engineSession = selectedSession),
+                            createTab("https://b.com", id = "b", desktopMode = true, engineSession = backgroundSession),
+                            createTab("https://c.com", id = "c", desktopMode = true),
+                        ),
+                    selectedTabId = "a",
+                )
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            isLargeWindow.value = false
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertFalse(store.state.desktopMode)
+            assertFalse(store.desktopModeOf("a"))
+            assertFalse(store.desktopModeOf("b"))
+            assertFalse(store.desktopModeOf("c"))
+            verify(exactly = 1) { selectedSession.toggleDesktopMode(enable = false, reload = true) }
+            verify(exactly = 1) { backgroundSession.toggleDesktopMode(enable = false, reload = false) }
+            verify(exactly = 0) { backgroundSession.toggleDesktopMode(any(), reload = true) }
+
+            // The background tab is reloaded in the mobile version once selected.
+            store.dispatch(TabListAction.SelectTabAction("b"))
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            verify(exactly = 1) { backgroundSession.toggleDesktopMode(enable = false, reload = true) }
+
+            // But only once.
+            store.dispatch(TabListAction.SelectTabAction("a"))
+            store.dispatch(TabListAction.SelectTabAction("b"))
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            verify(exactly = 1) { backgroundSession.toggleDesktopMode(enable = false, reload = true) }
+        }
+
+    @Test
+    fun `GIVEN a background tab switched version WHEN it switches back before being selected THEN it is not reloaded`() =
+        runTest(testDispatcher) {
+            isLargeWindow.value = true
+            val backgroundSession: EngineSession = mockk(relaxed = true)
+            val store =
+                createStore(
+                    tabs =
+                        listOf(
+                            createTab("https://a.com", id = "a", desktopMode = true),
+                            createTab("https://b.com", id = "b", desktopMode = true, engineSession = backgroundSession),
+                        ),
+                    selectedTabId = "a",
+                )
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            isLargeWindow.value = false
+            testDispatcher.scheduler.advanceUntilIdle()
+            isLargeWindow.value = true
+            testDispatcher.scheduler.advanceUntilIdle()
+            store.dispatch(TabListAction.SelectTabAction("b"))
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertTrue(store.desktopModeOf("b"))
+            verify(exactly = 1) { backgroundSession.toggleDesktopMode(enable = false, reload = false) }
+            verify(exactly = 1) { backgroundSession.toggleDesktopMode(enable = true, reload = false) }
+            verify(exactly = 0) { backgroundSession.toggleDesktopMode(any(), reload = true) }
+        }
+
+    @Test
+    fun `GIVEN a custom tab WHEN the window changes THEN it is reloaded in the new version`() =
+        runTest(testDispatcher) {
+            isLargeWindow.value = true
+            val session: EngineSession = mockk(relaxed = true)
+            val customTab = createCustomTab("https://c.com", id = "custom", desktopMode = true, engineSession = session)
+            val store = createStore(customTabs = listOf(customTab))
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            isLargeWindow.value = false
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertFalse(store.state.findCustomTab("custom")!!.content.desktopMode)
+            verify(exactly = 1) { session.toggleDesktopMode(enable = false, reload = true) }
+        }
+
+    @Test
+    fun `GIVEN a tab switched from the menu to the other version WHEN the window changes THEN the tab keeps it`() =
+        runTest(testDispatcher) {
+            isLargeWindow.value = false
+            val store =
+                createStore(
+                    tabs =
+                        listOf(
+                            createTab("https://a.com", id = "a"),
+                            createTab("https://b.com", id = "b"),
+                        ),
+                    selectedTabId = "a",
+                )
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            // On the cover screen, the user requests the desktop site of "a".
+            store.dispatch(EngineAction.ToggleDesktopModeAction("a", enable = true))
+            testDispatcher.scheduler.advanceUntilIdle()
+            assertEquals(setOf("a"), savedTabsWithOwnDesktopMode)
+
+            isLargeWindow.value = true
+            testDispatcher.scheduler.advanceUntilIdle()
+            isLargeWindow.value = false
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertTrue(store.desktopModeOf("a"))
+            assertFalse(store.desktopModeOf("b"))
+
+            // Requesting the version of the default makes the tab follow the window again.
+            store.dispatch(EngineAction.ToggleDesktopModeAction("a", enable = false))
+            testDispatcher.scheduler.advanceUntilIdle()
+            assertEquals(emptySet<String>(), savedTabsWithOwnDesktopMode)
+
+            isLargeWindow.value = true
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertTrue(store.desktopModeOf("a"))
+            assertTrue(store.desktopModeOf("b"))
+        }
+
+    @Test
+    fun `GIVEN private tabs switched from the menu WHEN saving the tabs with their own version THEN they are not saved`() =
+        runTest(testDispatcher) {
+            isLargeWindow.value = false
+            val store =
+                createStore(
+                    tabs =
+                        listOf(
+                            createTab("https://a.com", id = "a"),
+                            createTab("https://private.com", id = "private", private = true),
+                        ),
+                )
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            store.dispatch(EngineAction.ToggleDesktopModeAction("a", enable = true))
+            store.dispatch(EngineAction.ToggleDesktopModeAction("private", enable = true))
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertEquals(setOf("a"), savedTabsWithOwnDesktopMode)
+
+            // The private tab still keeps its version while the app runs.
+            isLargeWindow.value = true
+            testDispatcher.scheduler.advanceUntilIdle()
+            isLargeWindow.value = false
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertTrue(store.desktopModeOf("private"))
+        }
+
+    @Test
+    fun `GIVEN saved tabs with their own version WHEN the store is created THEN they keep it`() =
+        runTest(testDispatcher) {
+            isLargeWindow.value = false
+            savedTabsWithOwnDesktopMode = setOf("a")
+            val store =
+                createStore(
+                    tabs =
+                        listOf(
+                            createTab("https://a.com", id = "a", desktopMode = true),
+                            createTab("https://b.com", id = "b", desktopMode = true),
+                        ),
+                )
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertTrue(store.desktopModeOf("a"))
+            assertFalse(store.desktopModeOf("b"))
+        }
+
+    @Test
+    fun `GIVEN the preferences are loaded WHEN tabs are restored THEN they follow the window`() =
+        runTest(testDispatcher) {
+            isLargeWindow.value = true
+            val store = createStore()
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            store.dispatch(
+                TabListAction.RestoreAction(
+                    tabs = listOf(RecoverableTab(null, TabState(id = "a", url = "https://a.com"))),
+                    restoreLocation = TabListAction.RestoreAction.RestoreLocation.BEGINNING,
+                ),
+            )
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertTrue(store.desktopModeOf("a"))
+        }
+
+    @Test
+    fun `WHEN the preference is toggled THEN it is saved for the current window and the tabs follow it`() =
+        runTest(testDispatcher) {
+            isLargeWindow.value = true
+            val store = createStore(tabs = listOf(createTab("https://a.com", id = "a")))
+            testDispatcher.scheduler.advanceUntilIdle()
+            assertTrue(store.desktopModeOf("a"))
+
+            store.dispatch(DefaultDesktopModeAction.ToggleDesktopMode)
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertFalse(store.state.desktopMode)
+            assertFalse(store.desktopModeOf("a"))
+            coVerify { repository.setDesktopBrowsingEnabled(isLargeWindow = true, enabled = false) }
+            assertEquals(false, desktopBrowsingPreference[true])
+            assertEquals(false, desktopBrowsingPreference[false])
+
+            // The small window keeps its own preference.
+            store.dispatch(DefaultDesktopModeAction.ToggleDesktopMode)
+            testDispatcher.scheduler.advanceUntilIdle()
+            isLargeWindow.value = false
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertFalse(store.state.desktopMode)
+            store.dispatch(DefaultDesktopModeAction.ToggleDesktopMode)
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertTrue(store.state.desktopMode)
+            assertEquals(true, desktopBrowsingPreference[true])
+            assertEquals(true, desktopBrowsingPreference[false])
+            assertNotNull(DesktopMode.settingsAlwaysRequestDesktopSite.testGetValue())
+        }
+
+    @Test
+    fun `GIVEN the preference cannot be saved WHEN it is toggled THEN the change is reverted`() =
+        runTest(testDispatcher) {
+            isLargeWindow.value = true
+            coEvery { repository.setDesktopBrowsingEnabled(any(), any()) } returns false
+            val store = createStore()
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            store.dispatch(DefaultDesktopModeAction.ToggleDesktopMode)
+            testDispatcher.scheduler.advanceUntilIdle()
+
+            assertTrue(store.state.desktopMode)
+        }
+
+    private fun createStore(
+        isInitialWindowLarge: Boolean = false,
+        tabs: List<TabSessionState> = emptyList(),
+        customTabs: List<CustomTabSessionState> = emptyList(),
+        selectedTabId: String? = tabs.firstOrNull()?.id,
+    ) = BrowserStore(
+        initialState = BrowserState(tabs = tabs, customTabs = customTabs, selectedTabId = selectedTabId),
+        middleware =
+            listOf(
+                AdaptiveDesktopModeMiddleware(
+                    repository = repository,
+                    isInitialWindowLarge = { isInitialWindowLarge },
+                    isLargeWindow = isLargeWindow,
+                    ioScope = scope,
+                    mainScope = scope,
+                ),
+                engineMiddleware,
+            ),
+    )
+
+    private fun BrowserStore.desktopModeOf(tabId: String): Boolean {
+        val tab: SessionState = requireNotNull(state.findTab(tabId))
+        return tab.content.desktopMode
+    }
+}
