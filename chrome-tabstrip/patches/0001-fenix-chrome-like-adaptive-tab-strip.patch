+                            path =
+                                folioPath(
+                                    top = tabTopMargin.toPx(),
+                                    cornerRadius = folioCornerRadius.toPx(),
+                                    footRadius = folioFootRadius.toPx(),
+                                ),
+                            color = folioColor,
+                            alpha = folioAlpha,
+                        )
+                    }
+                },
+    ) {
+        Row(
+            modifier =
+                Modifier.fillMaxSize()
+                    .padding(top = tabTopMargin)
+                    .clip(RoundedCornerShape(topStart = folioCornerRadius, topEnd = folioCornerRadius))
+                    .clickable { onSelectedTabClick(state.id, state.url) }
+                    .semantics {
+                        role = Role.Tab
+                        selected = state.isSelected
+                        customActions =
+                            listOf(
+                                CustomAccessibilityAction(label = closeTabLabel) {
+                                    closeTab()
+                                    true
+                                },
+                            )
+                    }
+                    .padding(start = tabContentStartPadding, end = tabContentEndPadding),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            TabIcon(
+                url = state.url,
+                icon = state.icon,
+                isLoading = state.isLoading,
+            )
+
+            Spacer(modifier = Modifier.width(faviconTitleSpacing))
+
+            // This makes sure that isRtl is only calculated when the title changes.
+            val isTitleRtl = remember(state.title) { BidiFormatter.getInstance().isRtl(state.title) }
+
+            Box(
+                modifier =
+                    Modifier.weight(1f).fillMaxHeight().fadingEdge(fadeWidth = titleFadeWidth, fadeLeft = isTitleRtl),
+                contentAlignment = Alignment.CenterStart,
+            ) {
+                Text(
+                    text = state.title,
+                    color =
+                        if (state.isSelected) {
+                            MaterialTheme.colorScheme.onSurface
+                        } else {
+                            MaterialTheme.colorScheme.onSurfaceVariant
+                        },
+                    softWrap = false,
+                    maxLines = 1,
+                    style = FirefoxTheme.typography.body2.copy(fontSize = 13.sp),
+                )
+            }
+
+            if (showCloseButton) {
+                val closeButtonDescription = stringResource(id = R.string.close_tab_title, state.title)
+                Box(
+                    modifier =
+                        Modifier.size(closeButtonSize)
+                            .clip(CircleShape)
+                            .clickable(onClick = closeTab)
+                            .then(
+                                if (state.isSelected) {
+                                    Modifier.semantics { contentDescription = closeButtonDescription }
+                                } else {
+                                    Modifier.clearAndSetSemantics {}
+                                },
+                            ),
+                    contentAlignment = Alignment.Center,
+                ) {
+                    Icon(
+                        painter = painterResource(iconsR.drawable.mozac_ic_cross_20),
+                        modifier = Modifier.size(closeIconSize),
+                        tint =
+                            if (state.isSelected) {
+                                MaterialTheme.colorScheme.onSurface
+                            } else {
+                                MaterialTheme.colorScheme.onSurfaceVariant
+                            },
+                        contentDescription = null,
+                    )
+                }
+            } else {
+                Spacer(modifier = Modifier.width(tabContentEndPadding))
+            }
+        }
+    }
+}
