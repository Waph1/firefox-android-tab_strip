diff --git a/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/tabstrip/ImmersiveTabStripTest.kt b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/tabstrip/ImmersiveTabStripTest.kt
new file mode 100644
index 00000000..c7adcd7d
--- /dev/null
+++ b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/tabstrip/ImmersiveTabStripTest.kt
@@ -0,0 +1,146 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.browser.tabstrip
+
+import android.os.Build.VERSION_CODES
+import android.view.WindowManager
+import androidx.core.graphics.Insets
+import androidx.core.view.WindowInsetsCompat
+import androidx.core.view.WindowInsetsCompat.Type.displayCutout
+import androidx.core.view.WindowInsetsCompat.Type.navigationBars
+import androidx.core.view.WindowInsetsCompat.Type.statusBars
+import androidx.core.view.WindowInsetsCompat.Type.systemBars
+import androidx.fragment.app.FragmentActivity
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+
+@RunWith(RobolectricTestRunner::class)
+class ImmersiveTabStripTest {
+
+    private lateinit var activity: FragmentActivity
+    private var isTabStripShown = true
+
+    // Status bar and camera hole at the top, navigation bar at the bottom, another cutout on the left.
+    private val insets =
+        WindowInsetsCompat.Builder()
+            .setInsets(statusBars(), Insets.of(0, 63, 0, 0))
+            .setInsets(displayCutout(), Insets.of(20, 80, 0, 0))
+            .setInsets(navigationBars(), Insets.of(0, 0, 0, 48))
+            .build()
+
+    @Before
+    fun setUp() {
+        activity = Robolectric.buildActivity(FragmentActivity::class.java).create().get()
+        isTabStripShown = true
+    }
+
+    private fun createImmersiveTabStrip() = ImmersiveTabStrip(activity) { isTabStripShown }
+
+    @Test
+    fun `GIVEN the tab strip is shown WHEN started THEN the status bar is hidden and takes no space`() {
+        val immersiveTabStrip = createImmersiveTabStrip()
+
+        immersiveTabStrip.start(activity.supportFragmentManager)
+
+        assertTrue(immersiveTabStrip.isStatusBarHidden)
+        val contentInsets = immersiveTabStrip.transformInsets(insets)
+        assertEquals(Insets.NONE, contentInsets.getInsets(statusBars()))
+        assertEquals(Insets.of(0, 0, 0, 48), contentInsets.getInsets(systemBars()))
+        // Only the top of the display cutout is ignored, so that the tabs reach the top edge of the screen.
+        assertEquals(Insets.of(20, 0, 0, 0), contentInsets.getInsets(displayCutout()))
+        assertEquals(Insets.of(0, 0, 0, 48), contentInsets.getInsets(navigationBars()))
+    }
+
+    @Test
+    fun `GIVEN the tab strip is not shown WHEN started THEN the status bar is shown and insets are unchanged`() {
+        isTabStripShown = false
+        val immersiveTabStrip = createImmersiveTabStrip()
+
+        immersiveTabStrip.start(activity.supportFragmentManager)
+
+        assertFalse(immersiveTabStrip.isStatusBarHidden)
+        assertSame(insets, immersiveTabStrip.transformInsets(insets))
+    }
+
+    @Test
+    fun `GIVEN the status bar is hidden WHEN the tab strip goes away THEN the status bar is shown again`() {
+        val immersiveTabStrip = createImmersiveTabStrip()
+        immersiveTabStrip.start(activity.supportFragmentManager)
+        assertTrue(immersiveTabStrip.isStatusBarHidden)
+
+        // E.g. the foldable is folded.
+        isTabStripShown = false
+        immersiveTabStrip.update()
+        assertFalse(immersiveTabStrip.isStatusBarHidden)
+        assertSame(insets, immersiveTabStrip.transformInsets(insets))
+
+        // And unfolded again.
+        isTabStripShown = true
+        immersiveTabStrip.update()
+        assertTrue(immersiveTabStrip.isStatusBarHidden)
+    }
+
+    @Test
+    fun `GIVEN fullscreen content WHEN the tab strip changes THEN the system bars are left to the fullscreen mode`() {
+        val immersiveTabStrip = createImmersiveTabStrip()
+        immersiveTabStrip.start(activity.supportFragmentManager)
+        activity.window.addFlags(WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS)
+
+        isTabStripShown = false
+        immersiveTabStrip.update()
+
+        assertTrue(immersiveTabStrip.isStatusBarHidden)
+        assertSame(insets, immersiveTabStrip.transformInsets(insets))
+    }
+
+    @Test
+    fun `GIVEN not started WHEN updating THEN nothing changes`() {
+        val immersiveTabStrip = createImmersiveTabStrip()
+
+        immersiveTabStrip.update()
+
+        assertFalse(immersiveTabStrip.isStatusBarHidden)
+        assertSame(insets, immersiveTabStrip.transformInsets(insets))
+    }
+
+    @Test
+    fun `WHEN deciding THEN the status bar is hidden only with the tab strip, from Android 13, not in multi-window`() {
+        assertTrue(
+            ImmersiveTabStrip.shouldHideStatusBar(
+                sdkInt = VERSION_CODES.TIRAMISU,
+                isInMultiWindowMode = false,
+                isTabStripShown = true,
+            )
+        )
+        assertFalse(
+            ImmersiveTabStrip.shouldHideStatusBar(
+                sdkInt = VERSION_CODES.TIRAMISU,
+                isInMultiWindowMode = false,
+                isTabStripShown = false,
+            )
+        )
+        assertFalse(
+            ImmersiveTabStrip.shouldHideStatusBar(
+                sdkInt = VERSION_CODES.TIRAMISU,
+                isInMultiWindowMode = true,
+                isTabStripShown = true,
+            )
+        )
+        assertFalse(
+            ImmersiveTabStrip.shouldHideStatusBar(
+                sdkInt = VERSION_CODES.S_V2,
+                isInMultiWindowMode = false,
+                isTabStripShown = true,
+            )
+        )
+    }
+}
