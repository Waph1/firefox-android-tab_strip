+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/desktopmode/AdaptiveDesktopModeMiddleware.kt
@@ -0,0 +1,211 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.browser.desktopmode
+
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.MainScope
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import mozilla.components.browser.state.action.BrowserAction
+import mozilla.components.browser.state.action.ContentAction
+import mozilla.components.browser.state.action.DefaultDesktopModeAction
+import mozilla.components.browser.state.action.EngineAction
+import mozilla.components.browser.state.action.InitAction
+import mozilla.components.browser.state.action.TabListAction
+import mozilla.components.browser.state.selector.findTab
+import mozilla.components.browser.state.state.BrowserState
+import mozilla.components.browser.state.state.CustomTabSessionState
+import mozilla.components.lib.state.Middleware
+import mozilla.components.lib.state.Store
+import mozilla.telemetry.glean.private.NoExtras
+import org.mozilla.fenix.GleanMetrics.DesktopMode
+import org.mozilla.fenix.browser.tabstrip.AdaptiveTabStrip
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * [Middleware] making the desktop / mobile version of the sites follow the app window, like the tab strip does: with
+ * the default settings, a foldable shows desktop sites when unfolded and mobile sites when folded, and the open tabs
+ * switch version as soon as it is folded or unfolded. It replaces [DesktopModeMiddleware].
+ *
+ * - The "Always request desktop site" preference is remembered separately for large and small windows (see
+ *   [AdaptiveDesktopModeRepository]) and [BrowserState.desktopMode] holds the one of the current window.
+ * - When [BrowserState.desktopMode] changes (the window or the preference changed), the open tabs switch to it: the
+ *   selected tab (and the custom tabs, each shown in its own window) is reloaded immediately, the other tabs are
+ *   reloaded when they are selected.
+ * - A tab whose version is changed from the menu ("Desktop site") to the opposite of the default keeps it, until it is
+ *   changed back from the menu.
+ *
+ * @param repository [AdaptiveDesktopModeRepository] storing the preferences.
+ * @param isInitialWindowLarge Whether the app window is large, used until [isLargeWindow] reports a window.
+ * @param isLargeWindow [Flow] emitting whether the app window is large, or null until a window reports its size.
+ * @param ioScope [CoroutineScope] used for reading and writing the preferences.
+ * @param mainScope [CoroutineScope] used for updating the engine sessions.
+ */
+class AdaptiveDesktopModeMiddleware(
+    private val repository: AdaptiveDesktopModeRepository,
+    private val isInitialWindowLarge: () -> Boolean,
+    private val isLargeWindow: Flow<Boolean?> = AdaptiveTabStrip.isLargeWindow,
+    private val ioScope: CoroutineScope = CoroutineScope(Dispatchers.IO),
+    private val mainScope: CoroutineScope = MainScope(),
+) : Middleware<BrowserState, BrowserAction> {
+
+    // IDs of the tabs whose version was chosen from the menu: they don't follow the window.
+    private val tabsWithOwnDesktopMode: MutableSet<String> = ConcurrentHashMap.newKeySet()
+
+    // Tabs that switched version in the background, with the version their page was loaded in. They are reloaded when
+    // selected. Only used while the store processes an action.
+    private val tabsToReload = mutableMapOf<String, Boolean>()
+
+    // Serializes the preference reads and writes with the window changes.
+    private val preferencesMutex = Mutex()
+
+    // Whether [BrowserState.desktopMode] holds the preference of large or small windows; null until it is loaded.
+    @Volatile
+    private var isLargeWindowLoaded: Boolean? = null
+
+    override fun invoke(
+        store: Store<BrowserState, BrowserAction>,
+        next: (BrowserAction) -> Unit,
+        action: BrowserAction,
+    ) {
+        if (action is EngineAction.ToggleDesktopModeAction) {
+            onTabDesktopModeRequested(store, action)
+        }
+
+        val previousSelectedTabId = store.state.selectedTabId
+
+        next(action)
+
+        when (action) {
+            InitAction -> loadPreferences(store)
+            DefaultDesktopModeAction.ToggleDesktopMode -> {
+                saveDesktopModePreference(store)
+                updateTabs(store)
+            }
+            is DefaultDesktopModeAction.DesktopModeUpdated,
+            is TabListAction.RestoreAction,
+            -> updateTabs(store)
+            else -> Unit
+        }
+
+        val selectedTabId = store.state.selectedTabId
+        if (selectedTabId != null && selectedTabId != previousSelectedTabId) {
+            reloadIfNeeded(store, selectedTabId)
+        }
+    }
+
+    private fun loadPreferences(store: Store<BrowserState, BrowserAction>) {
+        ioScope.launch {
+            tabsWithOwnDesktopMode.addAll(repository.getTabsWithOwnDesktopMode())
+
+            isLargeWindow
+                .map { it ?: isInitialWindowLarge() }
+                .distinctUntilChanged()
+                .collect { isLarge ->
+                    preferencesMutex.withLock {
+                        val desktopMode = repository.getDesktopBrowsingEnabled(isLargeWindow = isLarge)
+                        isLargeWindowLoaded = isLarge
+                        store.dispatch(DefaultDesktopModeAction.DesktopModeUpdated(newValue = desktopMode))
+                    }
+                }
+        }
+    }
+
+    private fun saveDesktopModePreference(store: Store<BrowserState, BrowserAction>) {
+        ioScope.launch {
+            preferencesMutex.withLock {
+                val isLarge = isLargeWindowLoaded ?: isInitialWindowLarge()
+                val desktopMode = store.state.desktopMode
+                val preferenceWriteSucceeded =
+                    repository.setDesktopBrowsingEnabled(isLargeWindow = isLarge, enabled = desktopMode)
+
+                if (!preferenceWriteSucceeded) {
+                    // If the preference write fails, revert the state change.
+                    store.dispatch(DefaultDesktopModeAction.DesktopModeUpdated(newValue = !desktopMode))
+                } else if (desktopMode) {
+                    DesktopMode.settingsAlwaysRequestDesktopSite.record(NoExtras())
+                }
+            }
+        }
+    }
+
+    private fun onTabDesktopModeRequested(
+        store: Store<BrowserState, BrowserAction>,
+        action: EngineAction.ToggleDesktopModeAction,
+    ) {
+        // The action reloads the tab.
+        tabsToReload.remove(action.tabId)
+
+        // Choosing the version of the default makes the tab follow the window again.
+        val changed =
+            if (action.enable == store.state.desktopMode) {
+                tabsWithOwnDesktopMode.remove(action.tabId)
+            } else {
+                tabsWithOwnDesktopMode.add(action.tabId)
+            }
+        if (changed) {
+            saveTabsWithOwnDesktopMode(store)
+        }
+    }
+
+    private fun saveTabsWithOwnDesktopMode(store: Store<BrowserState, BrowserAction>) {
+        ioScope.launch {
+            preferencesMutex.withLock {
+                // Only the tabs restored after a restart (no private or custom tabs), so closed tabs are forgotten.
+                val restorableTabIds = store.state.tabs.filterNot { it.content.private }.map { it.id }.toSet()
+                repository.setTabsWithOwnDesktopMode(
+                    tabsWithOwnDesktopMode.filterTo(mutableSetOf()) { it in restorableTabIds },
+                )
+            }
+        }
+    }
+
+    private fun updateTabs(store: Store<BrowserState, BrowserAction>) {
+        // Until the preference of the current window is loaded, the default isn't known yet.
+        if (isLargeWindowLoaded == null) {
+            return
+        }
+
+        val state = store.state
+        val desktopMode = state.desktopMode
+        (state.tabs + state.customTabs)
+            .filter { it.content.desktopMode != desktopMode && it.id !in tabsWithOwnDesktopMode }
+            .forEach { tab ->
+                store.dispatch(ContentAction.UpdateTabDesktopMode(tab.id, desktopMode))
+
+                // Without an engine session, the tab is loaded in the right version when it gets one.
+                val engineSession = tab.engineState.engineSession ?: return@forEach
+
+                if (tab.id == state.selectedTabId || tab is CustomTabSessionState) {
+                    tabsToReload.remove(tab.id)
+                    mainScope.launch { engineSession.toggleDesktopMode(enable = desktopMode, reload = true) }
+                } else {
+                    val loadedDesktopMode = tabsToReload.remove(tab.id) ?: tab.content.desktopMode
+                    if (loadedDesktopMode != desktopMode) {
+                        tabsToReload[tab.id] = loadedDesktopMode
+                    }
+                    mainScope.launch { engineSession.toggleDesktopMode(enable = desktopMode, reload = false) }
+                }
+            }
+    }
+
+    private fun reloadIfNeeded(store: Store<BrowserState, BrowserAction>, tabId: String) {
+        if (tabsToReload.remove(tabId) == null) {
+            return
+        }
+
+        // Without an engine session, the tab is loaded in the right version when it gets one.
+        val tab = store.state.findTab(tabId) ?: return
+        val engineSession = tab.engineState.engineSession ?: return
+        val desktopMode = tab.content.desktopMode
+        // Also replaces a mobile URL (e.g. m.example.com) when switching to the desktop version.
+        mainScope.launch { engineSession.toggleDesktopMode(enable = desktopMode, reload = true) }
+    }
+}
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/desktopmode/AdaptiveDesktopModeRepository.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/desktopmode/AdaptiveDesktopModeRepository.kt
