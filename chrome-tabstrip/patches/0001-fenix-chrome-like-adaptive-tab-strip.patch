+
+// In the cache directory, which the app file provider shares (see res/xml/file_paths.xml).
+private const val UPDATE_DIRECTORY = "self-update"
+private const val APK_MIME_TYPE = "application/vnd.android.package-archive"
+
+/**
+ * Description of the latest release, read from the `update.json` file published with its APK.
+ *
+ * @property packageName The package name of the published app.
+ * @property versionName The version shown to the user, e.g. "158.0.1".
+ * @property versionCode The Android version code of the published APK.
+ * @property apkUrl Where to download the APK from.
+ * @property signingCertSha256 The SHA-256 digest of the certificate the APK is signed with, in lowercase hexadecimal.
+ */
+data class SelfUpdateInfo(
+    val packageName: String,
+    val versionName: String,
+    val versionCode: Long,
+    val apkUrl: String,
+    val signingCertSha256: String,
+) {
+    /**
+     * Whether this release updates the installed app: same app, newer and signed with the same key, so that Android
+     * installs it on top of the installed one.
+     *
+     * @param installedPackageName The package name of the installed app.
+     * @param installedVersionCode The version code of the installed app.
+     * @param isInstalledAppSignedWith Whether the installed app is signed with the certificate of the given digest.
+     */
+    fun isUpdateFor(
+        installedPackageName: String,
+        installedVersionCode: Long,
+        isInstalledAppSignedWith: (ByteArray) -> Boolean,
+    ) = packageName == installedPackageName &&
+        versionCode > installedVersionCode &&
+        isInstalledAppSignedWith(signingCertSha256.chunked(2).map { it.toInt(HEX_RADIX).toByte() }.toByteArray())
+
+    companion object {
+        private const val HEX_RADIX = 16
+        private val SHA256_HEX = Regex("[0-9a-f]{64}")
+
+        /**
+         * Parses the content of `update.json`, or returns `null` if it isn't valid.
+         */
+        fun fromJson(json: String): SelfUpdateInfo? =
+            try {
+                val info = JSONObject(json)
+                val apkUrl = info.getString("apkUrl")
+                val certificate = info.getString("signingCertSha256").lowercase()
+                if (!apkUrl.startsWith("https://") || !certificate.matches(SHA256_HEX)) {
+                    null
+                } else {
+                    SelfUpdateInfo(
+                        packageName = info.getString("packageName"),
+                        versionName = info.getString("versionName"),
+                        versionCode = info.getLong("versionCode"),
+                        apkUrl = apkUrl,
+                        signingCertSha256 = certificate,
+                    )
+                }
+            } catch (e: JSONException) {
+                null
+            }
+    }
+}
+
+/**
+ * Returns the version to show to the user: the Firefox version without the suffix of the build (e.g. "158.0.1" for
+ * "158.0.1-default").
+ */
+@VisibleForTesting
+internal fun displayVersion(versionName: String) = versionName.substringBefore('-')
+
+/**
+ * Whether it's time to look for an update again.
+ *
+ * @param lastCheck When the last check was done, in milliseconds.
+ * @param now The current time, in milliseconds.
+ */
+@VisibleForTesting
+internal fun isCheckDue(
+    lastCheck: Long,
+    now: Long,
+) = now - lastCheck >= CHECK_INTERVAL_MS || now < lastCheck
+
+/**
+ * Lets this build of Firefox (with the Chrome-like tab strip, published in the GitHub Releases of the repository of
+ * the patch) update itself, like apps installed from outside the Play Store usually do.
+ *
+ * At most once a day, when the app comes to the foreground, it reads the description of the latest release (see
+ * [SelfUpdateInfo]). If that release is newer than the installed app and signed with the same key, it asks whether to
+ * update: the APK is then downloaded and handed over to the Android package installer, which asks for a last
+ * confirmation (and, the first time, to allow Firefox to install apps).
+ *
+ * Builds that can't be updated from the releases (local builds signed with another key, other variants like Nightly or
+ * debug) are never offered an update.
+ *
+ * @param activity The activity showing the dialogs.
+ * @param updateInfoUrl Where to read the description of the latest release.
+ * @param clock Returns the current time in milliseconds.
+ */
+class SelfUpdater(
+    private val activity: AppCompatActivity,
+    private val updateInfoUrl: String = UPDATE_INFO_URL,
+    private val clock: () -> Long = System::currentTimeMillis,
+) : DefaultLifecycleObserver {
+    private val logger = Logger("SelfUpdater")
+    private val preferences = activity.getSharedPreferences(PREFERENCES_NAME, Context.MODE_PRIVATE)
+    private var job: Job? = null
+
+    /** Starts looking for updates every time [activity] is resumed, at most once a day. */
+    fun start() {
+        activity.lifecycle.addObserver(this)
+    }
+
+    override fun onResume(owner: LifecycleOwner) {
+        if (job?.isActive == true || !isCheckDue(preferences.getLong(PREF_LAST_CHECK, 0L), clock())) return
+
+        job =
+            activity.lifecycleScope.launch {
+                val update =
+                    withContext(Dispatchers.IO) {
+                        // Drop the APK of a previous update, installed or not.
+                        File(activity.cacheDir, UPDATE_DIRECTORY).deleteRecursively()
+                        val json =
+                            try {
+                                readText(updateInfoUrl)
+                            } catch (e: IOException) {
+                                // Offline or GitHub unreachable: try again the next time the app is resumed.
+                                logger.info("Can't check for updates", e)
+                                return@withContext null
+                            }
+                        preferences.edit { putLong(PREF_LAST_CHECK, clock()) }
+                        json?.let { SelfUpdateInfo.fromJson(it) }?.takeIf { isUpdate(it) }
+                    }
+                if (update != null) {
+                    activity.withResumed { askToUpdate(update) }
+                }
+            }
+    }
+
+    private fun isUpdate(update: SelfUpdateInfo): Boolean {
+        val packageManager = activity.packageManager
+        val installed = installedPackageInfo() ?: return false
+        return update.isUpdateFor(
+            installedPackageName = activity.packageName,
+            installedVersionCode = PackageInfoCompat.getLongVersionCode(installed),
+        ) { certificate ->
+            PackageInfoCompat.hasSignatures(
+                packageManager,
+                activity.packageName,
+                mapOf(certificate to PackageManager.CERT_INPUT_SHA256),
+                false,
+            )
+        }
+    }
+
+    private fun installedPackageInfo(): PackageInfo? =
+        try {
+            if (SDK_INT >= VERSION_CODES.TIRAMISU) {
+                activity.packageManager.getPackageInfo(activity.packageName, PackageManager.PackageInfoFlags.of(0))
+            } else {
+                @Suppress("DEPRECATION")
+                activity.packageManager.getPackageInfo(activity.packageName, 0)
+            }
+        } catch (e: PackageManager.NameNotFoundException) {
+            null
+        }
+
+    private fun askToUpdate(update: SelfUpdateInfo) {
+        MaterialAlertDialogBuilder(activity)
+            .setTitle(R.string.self_update_available_title)
+            .setMessage(
+                activity.getString(
+                    R.string.self_update_available_message,
+                    activity.getString(R.string.app_name),
+                    displayVersion(update.versionName),
+                    displayVersion(installedPackageInfo()?.versionName.orEmpty()),
+                ),
+            )
+            .setPositiveButton(R.string.self_update_update) { _, _ -> downloadAndInstall(update) }
+            .setNegativeButton(R.string.self_update_later, null)
+            .show()
+    }
+
+    private fun downloadAndInstall(update: SelfUpdateInfo) {
+        val progressBar =
+            ProgressBar(activity, null, android.R.attr.progressBarStyleHorizontal).apply {
+                isIndeterminate = true
+                max = PERCENT
+            }
+        val padding = (DIALOG_PADDING_DP * activity.resources.displayMetrics.density).toInt()
+        val content = FrameLayout(activity).apply {
+            setPadding(padding, padding / 2, padding, 0)
+            addView(progressBar)
+        }
+
+        var download: Job? = null
+        val dialog =
+            MaterialAlertDialogBuilder(activity)
+                .setTitle(R.string.self_update_downloading)
+                .setView(content)
+                .setCancelable(false)
+                .setNegativeButton(android.R.string.cancel) { _, _ -> download?.cancel() }
+                .show()
+
+        val apk = File(File(activity.cacheDir, UPDATE_DIRECTORY), "firefox-${displayVersion(update.versionName)}.apk")
+        val job =
+            activity.lifecycleScope.launch {
+                val isDownloaded =
+                    withContext(Dispatchers.IO) {
+                        try {
+                            downloadFile(update.apkUrl, apk) { percent ->
+                                activity.runOnUiThread {
+                                    progressBar.isIndeterminate = false
+                                    progressBar.progress = percent
+                                }
+                            }
+                            isExpectedApk(apk, update)
+                        } catch (e: IOException) {
+                            logger.warn("Can't download the update", e)
+                            false
+                        }
+                    }
+                dialog.dismiss()
+                if (isDownloaded) {
+                    // The package installer can only be opened while the app is visible.
+                    activity.withResumed { install(apk) }
+                } else {
+                    apk.delete()
+                    Toast.makeText(activity, R.string.self_update_failed, Toast.LENGTH_LONG).show()
+                }
+            }
+        download = job
+        job.invokeOnCompletion { cause ->
+            // Cancelled by the user, or the activity was destroyed.
+            if (cause != null) {
+                dialog.dismiss()
+                apk.delete()
+            }
+        }
+    }
+
+    /** Whether [apk] is the complete APK described by [update]. */
+    private fun isExpectedApk(
+        apk: File,
+        update: SelfUpdateInfo,
+    ): Boolean {
+        val info =
+            if (SDK_INT >= VERSION_CODES.TIRAMISU) {
+                activity.packageManager.getPackageArchiveInfo(apk.path, PackageManager.PackageInfoFlags.of(0))
+            } else {
+                @Suppress("DEPRECATION")
+                activity.packageManager.getPackageArchiveInfo(apk.path, 0)
+            }
+        return info != null &&
+            info.packageName == update.packageName &&
+            PackageInfoCompat.getLongVersionCode(info) == update.versionCode
+    }
+
+    private fun install(apk: File) {
+        val uri = FileProvider.getUriForFile(activity, "${activity.packageName}.fileprovider", apk)
+        val intent =
+            Intent(Intent.ACTION_VIEW)
+                .setDataAndType(uri, APK_MIME_TYPE)
+                .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+        try {
+            activity.startActivity(intent)
+        } catch (e: ActivityNotFoundException) {
+            logger.warn("No package installer", e)
+            Toast.makeText(activity, R.string.self_update_failed, Toast.LENGTH_LONG).show()
+        }
+    }
+
+    private fun openConnection(url: String) =
+        (URL(url).openConnection() as HttpURLConnection).apply {
+            connectTimeout = TIMEOUT_MS
+            readTimeout = TIMEOUT_MS
+            // GitHub redirects the download links to its storage.
+            instanceFollowRedirects = true
+        }
+
+    /** Returns the content of [url], or `null` if there is none (e.g. a release without `update.json`). */
+    private fun readText(url: String): String? {
+        val connection = openConnection(url)
+        try {
+            if (connection.responseCode != HttpURLConnection.HTTP_OK) return null
+            val text = connection.inputStream.bufferedReader().use { it.readText() }
+            return text.takeIf { it.length <= MAX_UPDATE_INFO_LENGTH }
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private suspend fun downloadFile(
+        url: String,
+        file: File,
+        onProgress: (percent: Int) -> Unit,
+    ) {
+        val connection = openConnection(url)
+        try {
+            if (connection.responseCode != HttpURLConnection.HTTP_OK) {
+                throw IOException("HTTP ${connection.responseCode}")
+            }
+            val length = connection.contentLengthLong
+            file.parentFile?.mkdirs()
+            connection.inputStream.use { input ->
+                file.outputStream().use { output ->
+                    val buffer = ByteArray(BUFFER_SIZE)
+                    var downloaded = 0L
+                    var lastPercent = -1
+                    while (true) {
+                        currentCoroutineContext().ensureActive()
+                        val read = input.read(buffer)
+                        if (read < 0) break
+                        output.write(buffer, 0, read)
+                        downloaded += read
+                        if (length > 0) {
+                            val percent = (downloaded * PERCENT / length).toInt()
+                            if (percent != lastPercent) {
+                                lastPercent = percent
+                                onProgress(percent)
+                            }
+                        }
+                    }
+                }
+            }
+        } finally {
+            connection.disconnect()
+        }
+    }
+}
