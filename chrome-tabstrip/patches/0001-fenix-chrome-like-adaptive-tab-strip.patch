+            )
+
+        assertNull(browserState.toTabStripModeToggle(isPrivateMode = false))
+    }
+
+    @Test
+    fun `GIVEN private tabs WHEN showing normal tabs THEN the toggle selects the last used private tab`() {
+        val browserState =
+            BrowserState(
+                tabs =
+                    listOf(
+                        createTab(id = "1", url = "https://www.mozilla.org"),
+                        createTab(id = "p1", url = "https://www.example.com", private = true, lastAccess = 10),
+                        createTab(id = "p2", url = "https://www.firefox.com", private = true, lastAccess = 20),
+                    ),
+                selectedTabId = "1",
+            )
+
+        assertEquals(
+            TabStripModeToggle(tabId = "p2", url = "https://www.firefox.com"),
+            browserState.toTabStripModeToggle(isPrivateMode = false),
+        )
+    }
+
+    @Test
+    fun `GIVEN normal tabs WHEN showing private tabs THEN the toggle selects the last used normal tab`() {
+        val browserState =
+            BrowserState(
+                tabs =
+                    listOf(
+                        createTab(id = "1", url = "https://www.mozilla.org", lastAccess = 30),
+                        createTab(id = "2", url = "https://www.example.com", lastAccess = 5),
+                        createTab(id = "p1", url = "https://www.firefox.com", private = true),
+                    ),
+                selectedTabId = "p1",
+            )
+
+        assertEquals(
+            TabStripModeToggle(tabId = "1", url = "https://www.mozilla.org"),
+            browserState.toTabStripModeToggle(isPrivateMode = true),
+        )
+    }
+}
diff --git a/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/selfupdate/SelfUpdaterTest.kt b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/selfupdate/SelfUpdaterTest.kt
