diff --git a/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/tabstrip/AdaptiveTabStripTest.kt b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/tabstrip/AdaptiveTabStripTest.kt
new file mode 100644
index 0000000000..34465b7470
--- /dev/null
+++ b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/tabstrip/AdaptiveTabStripTest.kt
@@ -0,0 +1,91 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.browser.tabstrip
+
+import mozilla.components.support.test.robolectric.testContext
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mozilla.fenix.utils.Settings
+import org.robolectric.RobolectricTestRunner
+
+@RunWith(RobolectricTestRunner::class)
+class AdaptiveTabStripTest {
+
+    @After
+    fun tearDown() {
+        // Restore the default state shared by all the tests.
+        AdaptiveTabStrip.update(isTabletScreen = true, screenWidthDp = 1000, screenHeightDp = 800)
+    }
+
+    @Test
+    fun `GIVEN an unfolded foldable WHEN the window is updated THEN the tab strip is allowed`() {
+        // Inner screen of a Galaxy Z Fold.
+        AdaptiveTabStrip.update(isTabletScreen = true, screenWidthDp = 690, screenHeightDp = 829)
+
+        assertTrue(AdaptiveTabStrip.isTabStripAllowed)
+        assertEquals(
+            AdaptiveTabStrip.WindowLayout(isTabStripAllowed = true, isWideWindow = true, isTallWindow = true),
+            AdaptiveTabStrip.windowLayout.value,
+        )
+    }
+
+    @Test
+    fun `GIVEN a folded foldable WHEN the window is updated THEN the tab strip is not allowed`() {
+        // Cover screen of a Galaxy Z Fold, in portrait and in landscape.
+        AdaptiveTabStrip.update(isTabletScreen = false, screenWidthDp = 411, screenHeightDp = 960)
+        assertFalse(AdaptiveTabStrip.isTabStripAllowed)
+
+        AdaptiveTabStrip.update(isTabletScreen = false, screenWidthDp = 960, screenHeightDp = 411)
+        assertFalse(AdaptiveTabStrip.isTabStripAllowed)
+        assertEquals(
+            AdaptiveTabStrip.WindowLayout(isTabStripAllowed = false, isWideWindow = true, isTallWindow = false),
+            AdaptiveTabStrip.windowLayout.value,
+        )
+    }
+
+    @Test
+    fun `GIVEN a tablet screen WHEN the window is narrower than the minimum width THEN the tab strip is not allowed`() {
+        AdaptiveTabStrip.update(isTabletScreen = true, screenWidthDp = 411, screenHeightDp = 800)
+        assertFalse(AdaptiveTabStrip.isTabStripAllowed)
+
+        AdaptiveTabStrip.update(
+            isTabletScreen = true,
+            screenWidthDp = AdaptiveTabStrip.MIN_WINDOW_WIDTH_DP,
+            screenHeightDp = 800,
+        )
+        assertTrue(AdaptiveTabStrip.isTabStripAllowed)
+    }
+
+    @Test
+    fun `GIVEN the tab strip preference is enabled WHEN the window changes THEN the tab strip follows the window`() {
+        val settings = Settings(testContext)
+        settings.isTabStripPreferenceEnabled = true
+        settings.shouldUseBottomTabStrip = false
+
+        AdaptiveTabStrip.update(isTabletScreen = true, screenWidthDp = 690, screenHeightDp = 829)
+        assertTrue(settings.isTabStripEnabled)
+        assertTrue(settings.shouldShowTabStripAtTop)
+
+        AdaptiveTabStrip.update(isTabletScreen = false, screenWidthDp = 411, screenHeightDp = 960)
+        assertFalse(settings.isTabStripEnabled)
+        assertFalse(settings.shouldShowTabStripAtTop)
+        assertTrue(settings.isTabStripPreferenceEnabled)
+    }
+
+    @Test
+    fun `GIVEN the tab strip preference is disabled WHEN the window is large THEN the tab strip is not shown`() {
+        val settings = Settings(testContext)
+        settings.isTabStripEnabled = false
+
+        AdaptiveTabStrip.update(isTabletScreen = true, screenWidthDp = 1000, screenHeightDp = 800)
+
+        assertFalse(settings.isTabStripPreferenceEnabled)
+        assertFalse(settings.isTabStripEnabled)
+    }
+}
