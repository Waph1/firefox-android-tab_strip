diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/desktopmode/AdaptiveDesktopModeMiddleware.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/desktopmode/AdaptiveDesktopModeMiddleware.kt
