+
+package org.mozilla.fenix.browser.desktopmode
+
+import android.content.Context
+import androidx.datastore.core.DataStore
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.preferencesDataStore
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import kotlinx.coroutines.test.runTest
+import mozilla.components.support.test.robolectric.testContext
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+
+private val Context.testDataStore: DataStore<Preferences> by preferencesDataStore(
+    name = "AdaptiveDesktopModeRepositoryTest",
+)
+
+@RunWith(AndroidJUnit4::class)
+class AdaptiveDesktopModeRepositoryTest {
+
+    private val repository =
+        AdaptiveDesktopModeRepository(context = testContext, dataStore = testContext.testDataStore)
+
+    @After
+    fun teardown() = runTest {
+        testContext.testDataStore.edit { it.clear() }
+    }
+
+    @Test
+    fun `WHEN the repository is read for the first time THEN desktop sites are requested in large windows only`() =
+        runTest {
+            assertTrue(repository.getDesktopBrowsingEnabled(isLargeWindow = true))
+            assertFalse(repository.getDesktopBrowsingEnabled(isLargeWindow = false))
+        }
+
+    @Test
+    fun `WHEN the preference of a window is written THEN the preference of the other window is unchanged`() =
+        runTest {
+            assertTrue(repository.setDesktopBrowsingEnabled(isLargeWindow = false, enabled = true))
+            assertTrue(repository.getDesktopBrowsingEnabled(isLargeWindow = false))
+            assertTrue(repository.getDesktopBrowsingEnabled(isLargeWindow = true))
+
+            assertTrue(repository.setDesktopBrowsingEnabled(isLargeWindow = true, enabled = false))
+            assertFalse(repository.getDesktopBrowsingEnabled(isLargeWindow = true))
+            assertTrue(repository.getDesktopBrowsingEnabled(isLargeWindow = false))
+        }
+
+    @Test
+    fun `GIVEN the upstream preference was set WHEN the repository is read THEN it applies to large windows`() =
+        runTest {
+            DefaultDesktopModeRepository(context = testContext, dataStore = testContext.testDataStore)
+                .setDesktopBrowsingEnabled(enabled = false)
+
+            assertFalse(repository.getDesktopBrowsingEnabled(isLargeWindow = true))
+            assertFalse(repository.getDesktopBrowsingEnabled(isLargeWindow = false))
+        }
+
+    @Test
+    fun `WHEN the tabs with their own desktop mode are written THEN they are read back`() =
+        runTest {
+            assertEquals(emptySet<String>(), repository.getTabsWithOwnDesktopMode())
+
+            repository.setTabsWithOwnDesktopMode(setOf("a", "b"))
+            assertEquals(setOf("a", "b"), repository.getTabsWithOwnDesktopMode())
+
+            repository.setTabsWithOwnDesktopMode(emptySet())
+            assertEquals(emptySet<String>(), repository.getTabsWithOwnDesktopMode())
+        }
+}
diff --git a/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/tabstrip/AdaptiveTabStripTest.kt b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/tabstrip/AdaptiveTabStripTest.kt
