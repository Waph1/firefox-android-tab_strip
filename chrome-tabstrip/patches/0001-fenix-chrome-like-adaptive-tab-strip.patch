+/**
+ * Builds the "folio" shape of the selected tab: rounded top corners and concave feet at the bottom that blend the tab
+ * into the toolbar below it. The feet are drawn outside of the tab bounds.
+ */
+private fun DrawScope.folioPath(
+    top: Float,
+    cornerRadius: Float,
+    footRadius: Float,
+): Path {
+    val width = size.width
+    val height = size.height
+    return Path().apply {
+        moveTo(-footRadius, height)
+        arcTo(
+            rect = Rect(left = -2 * footRadius, top = height - 2 * footRadius, right = 0f, bottom = height),
+            startAngleDegrees = 90f,
+            sweepAngleDegrees = -90f,
+            forceMoveTo = false,
+        )
+        lineTo(0f, top + cornerRadius)
+        arcTo(
+            rect = Rect(left = 0f, top = top, right = 2 * cornerRadius, bottom = top + 2 * cornerRadius),
+            startAngleDegrees = 180f,
+            sweepAngleDegrees = 90f,
+            forceMoveTo = false,
+        )
+        lineTo(width - cornerRadius, top)
+        arcTo(
+            rect = Rect(left = width - 2 * cornerRadius, top = top, right = width, bottom = top + 2 * cornerRadius),
+            startAngleDegrees = 270f,
+            sweepAngleDegrees = 90f,
+            forceMoveTo = false,
+        )
+        lineTo(width, height - footRadius)
+        arcTo(
+            rect = Rect(left = width, top = height - 2 * footRadius, right = width + 2 * footRadius, bottom = height),
+            startAngleDegrees = 180f,
+            sweepAngleDegrees = -90f,
+            forceMoveTo = false,
+        )
+        close()
+    }
+}
+
+/** Draws the vertical divider shown between two unselected tabs, on the end edge of the tab. */
+private fun DrawScope.drawEndDivider(color: Color) {
+    val x =
+        if (layoutDirection == LayoutDirection.Ltr) {
+            size.width - dividerWidth.toPx() / 2
+        } else {
+            dividerWidth.toPx() / 2
+        }
+    val centerY = (size.height + tabTopMargin.toPx()) / 2
+    val halfHeight = dividerHeight.toPx() / 2
+    drawLine(
+        color = color,
+        start = Offset(x, centerY - halfHeight),
+        end = Offset(x, centerY + halfHeight),
+        strokeWidth = dividerWidth.toPx(),
+    )
+}
+
+/**
+ * Fades out the content on its end edge (the left edge when [fadeLeft] is true), whatever the background is.
+ */
+private fun Modifier.fadingEdge(
+    fadeWidth: Dp,
+    fadeLeft: Boolean,
+): Modifier =
+    graphicsLayer { compositingStrategy = CompositingStrategy.Offscreen }
+        .drawWithContent {
+            drawContent()
+            val fade = fadeWidth.toPx().coerceAtMost(size.width)
+            val brush =
+                if (fadeLeft) {
+                    Brush.horizontalGradient(
+                        colors = listOf(Color.Transparent, Color.Black),
+                        startX = 0f,
+                        endX = fade,
+                    )
+                } else {
+                    Brush.horizontalGradient(
+                        colors = listOf(Color.Black, Color.Transparent),
+                        startX = size.width - fade,
+                        endX = size.width,
+                    )
+                }
+            drawRect(brush = brush, blendMode = BlendMode.DstIn)
+        }
