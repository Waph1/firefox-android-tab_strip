@@ -0,0 +1,114 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.browser.tabstrip
+
+import android.content.Context
+import android.content.res.Configuration
+import androidx.annotation.VisibleForTesting
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import org.mozilla.fenix.ext.TALL_SCREEN_HEIGHT_DP
+import org.mozilla.fenix.ext.WIDE_SCREEN_WIDTH_DP
+import org.mozilla.fenix.utils.isLargeScreenSize
+
+/**
+ * Decides, like Chrome for Android does, whether the current window is large enough to show the tab strip.
+ *
+ * The tab strip is shown when:
+ * - the screen the app is currently displayed on is a "tablet" screen, i.e. its smallest width is at least 600dp, the
+ *   same threshold as Chrome's `DeviceFormFactor.MINIMUM_TABLET_WIDTH_DP` (tablets, the inner screen of an unfolded
+ *   foldable like the Galaxy Z Fold, but not its cover screen), and
+ * - the app window is at least [MIN_WINDOW_WIDTH_DP] wide (so it hides in narrow split-screen or pop-up windows).
+ *
+ * Foldables switch screen when they are folded / unfolded and `HomeActivity` handles those configuration changes
+ * itself (no activity recreation), so `HomeActivity` calls [onWindowChanged] from `onCreate` and
+ * `onConfigurationChanged`. The value is backed by Compose snapshot state, so every composable reading it (directly or
+ * through `Settings.isTabStripEnabled`) recomposes and shows / hides the tab strip immediately. Non Compose code can
+ * observe [windowLayout].
+ */
+object AdaptiveTabStrip {
+    /** Same threshold Chrome uses to hide its tab strip in narrow windows. */
+    const val MIN_WINDOW_WIDTH_DP = 412
+
+    /**
+     * Coarse description of the current window, used to know when the toolbars need to be rebuilt.
+     *
+     * @property isTabStripAllowed Whether the window is large enough to show the tab strip.
+     * @property isWideWindow Whether the window is wider than [WIDE_SCREEN_WIDTH_DP].
+     * @property isTallWindow Whether the window is taller than [TALL_SCREEN_HEIGHT_DP].
+     */
+    data class WindowLayout(
+        val isTabStripAllowed: Boolean,
+        val isWideWindow: Boolean,
+        val isTallWindow: Boolean,
+    )
+
+    // Until a window reports its size, defer to the user preference only.
+    private var tabStripAllowedState by mutableStateOf(true)
+
+    private val windowLayoutFlow =
+        MutableStateFlow(
+            WindowLayout(
+                isTabStripAllowed = true,
+                isWideWindow = false,
+                isTallWindow = true,
+            ),
+        )
+
+    /** Whether the current window is large enough to show the tab strip. Backed by Compose snapshot state. */
+    val isTabStripAllowed: Boolean
+        get() = tabStripAllowedState
+
+    /** [StateFlow] emitting every time the coarse [WindowLayout] of the app window changes. */
+    val windowLayout: StateFlow<WindowLayout> = windowLayoutFlow.asStateFlow()
+
+    private val largeWindowFlow = MutableStateFlow<Boolean?>(null)
+
+    /**
+     * Whether the app window is large enough for the tab strip (whatever the tab strip preference), or `null` until a
+     * window reports its size. Large windows also show desktop sites by default, see `AdaptiveDesktopModeMiddleware`.
+     */
+    val isLargeWindow: StateFlow<Boolean?> = largeWindowFlow.asStateFlow()
+
+    /**
+     * Updates the state from the window of [context] (the activity hosting the browser).
+     *
+     * @param context The [Context] of the activity hosting the tab strip.
+     * @param configuration The current [Configuration] of that activity.
+     */
+    fun onWindowChanged(
+        context: Context,
+        configuration: Configuration = context.resources.configuration,
+    ) {
+        update(
+            isTabletScreen = context.isLargeScreenSize(),
+            screenWidthDp = configuration.screenWidthDp,
+            screenHeightDp = configuration.screenHeightDp,
+        )
+    }
+
+    @VisibleForTesting
+    internal fun update(
+        isTabletScreen: Boolean,
+        screenWidthDp: Int,
+        screenHeightDp: Int,
+    ) {
+        val isAllowed = isTabletScreen && screenWidthDp >= MIN_WINDOW_WIDTH_DP
+        if (tabStripAllowedState != isAllowed) {
+            tabStripAllowedState = isAllowed
+        }
+        windowLayoutFlow.value =
+            WindowLayout(
+                isTabStripAllowed = isAllowed,
+                isWideWindow = screenWidthDp > WIDE_SCREEN_WIDTH_DP,
+                isTallWindow = screenHeightDp > TALL_SCREEN_HEIGHT_DP,
+            )
+        largeWindowFlow.value = isAllowed
+    }
+}
