+private val dividerHeight = 20.dp
+private val dividerWidth = 1.dp
+private val titleFadeWidth = 16.dp
+private val modeToggleSize = 32.dp
+
+private const val TAB_ANIMATION_MS = 150
+private const val TAB_RESIZE_DELAY_MS = 1500L
+
+/**
+ * Target of the private / normal browsing toggle shown at the end of the tab strip, like Chrome's incognito model
+ * selector. Tapping the toggle selects the most recently used tab of the other browsing mode.
+ *
+ * @property tabId The id of the tab that will be selected.
+ * @property url The url of the tab that will be selected.
+ */
+internal data class TabStripModeToggle(
+    val tabId: String,
+    val url: String,
+)
+
+/**
+ * Returns the [TabStripModeToggle] to show in the tab strip, or null when the other browsing mode has no tabs.
+ *
+ * @param browserStore The [BrowserStore] used to observe the tabs.
+ * @param isPrivateMode Whether the tab strip currently shows private tabs.
+ */
+@Composable
+internal fun rememberTabStripModeToggle(
+    browserStore: BrowserStore,
+    isPrivateMode: Boolean,
+): TabStripModeToggle? {
+    val toggle by
+        remember(browserStore, isPrivateMode) {
+                browserStore.stateFlow.map { it.toTabStripModeToggle(isPrivateMode) }.distinctUntilChanged()
+            }
+            .collectAsState(initial = browserStore.state.toTabStripModeToggle(isPrivateMode))
+    return toggle
+}
+
+internal fun BrowserState.toTabStripModeToggle(isPrivateMode: Boolean): TabStripModeToggle? =
+    getNormalOrPrivateTabs(private = !isPrivateMode)
+        .maxByOrNull { it.lastAccess }
+        ?.let { TabStripModeToggle(tabId = it.id, url = it.content.url) }
+
+/**
+ * Tab strip content laid out and animated like the tab strip of Chrome for Android:
+ * - the selected tab is drawn as a "folio" that merges into the toolbar, unselected tabs are separated by dividers;
+ * - tabs share the available width (between 108dp and 265dp) and the strip scrolls once they reach the minimum width;
+ * - unselected tabs narrower than 156dp hide their close button;
+ * - after closing a tab, the remaining tabs keep their width for a moment so that the next close button ends up under
+ *   the finger, then they resize;
+ * - new tabs slide up into the strip and closed tabs slide down out of it;
+ * - the new tab button follows the last tab and sticks to the end of the strip when tabs overflow;
+ * - a private browsing toggle is shown when the other browsing mode has tabs.
+ *
+ * @param state The [TabStripState] to render.
+ * @param colors The [TabStripColors] to use.
+ * @param modeToggle The private / normal browsing toggle, if it should be shown.
+ * @param showTabCounterButton Whether to show the tab counter button at the end of the strip.
+ * @param onAddTabClick Invoked when the new tab button is clicked.
+ * @param onCloseTabClick Invoked when a tab is closed.
+ * @param onSelectedTabClick Invoked when a tab, or the browsing mode toggle, is clicked.
+ * @param onMove Invoked when a tab is moved by dragging it.
+ * @param onTabCounterClick Invoked when the tab counter is clicked.
+ */
+@Composable
+@Suppress("LongParameterList")
+internal fun ChromeStyleTabStripContent(
+    state: TabStripState,
+    colors: TabStripColors,
+    modeToggle: TabStripModeToggle?,
+    showTabCounterButton: Boolean,
+    onAddTabClick: () -> Unit,
+    onCloseTabClick: (id: String, isPrivate: Boolean) -> Unit,
+    onSelectedTabClick: (tabId: String, url: String) -> Unit,
+    onMove: (tabId: String, targetId: String, placeAfter: Boolean) -> Unit,
+    onTabCounterClick: () -> Unit,
+) {
+    Row(
+        modifier =
+            Modifier.fillMaxWidth()
+                .height(dimensionResource(R.dimen.tab_strip_height))
+                .background(brush = colors.backgroundBrush)
+                .clipToBounds()
+                .systemGestureExclusion(),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Row(
+            modifier = Modifier.weight(1f).fillMaxHeight(),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            ChromeStyleTabsList(
+                state = state,
+                tabItemBackgroundColors = colors.tabItemBackgroundColors,
+                modifier = Modifier.weight(1f, fill = false).fillMaxHeight(),
+                onCloseTabClick = onCloseTabClick,
+                onSelectedTabClick = onSelectedTabClick,
+                onMove = onMove,
+            )
+
+            IconButton(onClick = onAddTabClick, contentDescription = stringResource(R.string.add_tab)) {
+                Icon(
+                    painter = painterResource(iconsR.drawable.mozac_ic_plus_24),
+                    modifier = Modifier.size(20.dp),
+                    tint = MaterialTheme.colorScheme.onSurface,
+                    contentDescription = null,
+                )
+            }
+        }
+
+        if (modeToggle != null) {
+            PrivateModeToggle(
+                isPrivateMode = state.isPrivateMode,
+                onClick = { onSelectedTabClick(modeToggle.tabId, modeToggle.url) },
+            )
+        }
+
+        if (showTabCounterButton) {
+            TabStripTabCounterButton(
+                tabCount = state.tabs.size,
+                size = dimensionResource(R.dimen.tab_strip_height),
+                menuItems = state.menuItems,
+                privacyBadgeVisible = state.isPrivateMode,
+                onClick = onTabCounterClick,
+            )
+        }
+    }
+}
+
+@Composable
+@Suppress("LongMethod", "CognitiveComplexMethod")
+private fun ChromeStyleTabsList(
+    state: TabStripState,
+    tabItemBackgroundColors: TabStripColors.TabColors,
+    modifier: Modifier = Modifier,
+    onCloseTabClick: (id: String, isPrivate: Boolean) -> Unit,
+    onSelectedTabClick: (tabId: String, url: String) -> Unit,
+    onMove: (tabId: String, targetId: String, placeAfter: Boolean) -> Unit,
+) {
+    BoxWithConstraints(modifier = modifier) {
+        val listState = rememberLazyListState()
+        val availableWidth = maxWidth - stripHorizontalPadding * 2
+        val fittingTabWidth =
+            if (state.tabs.isEmpty()) {
+                maxTabWidth
+            } else {
+                (availableWidth / state.tabs.size).coerceIn(minTabWidth, maxTabWidth)
+            }
+
+        // Like Chrome, keep the tabs width for a moment after a tab is closed from the strip so that the close button
+        // of the next tab ends up under the finger.
+        var frozenTabWidth by remember { mutableStateOf<Dp?>(null) }
+        var closeCount by remember { mutableIntStateOf(0) }
+        LaunchedEffect(closeCount) {
+            if (frozenTabWidth != null) {
+                delay(TAB_RESIZE_DELAY_MS)
+                frozenTabWidth = null
+            }
+        }
+        LaunchedEffect(maxWidth) { frozenTabWidth = null }
+
+        val targetTabWidth = frozenTabWidth?.let { minOf(it, fittingTabWidth) } ?: fittingTabWidth
+        val tabWidth by animateDpAsState(targetValue = targetTabWidth, animationSpec = tween(TAB_ANIMATION_MS))
+
+        val newTabIds = rememberNewTabIds(state.tabs)
+
+        val reorderState =
+            createListReorderState(
+                listState = listState,
+                onMove = { movedTab, adjacentTab ->
+                    onMove(
+                        (movedTab.key as String),
+                        (adjacentTab.key as String),
+                        movedTab.index < adjacentTab.index,
+                    )
+                },
+                ignoredItems = emptyList(),
+            )
+
+        LazyRow(
+            modifier =
+                Modifier.fillMaxHeight()
+                    .detectListPressAndDrag(
+                        reorderState = reorderState,
+                        listState = listState,
+                        shouldLongPressToDrag = true,
+                    )
+                    .selectableGroup(),
+            state = listState,
+            contentPadding = PaddingValues(horizontal = stripHorizontalPadding),
+            verticalAlignment = Alignment.Bottom,
+        ) {
+            itemsIndexed(
+                items = state.tabs,
+                key = { _, item -> item.id },
+            ) { index, itemState ->
+                val nextTab = state.tabs.getOrNull(index + 1)
+                ReorderableDragItemContainer(
+                    state = reorderState,
+                    key = itemState.id,
+                    position = index,
+                ) {
+                    ChromeStyleTabItem(
+                        state = itemState,
+                        width = tabWidth,
+                        showCloseButton = itemState.isSelected || targetTabWidth >= minTabWidthForCloseButton,
+                        showEndDivider = nextTab != null && !itemState.isSelected && !nextTab.isSelected,
+                        isNewTab = itemState.id in newTabIds,
+                        backgroundColors = tabItemBackgroundColors,
+                        onCloseTabClick = { id, isPrivate ->
+                            if (state.tabs.lastOrNull()?.id != id) {
+                                frozenTabWidth = targetTabWidth
+                                closeCount++
+                            }
+                            onCloseTabClick(id, isPrivate)
+                        },
+                        onSelectedTabClick = onSelectedTabClick,
+                        modifier =
+                            Modifier.thenConditional(
+                                modifier = Modifier.semantics { traversalIndex = -1f },
+                                predicate = { itemState.isSelected },
+                            ),
+                    )
+                }
+            }
+        }
+
+        if (state.tabs.isNotEmpty()) {
+            // When a new tab is added, scroll to the end of the list. This acts on state changes so it also works
+            // for tabs opened from any other place, e.g. the tabs tray or a link.
+            LaunchedEffect(state.tabs.last().id) {
+                listState.scrollToItem(state.tabs.lastIndex)
+            }
+
+            // When a tab is selected, scroll to it if it isn't fully visible.
+            val selectedTab = state.tabs.firstOrNull { it.isSelected }
+            LaunchedEffect(selectedTab?.id) {
+                if (selectedTab != null) {
+                    val selectedItemInfo =
+                        listState.layoutInfo.visibleItemsInfo.firstOrNull { it.key == selectedTab.id }
+
+                    if (selectedItemInfo == null || listState.isItemPartiallyVisible(selectedItemInfo)) {
+                        listState.animateScrollToItem(state.tabs.indexOf(selectedTab))
+                    }
+                }
+            }
+        }
+    }
+}
+
+/**
+ * Returns the ids of the tabs that have just been added to [tabs], so that they can be animated in. Tabs shown when
+ * the strip is first composed, or after switching between normal and private browsing, are not considered new.
+ */
+@Composable
+private fun rememberNewTabIds(tabs: List<TabStripItem>): Set<String> {
+    val previousIds = remember { arrayOfNulls<Set<String>>(1) }
+    val ids = tabs.mapTo(HashSet()) { it.id }
+    return remember(ids) {
+        val previous = previousIds[0]
+        previousIds[0] = ids
+        if (previous == null || previous.none { it in ids }) {
+            emptySet()
+        } else {
+            ids - previous
+        }
+    }
+}
+
+@Composable
+@Suppress("LongMethod", "LongParameterList", "CognitiveComplexMethod")
+private fun ChromeStyleTabItem(
+    state: TabStripItem,
+    width: Dp,
+    showCloseButton: Boolean,
+    showEndDivider: Boolean,
+    isNewTab: Boolean,
+    backgroundColors: TabStripColors.TabColors,
+    onCloseTabClick: (id: String, isPrivate: Boolean) -> Unit,
+    onSelectedTabClick: (id: String, url: String) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val folioColor = backgroundColors.get(isActive = true)
+    val dividerColor = MaterialTheme.colorScheme.outlineVariant
+    val folioAlpha by
+        animateFloatAsState(
+            targetValue = if (state.isSelected) 1f else 0f,
+            animationSpec = tween(TAB_ANIMATION_MS),
+        )
+
+    // 1f means the tab is fully below the strip: new tabs slide up into it, closed tabs slide down out of it.
+    val slideIn = remember { Animatable(if (isNewTab) 1f else 0f) }
+    val slideOut = remember { Animatable(0f) }
+    var isClosing by remember { mutableStateOf(false) }
+    val scope = rememberCoroutineScope()
+    LaunchedEffect(Unit) { slideIn.animateTo(0f, tween(TAB_ANIMATION_MS)) }
+
+    val closeTab: () -> Unit = {
+        if (!isClosing) {
+            isClosing = true
+            scope.launch {
+                try {
+                    slideOut.animateTo(1f, tween(TAB_ANIMATION_MS))
+                } finally {
+                    onCloseTabClick(state.id, state.isPrivate)
+                }
+            }
+        }
+    }
+
+    val closeTabLabel = stringResource(R.string.close_tab)
+
+    Box(
+        modifier =
+            modifier
+                .width(width)
+                .fillMaxHeight()
+                .graphicsLayer {
+                    translationY = maxOf(slideIn.value, slideOut.value) * size.height
+                    alpha = 1f - slideOut.value
+                }
+                .drawBehind {
+                    if (showEndDivider) {
+                        drawEndDivider(color = dividerColor)
+                    }
+                    if (folioAlpha > 0f) {
+                        drawPath(
+                            path =
+                                folioPath(
+                                    top = tabTopMargin.toPx(),
+                                    cornerRadius = folioCornerRadius.toPx(),
+                                    footRadius = folioFootRadius.toPx(),
+                                ),
+                            color = folioColor,
+                            alpha = folioAlpha,
+                        )
+                    }
+                },
+    ) {
+        Row(
+            modifier =
+                Modifier.fillMaxSize()
+                    .padding(top = tabTopMargin)
+                    .clip(RoundedCornerShape(topStart = folioCornerRadius, topEnd = folioCornerRadius))
+                    .clickable { onSelectedTabClick(state.id, state.url) }
+                    .semantics {
+                        role = Role.Tab
+                        selected = state.isSelected
+                        customActions =
+                            listOf(
+                                CustomAccessibilityAction(label = closeTabLabel) {
+                                    closeTab()
+                                    true
+                                },
+                            )
+                    }
+                    .padding(start = tabContentStartPadding, end = tabContentEndPadding),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            TabIcon(
+                url = state.url,
+                icon = state.icon,
+                isLoading = state.isLoading,
+            )
+
+            Spacer(modifier = Modifier.width(faviconTitleSpacing))
+
+            // This makes sure that isRtl is only calculated when the title changes.
+            val isTitleRtl = remember(state.title) { BidiFormatter.getInstance().isRtl(state.title) }
+
+            Box(
+                modifier =
+                    Modifier.weight(1f).fillMaxHeight().fadingEdge(fadeWidth = titleFadeWidth, fadeLeft = isTitleRtl),
+                contentAlignment = Alignment.CenterStart,
+            ) {
+                Text(
+                    text = state.title,
+                    color =
+                        if (state.isSelected) {
+                            MaterialTheme.colorScheme.onSurface
+                        } else {
+                            MaterialTheme.colorScheme.onSurfaceVariant
+                        },
+                    softWrap = false,
+                    maxLines = 1,
+                    style = FirefoxTheme.typography.body2.copy(fontSize = 13.sp),
+                )
+            }
+
+            if (showCloseButton) {
+                val closeButtonDescription = stringResource(id = R.string.close_tab_title, state.title)
+                Box(
+                    modifier =
+                        Modifier.size(closeButtonSize)
+                            .clip(CircleShape)
+                            .clickable(onClick = closeTab)
+                            .then(
+                                if (state.isSelected) {
+                                    Modifier.semantics { contentDescription = closeButtonDescription }
+                                } else {
+                                    Modifier.clearAndSetSemantics {}
+                                },
+                            ),
+                    contentAlignment = Alignment.Center,
+                ) {
+                    Icon(
+                        painter = painterResource(iconsR.drawable.mozac_ic_cross_20),
+                        modifier = Modifier.size(closeIconSize),
+                        tint =
+                            if (state.isSelected) {
+                                MaterialTheme.colorScheme.onSurface
+                            } else {
+                                MaterialTheme.colorScheme.onSurfaceVariant
+                            },
+                        contentDescription = null,
+                    )
+                }
+            } else {
+                Spacer(modifier = Modifier.width(tabContentEndPadding))
+            }
+        }
+    }
+}
+
+/**
+ * Favicon of a tab, replaced by a progress indicator while the page loads (like Chrome's tab strip throbber).
+ */
+@Composable
+private fun TabIcon(
+    url: String,
+    icon: Bitmap?,
+    isLoading: Boolean,
+) {
+    Box(
+        modifier = Modifier.size(faviconSize),
+        contentAlignment = Alignment.Center,
+    ) {
+        when {
+            isLoading ->
+                CircularProgressIndicator(
+                    modifier = Modifier.size(faviconSize),
+                    color = MaterialTheme.colorScheme.primary,
+                    strokeWidth = 2.dp,
+                )
+
+            icon != null && !icon.isRecycled ->
+                Image(
+                    bitmap = icon.asImageBitmap(),
+                    contentDescription = null,
+                    modifier = Modifier.size(faviconSize).clip(RoundedCornerShape(2.dp)),
+                )
+
+            url == ABOUT_HOME_URL ->
+                Favicon(
+                    imageResource = R.drawable.ic_firefox,
+                    size = faviconSize,
+                )
+
+            else ->
+                Favicon(
+                    url = url,
+                    size = faviconSize,
+                )
+        }
+    }
+}
