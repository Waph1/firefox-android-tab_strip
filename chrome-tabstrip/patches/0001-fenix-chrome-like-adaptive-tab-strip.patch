+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/desktopmode/AdaptiveDesktopModeRepository.kt
@@ -0,0 +1,89 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.browser.desktopmode
+
+import android.content.Context
+import androidx.datastore.core.DataStore
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.booleanPreferencesKey
+import androidx.datastore.preferences.core.emptyPreferences
+import androidx.datastore.preferences.core.stringSetPreferencesKey
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.map
+import org.mozilla.fenix.datastore.editOrCatch
+import org.mozilla.fenix.datastore.preferencesDataStore
+import java.io.IOException
+
+// The key of DefaultDesktopModeRepository: an existing preference keeps applying to large windows.
+private const val LARGE_WINDOW_DESKTOP_BROWSING_KEY = "desktop_browsing_key_2"
+private const val SMALL_WINDOW_DESKTOP_BROWSING_KEY = "desktop_browsing_small_window_key"
+private const val TABS_WITH_OWN_DESKTOP_MODE_KEY = "desktop_browsing_tabs_with_own_mode_key"
+
+private val largeWindowDesktopBrowsingKey = booleanPreferencesKey(LARGE_WINDOW_DESKTOP_BROWSING_KEY)
+private val smallWindowDesktopBrowsingKey = booleanPreferencesKey(SMALL_WINDOW_DESKTOP_BROWSING_KEY)
+private val tabsWithOwnDesktopModeKey = stringSetPreferencesKey(TABS_WITH_OWN_DESKTOP_MODE_KEY)
+
+/**
+ * Stores the desktop mode settings used by [AdaptiveDesktopModeMiddleware].
+ *
+ * The "Always request desktop site" preference is stored separately for large windows (tablets, the inner screen of an
+ * unfolded foldable) and small windows (phones, the cover screen of a foldable, narrow split-screen windows), so that
+ * it can follow the window when a foldable is folded or unfolded. Like upstream, desktop sites are requested by
+ * default in large windows only.
+ *
+ * @param context Android context used to obtain the underlying [DataStore].
+ * @param dataStore [DataStore] for accessing user preferences.
+ */
+class AdaptiveDesktopModeRepository(
+    context: Context,
+    private val dataStore: DataStore<Preferences> = context.preferencesDataStore,
+) {
+    private val preferences
+        get() = dataStore.data.catch { exception ->
+            if (exception is IOException) emit(emptyPreferences()) else throw exception
+        }
+
+    /**
+     * Returns whether desktop sites are requested by default for the newly opened tabs.
+     *
+     * @param isLargeWindow Whether the preference of large or small windows is wanted.
+     */
+    suspend fun getDesktopBrowsingEnabled(isLargeWindow: Boolean): Boolean =
+        preferences.map { it[desktopBrowsingKey(isLargeWindow)] ?: isLargeWindow }.first()
+
+    /**
+     * Updates whether desktop sites are requested by default for the newly opened tabs.
+     *
+     * @param isLargeWindow Whether the preference of large or small windows is updated.
+     * @param enabled Whether desktop sites are requested by default.
+     * @return Whether the preference was written.
+     */
+    suspend fun setDesktopBrowsingEnabled(isLargeWindow: Boolean, enabled: Boolean): Boolean {
+        var preferenceWriteSucceeded = true
+        dataStore.editOrCatch(onError = { preferenceWriteSucceeded = false }) { preferences ->
+            preferences[desktopBrowsingKey(isLargeWindow)] = enabled
+        }
+        return preferenceWriteSucceeded
+    }
+
+    /** Returns the IDs of the tabs whose site version was chosen from the menu and doesn't follow the window. */
+    suspend fun getTabsWithOwnDesktopMode(): Set<String> =
+        preferences.map { it[tabsWithOwnDesktopModeKey] ?: emptySet() }.first()
+
+    /**
+     * Updates the IDs of the tabs whose site version was chosen from the menu and doesn't follow the window.
+     *
+     * @param tabIds The IDs of those tabs.
+     */
+    suspend fun setTabsWithOwnDesktopMode(tabIds: Set<String>) {
+        dataStore.editOrCatch(onError = {}) { preferences ->
+            preferences[tabsWithOwnDesktopModeKey] = tabIds
+        }
+    }
+
+    private fun desktopBrowsingKey(isLargeWindow: Boolean) =
+        if (isLargeWindow) largeWindowDesktopBrowsingKey else smallWindowDesktopBrowsingKey
+}
