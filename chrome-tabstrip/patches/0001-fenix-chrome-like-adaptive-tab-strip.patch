+import androidx.fragment.app.Fragment
+import androidx.fragment.app.FragmentManager
+
+/**
+ * Hides the status bar while the tab strip is shown, so that the tabs sit flush with the top edge of the screen (e.g.
+ * on the inner screen of an unfolded foldable), and shows it again as soon as the tab strip goes away (e.g. when the
+ * foldable is folded and the app moves to the cover screen).
+ *
+ * While hidden, the status bar can still be revealed for a moment by swiping down from the top edge of the screen. It
+ * is then laid over the tabs: the app content is given window insets in which the status bar and the top display cutout
+ * take no space (see [transformInsets]), so that the UI never moves when the status bar is revealed, nor when a window
+ * that does not hide it (e.g. a popup) brings it back. Dialogs hide it as well while they are shown.
+ *
+ * Only on Android 13+, where Fenix is shown edge-to-edge, and never in multi-window mode, where the system keeps the
+ * status bar visible.
+ *
+ * @param activity The activity showing the tab strip.
+ * @param isTabStripShown Whether the tab strip is currently shown, which may change with the window (e.g. when a
+ *   foldable is folded / unfolded) or with the user preference.
+ */
+class ImmersiveTabStrip(
+    private val activity: Activity,
+    private val isTabStripShown: () -> Boolean,
+) {
+    private val window: Window
+        get() = activity.window
+
+    private var isStarted = false
+
+    /** Dialogs currently shown: while focused, they decide whether the status bar is shown. */
+    private val shownDialogs = mutableSetOf<DialogFragment>()
+
+    /** Whether the status bar is currently hidden because the tab strip is shown. */
+    var isStatusBarHidden: Boolean = false
+        private set
+
+    private val dialogCallbacks =
+        object : FragmentManager.FragmentLifecycleCallbacks() {
+            override fun onFragmentViewCreated(
+                fm: FragmentManager,
+                f: Fragment,
+                v: View,
+                savedInstanceState: Bundle?,
+            ) {
+                // Before the dialog is shown, so that it doesn't bring the status bar back even for a moment.
+                if (f is DialogFragment && isStatusBarHidden) {
+                    f.dialog?.window?.setStatusBarHidden(true)
+                }
+            }
+
+            override fun onFragmentStarted(
+                fm: FragmentManager,
+                f: Fragment,
+            ) {
+                if (f is DialogFragment) {
+                    shownDialogs += f
+                    f.dialog?.window?.setStatusBarHidden(isStatusBarHidden)
+                }
+            }
+
+            override fun onFragmentStopped(
+                fm: FragmentManager,
+                f: Fragment,
+            ) {
+                if (f is DialogFragment) {
+                    shownDialogs -= f
+                }
+            }
+        }
+
+    /**
+     * Starts hiding / showing the status bar together with the tab strip. Must be called from `onCreate`, before the
+     * content view is set.
+     *
+     * @param fragmentManager The [FragmentManager] of [activity], used to also hide the status bar in its dialogs.
+     */
+    fun start(fragmentManager: FragmentManager) {
+        if (SDK_INT < VERSION_CODES.TIRAMISU || isStarted) return
+        isStarted = true
+
+        val decorView = window.decorView
+        ViewCompat.setOnApplyWindowInsetsListener(decorView) { view, insets ->
+            // Let the decor view handle the real insets, then pass the adjusted ones to the app content. Every change
+            // of window (folding, multi-window, ...) or of screen (fragments request new insets) passes by here: also
+            // hide the status bar again if something showed it, e.g. when leaving a fullscreen video.
+            val decorInsets = ViewCompat.onApplyWindowInsets(view, insets)
+            update()
+            transformInsets(decorInsets)
+        }
+        // Insets animations (e.g. the keyboard) are dispatched separately: adjust them too, so the content keeps its
+        // position while they run.
+        ViewCompat.setWindowInsetsAnimationCallback(
+            decorView,
+            object : WindowInsetsAnimationCompat.Callback(DISPATCH_MODE_CONTINUE_ON_SUBTREE) {
+                override fun onProgress(
+                    insets: WindowInsetsCompat,
+                    runningAnimations: MutableList<WindowInsetsAnimationCompat>,
+                ): WindowInsetsCompat = transformInsets(insets)
+            },
+        )
+        fragmentManager.registerFragmentLifecycleCallbacks(dialogCallbacks, true)
+
+        update()
+    }
+
+    /**
+     * Hides or shows the status bar to match the tab strip. Called automatically every time the window insets change,
+     * call it when the tab strip visibility may have changed (e.g. when the configuration changes).
+     */
+    fun update() {
+        // Fullscreen content (e.g. a video) hides all the system bars by itself and shows them back when leaving it.
+        if (!isStarted || window.isInFullScreen()) return
+
+        val shouldHide =
+            shouldHideStatusBar(
+                sdkInt = SDK_INT,
+                isInMultiWindowMode = activity.isInMultiWindowMode,
+                isTabStripShown = isTabStripShown(),
+            )
+        if (shouldHide) {
+            window.setStatusBarHidden(true)
+        } else if (isStatusBarHidden) {
+            window.setStatusBarHidden(false)
+        }
+
+        if (shouldHide != isStatusBarHidden) {
+            isStatusBarHidden = shouldHide
+            shownDialogs.forEach { it.dialog?.window?.setStatusBarHidden(shouldHide) }
+            // The insets given to the app content depend on it.
+            ViewCompat.requestApplyInsets(window.decorView)
+        }
+    }
+
+    /**
+     * Returns the window insets as the app content should see them: while the status bar is hidden, neither it nor the
+     * top display cutout (e.g. a camera hole) take any space, so that the tabs sit flush with the top edge of the
+     * screen and stay there when the status bar is revealed for a moment.
+     */
+    @VisibleForTesting
+    internal fun transformInsets(insets: WindowInsetsCompat): WindowInsetsCompat {
+        if (!isStatusBarHidden || window.isInFullScreen()) return insets
+
+        val cutout = insets.getInsets(displayCutout())
+        return WindowInsetsCompat.Builder(insets)
+            .setInsets(statusBars(), Insets.NONE)
+            .setInsets(displayCutout(), Insets.of(cutout.left, 0, cutout.right, cutout.bottom))
+            .build()
+    }
+
+    private fun Window.isInFullScreen() = attributes.flags and WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS != 0
+
+    private fun Window.setStatusBarHidden(hidden: Boolean) {
+        val insetsController = WindowInsetsControllerCompat(this, decorView)
+        if (hidden) {
+            insetsController.systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+            insetsController.hide(statusBars())
+        } else {
+            insetsController.show(statusBars())
+        }
+    }
+
+    companion object {
+        /**
+         * Whether the status bar should be hidden.
+         *
+         * @param sdkInt The Android version: only from Android 13, where Fenix is shown edge-to-edge.
+         * @param isInMultiWindowMode Whether the app shares the screen with other apps: the system then keeps the
+         *   status bar visible.
+         * @param isTabStripShown Whether the tab strip is shown.
+         */
+        @VisibleForTesting
+        internal fun shouldHideStatusBar(
+            sdkInt: Int,
+            isInMultiWindowMode: Boolean,
+            isTabStripShown: Boolean,
+        ) = sdkInt >= VERSION_CODES.TIRAMISU && !isInMultiWindowMode && isTabStripShown
+    }
+}
