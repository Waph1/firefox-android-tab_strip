--- /dev/null
+++ b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/selfupdate/SelfUpdaterTest.kt
@@ -0,0 +1,101 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.selfupdate
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+
+private const val CERTIFICATE = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+private const val HOUR_MS = 60 * 60 * 1000L
+
+@RunWith(RobolectricTestRunner::class)
+class SelfUpdaterTest {
+    private val update =
+        SelfUpdateInfo(
+            packageName = "org.mozilla.firefox",
+            versionName = "158.0.1",
+            versionCode = 2016000000L,
+            apkUrl = "https://github.com/owner/repo/releases/download/tag/firefox.apk",
+            signingCertSha256 = CERTIFICATE,
+        )
+
+    private fun json(
+        apkUrl: String = update.apkUrl,
+        certificate: String = CERTIFICATE,
+    ) = """
+        {
+          "packageName": "org.mozilla.firefox",
+          "versionName": "158.0.1",
+          "versionCode": 2016000000,
+          "apkUrl": "$apkUrl",
+          "signingCertSha256": "$certificate"
+        }
+    """
+
+    @Test
+    fun `GIVEN a valid update json WHEN parsed THEN the update is returned`() {
+        assertEquals(update, SelfUpdateInfo.fromJson(json()))
+        assertEquals(update, SelfUpdateInfo.fromJson(json(certificate = CERTIFICATE.uppercase())))
+    }
+
+    @Test
+    fun `GIVEN an invalid update json WHEN parsed THEN there is no update`() {
+        assertNull(SelfUpdateInfo.fromJson("Not Found"))
+        assertNull(SelfUpdateInfo.fromJson("""{ "packageName": "org.mozilla.firefox" }"""))
+        assertNull(SelfUpdateInfo.fromJson(json(apkUrl = "http://example.com/firefox.apk")))
+        assertNull(SelfUpdateInfo.fromJson(json(certificate = "0123")))
+    }
+
+    @Test
+    fun `GIVEN a newer release of the same app signed with the same key THEN it is an update`() {
+        var checkedCertificate: ByteArray? = null
+
+        val isUpdate =
+            update.isUpdateFor("org.mozilla.firefox", installedVersionCode = 2015000000L) { certificate ->
+                checkedCertificate = certificate
+                true
+            }
+
+        assertTrue(isUpdate)
+        assertArrayEquals(
+            ByteArray(32) { i -> ((i % 8) * 0x22 + 0x01).toByte() },
+            checkedCertificate,
+        )
+    }
+
+    @Test
+    fun `GIVEN a release that can't be installed on top of the app THEN it is not an update`() {
+        // Same or older version.
+        assertFalse(update.isUpdateFor("org.mozilla.firefox", installedVersionCode = 2016000000L) { true })
+        assertFalse(update.isUpdateFor("org.mozilla.firefox", installedVersionCode = 2017000000L) { true })
+        // Another app, e.g. the Nightly or debug variant.
+        assertFalse(update.isUpdateFor("org.mozilla.fenix", installedVersionCode = 1L) { true })
+        // Signed with another key, e.g. a local build.
+        assertFalse(update.isUpdateFor("org.mozilla.firefox", installedVersionCode = 1L) { false })
+    }
+
+    @Test
+    fun `GIVEN the version name of a build THEN the Firefox version is shown`() {
+        assertEquals("158.0.1", displayVersion("158.0.1-default"))
+        assertEquals("159.0", displayVersion("159.0"))
+    }
+
+    @Test
+    fun `GIVEN the last check WHEN a day has passed THEN it's time to check again`() {
+        val lastCheck = 100 * 24 * HOUR_MS
+
+        assertTrue(isCheckDue(lastCheck = 0L, now = lastCheck))
+        assertFalse(isCheckDue(lastCheck = lastCheck, now = lastCheck + 23 * HOUR_MS))
+        assertTrue(isCheckDue(lastCheck = lastCheck, now = lastCheck + 24 * HOUR_MS))
+        // The clock went back.
+        assertTrue(isCheckDue(lastCheck = lastCheck, now = lastCheck - HOUR_MS))
+    }
+}
