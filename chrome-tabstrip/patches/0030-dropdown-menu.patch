+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import android.view.Gravity
+import androidx.fragment.app.DialogFragment
+import io.mockk.every
+import io.mockk.mockk
+import mozilla.components.support.test.robolectric.testContext
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mozilla.fenix.browser.tabstrip.AdaptiveTabStrip
+import org.mozilla.fenix.components.menu.MenuAccessPoint
+import org.robolectric.RobolectricTestRunner
+
+@RunWith(RobolectricTestRunner::class)
+class DropdownMenuFeatureTest {
+    private val fragment: DialogFragment = mockk { every { requireContext() } returns testContext }
+
+    @After
+    fun tearDown() {
+        // Restore the default state shared by all the tests (see AdaptiveTabStripTest).
+        AdaptiveTabStrip.update(isTabletScreen = true, screenWidthDp = 1000, screenHeightDp = 800)
+    }
+
+    private fun placement(
+        isToolbarAtBottom: Boolean,
+        isTabStripAtBottom: Boolean = false,
+        tabStripHeight: Int = 80,
+        windowWidth: Int = 2000,
+    ) = menuDropdownPlacement(
+        isToolbarAtBottom = isToolbarAtBottom,
+        tabStripHeight = tabStripHeight,
+        isTabStripAtBottom = isTabStripAtBottom,
+        toolbarHeight = 128,
+        windowWidth = windowWidth,
+        windowHeight = 1600,
+        density = 2f,
+    )
+
+    @Test
+    fun `GIVEN the address bar at the top WHEN placing the menu THEN it drops down under the address bar`() {
+        assertEquals(
+            MenuDropdownPlacement(gravity = Gravity.TOP or Gravity.END, x = 16, y = 208, width = 720, maxHeight = 1376),
+            placement(isToolbarAtBottom = false),
+        )
+        // The tab strip at the bottom isn't above the address bar.
+        assertEquals(128, placement(isToolbarAtBottom = false, isTabStripAtBottom = true).y)
+        // No tab strip.
+        assertEquals(128, placement(isToolbarAtBottom = false, tabStripHeight = 0).y)
+    }
+
+    @Test
+    fun `GIVEN the address bar at the bottom WHEN placing the menu THEN it opens upwards above the address bar`() {
+        assertEquals(
+            MenuDropdownPlacement(
+                gravity = Gravity.BOTTOM or Gravity.END,
+                x = 16,
+                y = 128,
+                width = 720,
+                maxHeight = 1456,
+            ),
+            placement(isToolbarAtBottom = true),
+        )
+        assertEquals(208, placement(isToolbarAtBottom = true, isTabStripAtBottom = true).y)
+    }
+
+    @Test
+    fun `GIVEN a narrow window WHEN placing the menu THEN it keeps a margin from the edges`() {
+        assertEquals(668, placement(isToolbarAtBottom = false, windowWidth = 700).width)
+    }
+
+    @Test
+    fun `GIVEN a small screen WHEN the menu is opened THEN it stays a bottom sheet`() {
+        AdaptiveTabStrip.update(isTabletScreen = false, screenWidthDp = 411, screenHeightDp = 960)
+
+        assertNull(DropdownMenuFeature.menuDialog(fragment, MenuAccessPoint.Browser))
+    }
+
+    @Test
+    fun `GIVEN a large screen WHEN the menu of a page or of the homepage is opened THEN it is a dropdown`() {
+        AdaptiveTabStrip.update(isTabletScreen = true, screenWidthDp = 1000, screenHeightDp = 800)
+
+        assertNotNull(DropdownMenuFeature.menuDialog(fragment, MenuAccessPoint.Browser))
+        assertNotNull(DropdownMenuFeature.menuDialog(fragment, MenuAccessPoint.Home))
+        // The menu of the tabs opened by other apps keeps its bottom sheet.
+        assertNull(DropdownMenuFeature.menuDialog(fragment, MenuAccessPoint.External))
+    }
+
+    @Test
+    fun `GIVEN the patch of the feature is applied THEN the feature shows the menu`() {
+        assertTrue(DropdownMenuFeature in PatchFeatureHooks.all)
+    }
+}
