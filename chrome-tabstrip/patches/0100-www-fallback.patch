+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.slot
+import io.mockk.verify
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestScope
+import kotlinx.coroutines.test.advanceTimeBy
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import mozilla.components.concept.engine.EngineSession
+import mozilla.components.concept.engine.EngineSession.LoadUrlFlags
+import mozilla.components.concept.engine.request.ErrorType
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class WwwFallbackTest {
+    private val testDispatcher = StandardTestDispatcher()
+    private val resolvedHosts = mutableListOf<String>()
+    private val existingHosts = mutableSetOf("www.example.it", "www.example.co.uk")
+
+    private val observer = slot<EngineSession.Observer>()
+    private val engineSession: EngineSession =
+        mockk(relaxed = true) {
+            every { register(capture(observer)) } returns Unit
+        }
+
+    private val fallback =
+        WwwFallback(
+            // Like the public suffix list, for the domains of the tests.
+            registrableDomain = { host ->
+                host.split('.').takeLast(if (host.endsWith(".co.uk")) 3 else 2).joinToString(".")
+            },
+            hostResolves = { host ->
+                resolvedHosts.add(host)
+                host in existingHosts
+            },
+            scope = CoroutineScope(testDispatcher),
+            errorPageTimeoutMs = 3000,
+        )
+
+    private fun typed(url: String) =
+        fallback.onLoadRequest(
+            engineSession,
+            url,
+            hasUserGesture = false,
+            isDirectNavigation = true,
+            isSubframeRequest = false,
+        )
+
+    private fun TestScope.showErrorPage(url: String) {
+        observer.captured.onLocationChange(url, hasUserGesture = false)
+        runCurrent()
+    }
+
+    private fun verifyLoaded(
+        url: String,
+        flags: LoadUrlFlags,
+    ) {
+        verify(exactly = 1) { engineSession.loadUrl(url, null, flags, null, null, false) }
+        verify { engineSession.unregister(observer.captured) }
+    }
+
+    private fun verifyNothingLoaded() {
+        verify(exactly = 0) { engineSession.loadUrl(any(), any(), any(), any(), any(), any()) }
+    }
+
+    @Test
+    fun `WHEN a typed address doesn't exist THEN the address with www replaces its error page`() =
+        runTest(testDispatcher) {
+            typed("http://example.it/page?q=1")
+            fallback.onLoadError(engineSession, ErrorType.ERROR_UNKNOWN_HOST, "https://example.it/page?q=1")
+            runCurrent()
+
+            assertEquals(listOf("www.example.it"), resolvedHosts)
+            verifyNothingLoaded()
+
+            showErrorPage("https://example.it/page?q=1")
+
+            verifyLoaded("http://www.example.it/page?q=1", LoadUrlFlags.select(LoadUrlFlags.LOAD_FLAGS_REPLACE_HISTORY))
+        }
+
+    @Test
+    fun `WHEN the error page is shown before the check THEN the address with www replaces it after the check`() =
+        runTest(testDispatcher) {
+            typed("http://example.co.uk")
+            fallback.onLoadError(engineSession, ErrorType.ERROR_CONNECTION_REFUSED, "http://example.co.uk/")
+            showErrorPage("http://example.co.uk/")
+
+            verifyLoaded("http://www.example.co.uk", LoadUrlFlags.select(LoadUrlFlags.LOAD_FLAGS_REPLACE_HISTORY))
+        }
+
+    @Test
+    fun `WHEN the error page isn't shown THEN the address with www is loaded after a while`() =
+        runTest(testDispatcher) {
+            typed("https://example.it")
+            fallback.onLoadError(engineSession, ErrorType.ERROR_SECURITY_BAD_CERT, "https://example.it/")
+            runCurrent()
+            advanceTimeBy(2999)
+            runCurrent()
+            verifyNothingLoaded()
+
+            advanceTimeBy(1)
+            runCurrent()
+
+            verifyLoaded("https://www.example.it", LoadUrlFlags.none())
+        }
+
+    @Test
+    fun `WHEN the address with www doesn't exist either THEN the error page stays`() =
+        runTest(testDispatcher) {
+            typed("http://nothing.it")
+            fallback.onLoadError(engineSession, ErrorType.ERROR_UNKNOWN_HOST, "https://nothing.it/")
+            showErrorPage("https://nothing.it/")
+            advanceTimeBy(5000)
+            runCurrent()
+
+            assertEquals(listOf("www.nothing.it"), resolvedHosts)
+            verifyNothingLoaded()
+            verify { engineSession.unregister(observer.captured) }
+        }
+
+    @Test
+    fun `WHEN a link fails THEN the address with www isn't tried`() =
+        runTest(testDispatcher) {
+            typed("https://www.mozilla.org")
+            fallback.onLoadRequest(
+                engineSession,
+                "https://example.it/",
+                hasUserGesture = true,
+                isDirectNavigation = false,
+                isSubframeRequest = false,
+            )
+            fallback.onLoadError(engineSession, ErrorType.ERROR_UNKNOWN_HOST, "https://example.it/")
+            advanceTimeBy(5000)
+            runCurrent()
+
+            assertTrue(resolvedHosts.isEmpty())
+            verifyNothingLoaded()
+        }
+
+    @Test
+    fun `WHEN a typed address is redirected to another site that fails THEN the address with www isn't tried`() =
+        runTest(testDispatcher) {
+            typed("http://short.it/x")
+            fallback.onLoadRequest(
+                engineSession,
+                "https://example.it/",
+                hasUserGesture = false,
+                isDirectNavigation = false,
+                isSubframeRequest = false,
+            )
+            fallback.onLoadError(engineSession, ErrorType.ERROR_UNKNOWN_HOST, "https://example.it/")
+            advanceTimeBy(5000)
+            runCurrent()
+
+            verifyNothingLoaded()
+        }
+
+    @Test
+    fun `WHEN HTTPS-First goes back to HTTP on the same site THEN the address with www is still tried`() =
+        runTest(testDispatcher) {
+            typed("http://example.it")
+            fallback.onLoadRequest(
+                engineSession,
+                "http://example.it/",
+                hasUserGesture = false,
+                isDirectNavigation = false,
+                isSubframeRequest = false,
+            )
+            fallback.onLoadError(engineSession, ErrorType.ERROR_NET_TIMEOUT, "http://example.it/")
+            showErrorPage("http://example.it/")
+
+            verifyLoaded("http://www.example.it", LoadUrlFlags.select(LoadUrlFlags.LOAD_FLAGS_REPLACE_HISTORY))
+        }
+
+    @Test
+    fun `WHEN another page is asked for before the error page THEN the address with www isn't loaded`() =
+        runTest(testDispatcher) {
+            typed("http://example.it")
+            fallback.onLoadError(engineSession, ErrorType.ERROR_UNKNOWN_HOST, "https://example.it/")
+            typed("https://www.mozilla.org")
+            showErrorPage("https://example.it/")
+            advanceTimeBy(5000)
+            runCurrent()
+
+            verifyNothingLoaded()
+        }
+
+    @Test
+    fun `WHEN other errors or subdomains fail THEN the address with www isn't tried`() =
+        runTest(testDispatcher) {
+            typed("http://example.it")
+            fallback.onLoadError(engineSession, ErrorType.ERROR_FILE_NOT_FOUND, "https://example.it/")
+            typed("http://shop.example.it")
+            fallback.onLoadError(engineSession, ErrorType.ERROR_UNKNOWN_HOST, "https://shop.example.it/")
+            typed("http://www.example.it")
+            fallback.onLoadError(engineSession, ErrorType.ERROR_UNKNOWN_HOST, "https://www.example.it/")
+            advanceTimeBy(5000)
+            runCurrent()
+
+            assertTrue(resolvedHosts.isEmpty())
+            verifyNothingLoaded()
+        }
+
+    @Test
+    fun `WHEN the address with www fails too THEN it isn't tried again`() =
+        runTest(testDispatcher) {
+            typed("http://example.it")
+            fallback.onLoadError(engineSession, ErrorType.ERROR_UNKNOWN_HOST, "https://example.it/")
+            showErrorPage("https://example.it/")
+            typed("http://www.example.it")
+            fallback.onLoadError(engineSession, ErrorType.ERROR_UNKNOWN_HOST, "https://www.example.it/")
+            advanceTimeBy(5000)
+            runCurrent()
+
+            verify(exactly = 1) { engineSession.loadUrl(any(), any(), any(), any(), any(), any()) }
+        }
+
+    @Test
+    fun `WHEN making the address with www THEN only websites without www get it`() {
+        assertEquals("http://www.example.it", wwwAlternativeUrl("http://example.it"))
+        assertEquals("https://www.Example.IT/a/b?c=d#e", wwwAlternativeUrl("https://Example.IT/a/b?c=d#e"))
+        assertNull(wwwAlternativeUrl("http://www.example.it/"))
+        assertNull(wwwAlternativeUrl("http://WWW.example.it/"))
+        assertNull(wwwAlternativeUrl("http://example.it:8080/"))
+        assertNull(wwwAlternativeUrl("http://user@example.it/"))
+        assertNull(wwwAlternativeUrl("http://192.168.1.1/"))
+        assertNull(wwwAlternativeUrl("http://[::1]/"))
+        assertNull(wwwAlternativeUrl("http://localhost/"))
+        assertNull(wwwAlternativeUrl("ftp://example.it/"))
+        assertNull(wwwAlternativeUrl("about:blank"))
+        assertNull(wwwAlternativeUrl("not a url"))
+    }
+
+    @Test
+    fun `GIVEN the patch of the feature is applied THEN the feature gets the page loads`() {
+        assertTrue(WwwFallbackFeature in PatchFeatureHooks.all)
+    }
+}
