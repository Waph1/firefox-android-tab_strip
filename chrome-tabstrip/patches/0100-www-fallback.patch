+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.MainScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import mozilla.components.concept.engine.EngineSession
+import mozilla.components.concept.engine.EngineSession.LoadUrlFlags
+import mozilla.components.concept.engine.request.ErrorType
+import org.mozilla.fenix.HomeActivity
+import org.mozilla.fenix.ext.components
+import java.net.InetAddress
+import java.net.URI
+import java.net.URISyntaxException
+import java.net.UnknownHostException
+import java.util.WeakHashMap
+
+private const val WWW_PREFIX = "www."
+private const val SCHEME_SEPARATOR = "://"
+
+// How long the address with "www." waits for the error page of the one without it, see [WwwFallback].
+private const val ERROR_PAGE_TIMEOUT_MS = 3000L
+
+private val ipv4Host = Regex("""[0-9.]+""")
+
+/**
+ * The errors after which the address with "www." is tried: the site doesn't answer without "www.", or not securely
+ * (e.g. its certificate is only valid for the address with "www.").
+ */
+internal val WWW_FALLBACK_ERRORS =
+    setOf(
+        ErrorType.ERROR_UNKNOWN_HOST,
+        ErrorType.ERROR_CONNECTION_REFUSED,
+        ErrorType.ERROR_NET_TIMEOUT,
+        ErrorType.ERROR_NET_RESET,
+        ErrorType.ERROR_NET_INTERRUPT,
+        ErrorType.ERROR_SECURITY_BAD_CERT,
+        ErrorType.ERROR_SECURITY_SSL,
+        ErrorType.ERROR_HTTPS_ONLY,
+    )
+
+/**
+ * Optional feature "addresses without www." (`0100-www-fallback.patch`): when an address typed in the address bar
+ * (or opened from a bookmark, the history, another app...) doesn't load because the site only answers with "www."
+ * before its domain (e.g. `example.it` doesn't exist, `www.example.it` does), Firefox loads the address with "www."
+ * in its place. The links of the pages are left as they are. (By itself, Gecko only tries the address with "www."
+ * when the certificate of the site is valid for it.)
+ */
+object WwwFallbackFeature : PatchFeatureHooks {
+    private var fallback: WwwFallback? = null
+
+    override fun onActivityCreated(activity: HomeActivity) {
+        if (fallback != null) return
+        val publicSuffixList = activity.components.publicSuffixList
+        fallback = WwwFallback(registrableDomain = { host -> publicSuffixList.getPublicSuffixPlusOne(host).await() })
+    }
+
+    override fun onLoadRequest(
+        engineSession: EngineSession,
+        uri: String,
+        hasUserGesture: Boolean,
+        isRedirect: Boolean,
+        isDirectNavigation: Boolean,
+        isSubframeRequest: Boolean,
+    ) {
+        fallback?.onLoadRequest(engineSession, uri, hasUserGesture, isDirectNavigation, isSubframeRequest)
+    }
+
+    override fun onLoadError(
+        engineSession: EngineSession,
+        errorType: ErrorType,
+        uri: String?,
+    ) {
+        fallback?.onLoadError(engineSession, errorType, uri)
+    }
+}
+
+/**
+ * Loads the address with "www." in place of an address without it that Firefox asked to load (not a link of a
+ * page) and that failed with one of [WWW_FALLBACK_ERRORS], if the site has an address with "www.".
+ *
+ * The error page of the address without "www." is shown until the other address starts loading, which then takes its
+ * place in the history of the tab. Each address is tried with "www." only once: if that fails too, its error page
+ * stays.
+ *
+ * @param registrableDomain Returns the domain that can be registered of a host (e.g. `example.co.uk` for
+ *   `shop.example.co.uk`), or `null` if it isn't known: only those domains get "www.", not their subdomains.
+ * @param hostResolves Whether a host exists, i.e. its address can be found in the DNS.
+ * @param scope [CoroutineScope] of the main thread, where the engine sessions are used.
+ * @param errorPageTimeoutMs How long to wait for the error page before loading the address with "www." anyway (then
+ *   it doesn't take the place of the error page in the history).
+ */
+internal class WwwFallback(
+    private val registrableDomain: suspend (host: String) -> String?,
+    private val hostResolves: suspend (host: String) -> Boolean = ::resolvesWithDns,
+    private val scope: CoroutineScope = MainScope(),
+    private val errorPageTimeoutMs: Long = ERROR_PAGE_TIMEOUT_MS,
+) {
+    // The address of the last page that Firefox asked each engine session to load, until another page is loaded.
+    private val requestedUrls = WeakHashMap<EngineSession, String>()
+
+    // The address with "www." that each engine session is about to load.
+    private val retries = WeakHashMap<EngineSession, Retry>()
+
+    /** See [PatchFeatureHooks.onLoadRequest]. */
+    fun onLoadRequest(
+        engineSession: EngineSession,
+        uri: String,
+        hasUserGesture: Boolean,
+        isDirectNavigation: Boolean,
+        isSubframeRequest: Boolean,
+    ) {
+        if (isSubframeRequest) return
+
+        // Another page was asked for: the address with "www." isn't wanted anymore.
+        if (isDirectNavigation || hasUserGesture) {
+            retries.remove(engineSession)?.cancel()
+        }
+
+        // The redirects and the reloads of the same site without the user (e.g. when HTTPS-First goes back to HTTP)
+        // are part of the same request, a link isn't.
+        val requestedUrl = requestedUrls[engineSession]
+        when {
+            isDirectNavigation -> requestedUrls[engineSession] = uri
+            hasUserGesture || requestedUrl == null || hostOf(uri) != hostOf(requestedUrl) ->
+                requestedUrls.remove(engineSession)
+        }
+    }
+
+    /** See [PatchFeatureHooks.onLoadError]. */
+    fun onLoadError(
+        engineSession: EngineSession,
+        errorType: ErrorType,
+        uri: String?,
+    ) {
+        if (errorType !in WWW_FALLBACK_ERRORS) return
+        val requestedUrl = requestedUrls[engineSession] ?: return
+        val host = hostOf(requestedUrl) ?: return
+        if (uri == null || hostOf(uri) != host) return
+
+        requestedUrls.remove(engineSession)
+        retries.remove(engineSession)?.cancel()
+        val retry = Retry(engineSession, requestedUrl, host)
+        retries[engineSession] = retry
+        retry.start()
+    }
+
+    private suspend fun checkedAlternativeUrl(
+        requestedUrl: String,
+        host: String,
+    ): String? {
+        val url = wwwAlternativeUrl(requestedUrl) ?: return null
+        if (registrableDomain(host) != host) return null
+        return if (hostResolves(WWW_PREFIX + host)) url else null
+    }
+
+    /** Loads the address with "www." for [requestedUrl], which failed, once its error page is shown. */
+    private inner class Retry(
+        private val engineSession: EngineSession,
+        private val requestedUrl: String,
+        private val host: String,
+    ) : EngineSession.Observer {
+        private var alternativeUrl: String? = null
+        private var isErrorPageShown = false
+        private var isFinished = false
+        private var job: Job? = null
+
+        fun start() {
+            engineSession.register(this)
+            job =
+                scope.launch {
+                    val url = checkedAlternativeUrl(requestedUrl, host)
+                    if (url == null) {
+                        finish()
+                        return@launch
+                    }
+                    alternativeUrl = url
+                    if (!isErrorPageShown) {
+                        // Normally the error page is shown first.
+                        delay(errorPageTimeoutMs)
+                    }
+                    load()
+                }
+        }
+
+        // The error page shows the address that failed.
+        override fun onLocationChange(
+            url: String,
+            hasUserGesture: Boolean,
+        ) {
+            if (isFinished || isErrorPageShown || hostOf(url) != host) return
+            isErrorPageShown = true
+            if (alternativeUrl != null) {
+                job?.cancel()
+                // Not while the engine session tells its observers about the page.
+                job = scope.launch { load() }
+            }
+        }
+
+        fun cancel() {
+            job?.cancel()
+            finish()
+        }
+
+        private fun load() {
+            val url = alternativeUrl
+            if (isFinished || url == null) return
+            val flags =
+                if (isErrorPageShown) {
+                    LoadUrlFlags.select(LoadUrlFlags.LOAD_FLAGS_REPLACE_HISTORY)
+                } else {
+                    LoadUrlFlags.none()
+                }
+            finish()
+            engineSession.loadUrl(url, flags = flags)
+        }
+
+        private fun finish() {
+            isFinished = true
+            engineSession.unregister(this)
+            if (retries[engineSession] === this) {
+                retries.remove(engineSession)
+            }
+        }
+    }
+}
+
+/**
+ * The address [url] with "www." before its domain, or `null` if it isn't the address of a website without "www." (e.g.
+ * it has a port, an IP address, or already "www.").
+ */
+internal fun wwwAlternativeUrl(url: String): String? {
+    val uri = parseUri(url) ?: return null
+    val scheme = uri.scheme?.lowercase()
+    val host = hostOf(uri)
+    val isWebsite = (scheme == "http" || scheme == "https") && uri.rawUserInfo == null && uri.port == -1
+    if (!isWebsite || host == null || host.startsWith(WWW_PREFIX)) return null
+    if ('.' !in host || host.endsWith('.') || host.startsWith('[') || ipv4Host.matches(host)) return null
+    val authorityStart = url.indexOf(SCHEME_SEPARATOR) + SCHEME_SEPARATOR.length
+    return url.substring(0, authorityStart) + WWW_PREFIX + url.substring(authorityStart)
+}
+
+private fun hostOf(url: String): String? = parseUri(url)?.let(::hostOf)
+
+private fun hostOf(uri: URI): String? = uri.host?.lowercase()
+
+private fun parseUri(url: String): URI? =
+    try {
+        URI(url)
+    } catch (e: URISyntaxException) {
+        null
+    }
+
+private suspend fun resolvesWithDns(host: String): Boolean =
+    withContext(Dispatchers.IO) {
+        try {
+            InetAddress.getAllByName(host).isNotEmpty()
+        } catch (e: UnknownHostException) {
+            false
+        } catch (e: SecurityException) {
+            false
+        }
+    }
