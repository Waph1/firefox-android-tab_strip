+
+package org.mozilla.fenix.patchfeatures
+
+import androidx.compose.ui.unit.IntOffset
+import androidx.compose.ui.unit.IntRect
+import androidx.compose.ui.unit.IntSize
+import java.net.URI
+import java.net.URISyntaxException
+import kotlin.math.abs
+
+/**
+ * Returns how many steps the tab strip scrolls for a scroll of the mouse wheel or of the trackpad: the tabs scroll
+ * horizontally with the vertical wheel too, along the axis that scrolled the most.
+ *
+ * @param deltaX The horizontal scroll, in steps of the wheel (positive to the right).
+ * @param deltaY The vertical scroll, in steps of the wheel (positive downwards).
+ */
+internal fun tabStripWheelScroll(
+    deltaX: Float,
+    deltaY: Float,
+): Float = if (abs(deltaY) >= abs(deltaX)) deltaY else deltaX
+
+/**
+ * Returns where the tooltip of a tab goes: centered under the tab, or above it if it doesn't fit under it (e.g. with
+ * the tab strip at the bottom), and inside the window.
+ *
+ * @param tabBounds Where the tab is in the window.
+ * @param windowSize The size of the window.
+ * @param tooltipSize The size of the tooltip.
+ * @param margin The space between the tab and the tooltip.
+ */
+internal fun tabTooltipPosition(
+    tabBounds: IntRect,
+    windowSize: IntSize,
+    tooltipSize: IntSize,
+    margin: Int,
+): IntOffset {
+    val maxX = (windowSize.width - tooltipSize.width).coerceAtLeast(0)
+    val x = (tabBounds.left + (tabBounds.width - tooltipSize.width) / 2).coerceIn(0, maxX)
+    val below = tabBounds.bottom + margin
+    val y =
+        if (below + tooltipSize.height <= windowSize.height) {
+            below
+        } else {
+            (tabBounds.top - margin - tooltipSize.height).coerceAtLeast(0)
+        }
+    return IntOffset(x, y)
+}
+
+/** The site shown in the tooltip of a tab with [url]: its host without "www.", or the address if it has no host. */
+internal fun tabTooltipSite(url: String): String {
+    val host =
+        try {
+            URI(url).host
+        } catch (e: URISyntaxException) {
+            null
+        }
+    return host?.removePrefix("www.") ?: url
+}
