+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import androidx.compose.ui.unit.IntOffset
+import androidx.compose.ui.unit.IntRect
+import androidx.compose.ui.unit.IntSize
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class MouseTest {
+    @Test
+    fun `WHEN scrolling the tab strip THEN it follows the axis that scrolled the most`() {
+        // The vertical wheel scrolls the tabs too.
+        assertEquals(1f, tabStripWheelScroll(deltaX = 0f, deltaY = 1f))
+        assertEquals(-2f, tabStripWheelScroll(deltaX = 0f, deltaY = -2f))
+        assertEquals(1.5f, tabStripWheelScroll(deltaX = 1.5f, deltaY = 0.5f))
+        assertEquals(0f, tabStripWheelScroll(deltaX = 0f, deltaY = 0f))
+    }
+
+    @Test
+    fun `WHEN placing the tooltip of a tab THEN it is centered under the tab, inside the window`() {
+        val window = IntSize(1000, 800)
+        val tooltip = IntSize(200, 50)
+
+        assertEquals(IntOffset(250, 44), tabTooltipPosition(IntRect(300, 0, 400, 40), window, tooltip, margin = 4))
+        // Near the edges of the window.
+        assertEquals(IntOffset(0, 44), tabTooltipPosition(IntRect(0, 0, 100, 40), window, tooltip, margin = 4))
+        assertEquals(IntOffset(800, 44), tabTooltipPosition(IntRect(900, 0, 1000, 40), window, tooltip, margin = 4))
+    }
+
+    @Test
+    fun `GIVEN a tab at the bottom WHEN placing its tooltip THEN it is above the tab`() {
+        val position = tabTooltipPosition(IntRect(300, 760, 400, 800), IntSize(1000, 800), IntSize(200, 50), margin = 4)
+
+        assertEquals(IntOffset(250, 706), position)
+    }
+
+    @Test
+    fun `WHEN showing the site of a tab THEN it is its host without www`() {
+        assertEquals("example.com", tabTooltipSite("https://www.example.com/page"))
+        assertEquals("mozilla.org", tabTooltipSite("https://mozilla.org"))
+        assertEquals("about:home", tabTooltipSite("about:home"))
+        assertEquals("not a url", tabTooltipSite("not a url"))
+    }
+}
