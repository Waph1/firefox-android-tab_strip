index 00000000..802815b9
--- /dev/null
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/patchfeatures/PageZoom.kt
@@ -0,0 +1,105 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import android.view.KeyEvent
+import java.net.MalformedURLException
+import java.net.URL
+import java.util.Locale
+
+/** The zoom levels of the pages, in percent, like in Firefox for desktop. */
+internal val PAGE_ZOOM_LEVELS = listOf(30, 50, 67, 80, 90, 100, 110, 120, 133, 150, 170, 200, 240, 300)
+
+/** The zoom of the pages that aren't zoomed, in percent. */
+internal const val NO_PAGE_ZOOM = 100
+
+/** Returns the next zoom level after [zoom], or the last one. */
+internal fun zoomedIn(zoom: Int): Int = PAGE_ZOOM_LEVELS.firstOrNull { it > zoom } ?: PAGE_ZOOM_LEVELS.last()
+
+/** Returns the zoom level before [zoom], or the first one. */
+internal fun zoomedOut(zoom: Int): Int = PAGE_ZOOM_LEVELS.lastOrNull { it < zoom } ?: PAGE_ZOOM_LEVELS.first()
+
+/**
+ * Returns the site of [url] whose zoom is remembered (its host, like the content script of the extension), or `null`
+ * for the pages that can't be zoomed (e.g. the internal pages of Firefox).
+ */
+internal fun zoomSite(url: String): String? =
+    try {
+        URL(url).takeIf { it.protocol == "http" || it.protocol == "https" }?.host?.lowercase(Locale.ROOT)
+    } catch (e: MalformedURLException) {
+        null
+    }
+
+/**
+ * The zoom of the pages.
+ *
+ * @property isEnabled Whether the pages are zoomed: only on large screens (the ones showing the tab strip).
+ * @property defaultZoom The zoom of the sites without a zoom of their own, in percent.
+ * @property sites The zoom of the sites zoomed by the user, in percent, by site (see [zoomSite]).
+ * @property privateSites The zoom of the sites zoomed by the user in private tabs, which isn't saved.
+ */
+internal data class PageZoomState(
+    val isEnabled: Boolean = false,
+    val defaultZoom: Int = NO_PAGE_ZOOM,
+    val sites: Map<String, Int> = emptyMap(),
+    val privateSites: Map<String, Int> = emptyMap(),
+) {
+    /** The zoom of the site of [url] when the screen is large, in percent (ignores [isEnabled]). */
+    fun siteZoom(
+        url: String,
+        isPrivate: Boolean,
+    ): Int {
+        val site = zoomSite(url) ?: return NO_PAGE_ZOOM
+        return (if (isPrivate) privateSites else sites)[site] ?: defaultZoom
+    }
+
+    /**
+     * Returns the state with the zoom of the site of [url] set to [zoom]. The site forgets its zoom when it's the
+     * default one.
+     */
+    fun withSiteZoom(
+        url: String,
+        isPrivate: Boolean,
+        zoom: Int,
+    ): PageZoomState {
+        val site = zoomSite(url) ?: return this
+        val zooms = (if (isPrivate) privateSites else sites).toMutableMap()
+        if (zoom == defaultZoom) zooms.remove(site) else zooms[site] = zoom
+        return if (isPrivate) copy(privateSites = zooms) else copy(sites = zooms)
+    }
+}
+
+/** A change of the zoom asked with the keyboard, like in Firefox for desktop. */
+internal enum class PageZoomShortcut {
+    /** Ctrl and +, or Ctrl and =. */
+    ZOOM_IN,
+
+    /** Ctrl and -. */
+    ZOOM_OUT,
+
+    /** Ctrl and 0: back to the default zoom. */
+    RESET,
+}
+
+/**
+ * Returns the zoom shortcut of a key pressed with the given modifiers, or `null` if it isn't one. Shift is allowed,
+ * since + needs it on some layouts.
+ *
+ * @param keyCode The key, see [KeyEvent.getKeyCode].
+ * @param metaState The modifiers, see [KeyEvent.getMetaState].
+ */
+internal fun pageZoomShortcut(
+    keyCode: Int,
+    metaState: Int,
+): PageZoomShortcut? {
+    val otherModifiers = KeyEvent.META_ALT_ON or KeyEvent.META_META_ON
+    if ((metaState and KeyEvent.META_CTRL_ON) == 0 || (metaState and otherModifiers) != 0) return null
+    return when (keyCode) {
+        KeyEvent.KEYCODE_PLUS, KeyEvent.KEYCODE_EQUALS, KeyEvent.KEYCODE_NUMPAD_ADD -> PageZoomShortcut.ZOOM_IN
+        KeyEvent.KEYCODE_MINUS, KeyEvent.KEYCODE_NUMPAD_SUBTRACT -> PageZoomShortcut.ZOOM_OUT
+        KeyEvent.KEYCODE_0, KeyEvent.KEYCODE_NUMPAD_0 -> PageZoomShortcut.RESET
+        else -> null
+    }
+}
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/patchfeatures/PageZoomFeature.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/patchfeatures/PageZoomFeature.kt
