+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+// Whether this script zoomed the page: at 100% it only removes its own zoom, not one set by the page.
+let isZoomed = false;
+
+/**
+ * Zooms the page with the CSS zoom property of its root element, which lays it out again like the zoom of Firefox
+ * for desktop.
+ */
+function applyZoom(zoom) {
+  const root = document.documentElement;
+  if (!root) {
+    // Very early in the load: try again once the root element exists.
+    document.addEventListener("readystatechange", () => applyZoom(zoom), { once: true });
+    return;
+  }
+  if (zoom === 100) {
+    if (isZoomed) {
+      root.style.removeProperty("zoom");
+      isZoomed = false;
+    }
+  } else {
+    root.style.setProperty("zoom", String(zoom / 100), "important");
+    isZoomed = true;
+  }
+}
+
+browser.runtime.onMessage.addListener(message => {
+  if (message.type === "zoom") {
+    applyZoom(message.zoom);
+  }
+});
+
+browser.runtime.sendMessage({ type: "getZoom" }).then(zoom => {
+  if (typeof zoom === "number") {
+    applyZoom(zoom);
+  }
+});
