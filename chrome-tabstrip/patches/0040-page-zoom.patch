+++ b/mobile/android/fenix/app/src/main/assets/extensions/chrome-tabstrip-zoom/background.js
@@ -0,0 +1,55 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+// The zooms of the pages, sent by the app (see PageZoomFeature.kt). The pages aren't zoomed until it sends them.
+let state = { enabled: false, defaultZoom: 100, sites: {}, privateSites: {} };
+
+/** Returns the zoom of a page, in percent, like PageZoomState.siteZoom in the app. */
+function zoomFor(url, isPrivate) {
+  if (!state.enabled || !url) {
+    return 100;
+  }
+  let site;
+  try {
+    const parsed = new URL(url);
+    if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
+      return 100;
+    }
+    site = parsed.hostname.toLowerCase();
+  } catch (e) {
+    return 100;
+  }
+  const zooms = isPrivate ? state.privateSites : state.sites;
+  return zooms[site] ?? state.defaultZoom;
+}
+
+/** Sends its zoom to every open page. */
+async function updateAllTabs() {
+  const tabs = await browser.tabs.query({});
+  for (const tab of tabs) {
+    browser.tabs
+      .sendMessage(tab.id, { type: "zoom", zoom: zoomFor(tab.url, tab.incognito) })
+      .catch(() => {
+        // The page has no content script, e.g. an internal page of Firefox.
+      });
+  }
+}
+
+const port = browser.runtime.connectNative("chromeTabstripZoom");
+port.onMessage.addListener(message => {
+  if (message.type === "state") {
+    state = message;
+    updateAllTabs();
+  }
+});
+
+// The content script of a page asks for its zoom while the page loads.
+browser.runtime.onMessage.addListener((message, sender) => {
+  if (message.type === "getZoom" && sender.tab) {
+    return Promise.resolve(zoomFor(sender.url || sender.tab.url, sender.tab.incognito));
+  }
+  return undefined;
+});
