+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import android.view.KeyEvent
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+private const val CTRL = KeyEvent.META_CTRL_ON or KeyEvent.META_CTRL_LEFT_ON
+
+class PageZoomTest {
+    @Test
+    fun `WHEN zooming in or out THEN the zoom goes to the next level, like in Firefox for desktop`() {
+        assertEquals(110, zoomedIn(100))
+        assertEquals(133, zoomedIn(120))
+        assertEquals(300, zoomedIn(300))
+        assertEquals(90, zoomedOut(100))
+        assertEquals(30, zoomedOut(30))
+        // A zoom between two levels.
+        assertEquals(110, zoomedIn(105))
+        assertEquals(100, zoomedOut(105))
+    }
+
+    @Test
+    fun `WHEN getting the site of a page THEN it is its host, only for web pages`() {
+        assertEquals("example.com", zoomSite("https://Example.com/path?query"))
+        assertEquals("www.example.com", zoomSite("http://www.example.com:8080/"))
+        assertNull(zoomSite("about:home"))
+        assertNull(zoomSite("file:///sdcard/page.html"))
+        assertNull(zoomSite("not a url"))
+    }
+
+    @Test
+    fun `GIVEN zoomed sites WHEN getting the zoom of a page THEN it is the one of its site, or the default one`() {
+        val state =
+            PageZoomState(
+                isEnabled = true,
+                defaultZoom = 110,
+                sites = mapOf("example.com" to 150),
+                privateSites = mapOf("example.org" to 80),
+            )
+
+        assertEquals(150, state.siteZoom("https://example.com/a", isPrivate = false))
+        assertEquals(110, state.siteZoom("https://example.org/a", isPrivate = false))
+        assertEquals(80, state.siteZoom("https://example.org/a", isPrivate = true))
+        // The zooms of the normal tabs don't apply to the private ones.
+        assertEquals(110, state.siteZoom("https://example.com/a", isPrivate = true))
+        assertEquals(100, state.siteZoom("about:home", isPrivate = false))
+    }
+
+    @Test
+    fun `WHEN the zoom of a site changes THEN it is remembered, unless it is the default one`() {
+        val state = PageZoomState(isEnabled = true, defaultZoom = 100)
+
+        val zoomed = state.withSiteZoom("https://example.com/a", isPrivate = false, zoom = 120)
+        assertEquals(mapOf("example.com" to 120), zoomed.sites)
+
+        val zoomedPrivately = zoomed.withSiteZoom("https://example.org/", isPrivate = true, zoom = 90)
+        assertEquals(mapOf("example.com" to 120), zoomedPrivately.sites)
+        assertEquals(mapOf("example.org" to 90), zoomedPrivately.privateSites)
+
+        val reset = zoomedPrivately.withSiteZoom("https://example.com/b", isPrivate = false, zoom = 100)
+        assertTrue(reset.sites.isEmpty())
+
+        assertEquals(state, state.withSiteZoom("about:home", isPrivate = false, zoom = 120))
+    }
+
+    @Test
+    fun `WHEN keys are pressed with Ctrl THEN they change the zoom like in Firefox for desktop`() {
+        assertEquals(PageZoomShortcut.ZOOM_IN, pageZoomShortcut(KeyEvent.KEYCODE_PLUS, CTRL))
+        // Ctrl and Shift and = is Ctrl and + on some layouts.
+        val ctrlShift = CTRL or KeyEvent.META_SHIFT_ON
+        assertEquals(PageZoomShortcut.ZOOM_IN, pageZoomShortcut(KeyEvent.KEYCODE_EQUALS, ctrlShift))
+        assertEquals(PageZoomShortcut.ZOOM_IN, pageZoomShortcut(KeyEvent.KEYCODE_NUMPAD_ADD, CTRL))
+        assertEquals(PageZoomShortcut.ZOOM_OUT, pageZoomShortcut(KeyEvent.KEYCODE_MINUS, CTRL))
+        assertEquals(PageZoomShortcut.ZOOM_OUT, pageZoomShortcut(KeyEvent.KEYCODE_NUMPAD_SUBTRACT, CTRL))
+        assertEquals(PageZoomShortcut.RESET, pageZoomShortcut(KeyEvent.KEYCODE_0, CTRL))
+        assertNull(pageZoomShortcut(KeyEvent.KEYCODE_PLUS, 0))
+        assertNull(pageZoomShortcut(KeyEvent.KEYCODE_PLUS, CTRL or KeyEvent.META_ALT_ON))
+        assertNull(pageZoomShortcut(KeyEvent.KEYCODE_1, CTRL))
+    }
+
+    @Test
+    fun `GIVEN the patch of the feature is applied THEN the feature zooms the pages`() {
+        assertTrue(PageZoomFeature in PatchFeatureHooks.all)
+    }
+}
