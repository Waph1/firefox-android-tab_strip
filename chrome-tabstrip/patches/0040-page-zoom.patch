@@ -0,0 +1,307 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.view.KeyEvent
+import android.widget.Toast
+import androidx.compose.foundation.layout.Row
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.res.painterResource
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.semantics.contentDescription
+import androidx.compose.ui.semantics.semantics
+import androidx.core.content.edit
+import androidx.navigation.findNavController
+import androidx.preference.ListPreference
+import androidx.preference.Preference
+import androidx.preference.PreferenceCategory
+import androidx.preference.PreferenceFragmentCompat
+import kotlinx.coroutines.MainScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.launch
+import mozilla.components.browser.state.selector.privateTabs
+import mozilla.components.browser.state.selector.selectedTab
+import mozilla.components.concept.engine.webextension.MessageHandler
+import mozilla.components.concept.engine.webextension.Port
+import mozilla.components.support.base.log.logger.Logger
+import mozilla.components.ui.icons.R as iconsR
+import org.json.JSONObject
+import org.mozilla.fenix.HomeActivity
+import org.mozilla.fenix.R
+import org.mozilla.fenix.browser.tabstrip.AdaptiveTabStrip
+import org.mozilla.fenix.components.menu.MenuAccessPoint
+import org.mozilla.fenix.components.menu.compose.MenuGroup
+import org.mozilla.fenix.components.menu.compose.MenuItem
+import org.mozilla.fenix.ext.components
+
+private const val EXTENSION_ID = "page-zoom@chrome-tabstrip"
+private const val EXTENSION_URL = "resource://android/assets/extensions/chrome-tabstrip-zoom/"
+private const val NATIVE_APP = "chromeTabstripZoom"
+
+private const val PREFERENCES_NAME = "chrome_tabstrip_page_zoom"
+private const val PREF_DEFAULT_ZOOM = "default_zoom"
+private const val PREF_SITE_PREFIX = "site:"
+
+/**
+ * Optional feature "page zoom" (`0040-page-zoom.patch`): on large screens (the ones showing the tab strip) the pages
+ * are zoomed like in Firefox for desktop, with a default zoom and a zoom remembered for each site (not in private
+ * tabs).
+ *
+ * GeckoView doesn't offer the full page zoom of Firefox for desktop, so a built-in extension (in
+ * `assets/extensions/chrome-tabstrip-zoom`) applies the CSS `zoom` property to the pages, which lays them out again
+ * like the zoom of the desktop. The app keeps the zooms and sends them to the extension (see [PageZoomState]).
+ *
+ * The zoom is changed from the main menu (Zoom − 100% +) or with Ctrl + / - / 0, and the default zoom in Settings →
+ * Customize. On small screens the pages aren't zoomed, and are zoomed again when the screen is large again.
+ */
+object PageZoomFeature : PatchFeatureHooks {
+    private val logger = Logger("PageZoomFeature")
+    private val scope = MainScope()
+    private val state = MutableStateFlow(PageZoomState())
+
+    /** The page of the selected tab: its url, and whether the tab is private. Followed once the feature starts. */
+    private val selectedPage = MutableStateFlow<Pair<String, Boolean>?>(null)
+    private var preferences: SharedPreferences? = null
+    private var port: Port? = null
+    private var toast: Toast? = null
+
+    private val messageHandler =
+        object : MessageHandler {
+            override fun onPortConnected(port: Port) {
+                this@PageZoomFeature.port = port
+                send(state.value)
+            }
+
+            override fun onPortDisconnected(port: Port) {
+                if (this@PageZoomFeature.port === port) this@PageZoomFeature.port = null
+            }
+        }
+
+    override fun onActivityCreated(activity: HomeActivity) {
+        if (preferences != null) return
+        val preferences = activity.applicationContext.getSharedPreferences(PREFERENCES_NAME, Context.MODE_PRIVATE)
+        this.preferences = preferences
+        state.value = loadState(preferences)
+
+        val components = activity.components
+        components.core.engine.installBuiltInWebExtension(
+            id = EXTENSION_ID,
+            url = EXTENSION_URL,
+            onSuccess = { it.registerBackgroundMessageHandler(NATIVE_APP, messageHandler) },
+            onError = { logger.error("Can't install the page zoom extension", it) },
+        )
+
+        scope.launch { state.collect { send(it) } }
+        scope.launch {
+            AdaptiveTabStrip.isLargeWindow.collect { isLarge -> update { it.copy(isEnabled = isLarge == true) } }
+        }
+        scope.launch {
+            components.core.store.stateFlow
+                .map { browserState -> browserState.selectedTab?.let { it.content.url to it.content.private } }
+                .distinctUntilChanged()
+                .collect { selectedPage.value = it }
+        }
+        // Like the private tabs, their zooms are forgotten once they are all closed.
+        scope.launch {
+            components.core.store.stateFlow
+                .map { it.privateTabs.isEmpty() }
+                .distinctUntilChanged()
+                .collect { noPrivateTabs -> if (noPrivateTabs) update { it.copy(privateSites = emptyMap()) } }
+        }
+    }
+
+    override fun onKeyEvent(
+        activity: HomeActivity,
+        event: KeyEvent,
+    ): Boolean {
+        val shortcut = pageZoomShortcut(event.keyCode, event.metaState) ?: return false
+        if (AdaptiveTabStrip.isLargeWindow.value != true) return false
+        val navController = runCatching { activity.findNavController(R.id.container) }.getOrNull() ?: return false
+        if (navController.currentDestination?.id != R.id.browserFragment) return false
+        if (event.action == KeyEvent.ACTION_DOWN) {
+            val zoom = changeZoom(shortcut) ?: return true
+            // There is no zoom indicator in the address bar: tell the new zoom.
+            toast?.cancel()
+            toast = Toast.makeText(activity, activity.getString(R.string.page_zoom_toast, zoom), Toast.LENGTH_SHORT)
+            toast?.show()
+        }
+        return true
+    }
+
+    @Composable
+    override fun MainMenuItems(accessPoint: MenuAccessPoint) {
+        val isLargeWindow by AdaptiveTabStrip.isLargeWindow.collectAsState()
+        val zoomState by state.collectAsState()
+        val page by selectedPage.collectAsState()
+        val (url, isPrivate) = page ?: return
+        if (accessPoint != MenuAccessPoint.Browser || isLargeWindow != true || zoomSite(url) == null) return
+        val zoom = zoomState.siteZoom(url, isPrivate)
+
+        MenuGroup {
+            MenuItem(
+                label = stringResource(R.string.page_zoom_menu_item),
+                beforeIconPainter = painterResource(iconsR.drawable.mozac_ic_search_24),
+                afterContent = {
+                    PageZoomControls(
+                        zoom = zoom,
+                        defaultZoom = zoomState.defaultZoom,
+                        onZoomOut = { changeZoom(PageZoomShortcut.ZOOM_OUT) },
+                        onReset = { changeZoom(PageZoomShortcut.RESET) },
+                        onZoomIn = { changeZoom(PageZoomShortcut.ZOOM_IN) },
+                    )
+                },
+            )
+        }
+    }
+
+    override fun addCustomizationPreferences(fragment: PreferenceFragmentCompat) {
+        val context = fragment.requireContext()
+        val category =
+            PreferenceCategory(context).apply {
+                title = context.getString(R.string.page_zoom_preferences_category)
+                isIconSpaceReserved = false
+            }
+        fragment.preferenceScreen.addPreference(category)
+
+        val levels = PAGE_ZOOM_LEVELS.map { it.toString() }.toTypedArray()
+        category.addPreference(
+            ListPreference(context).apply {
+                isPersistent = false
+                isIconSpaceReserved = false
+                title = context.getString(R.string.page_zoom_default_title)
+                dialogTitle = title
+                entries = PAGE_ZOOM_LEVELS.map { context.getString(R.string.page_zoom_percent, it) }.toTypedArray()
+                entryValues = levels
+                value = state.value.defaultZoom.toString()
+                summary = context.getString(R.string.page_zoom_percent, state.value.defaultZoom)
+                setOnPreferenceChangeListener { preference, newValue ->
+                    val zoom = (newValue as String).toInt()
+                    update { it.copy(defaultZoom = zoom) }
+                    preference.summary = context.getString(R.string.page_zoom_percent, zoom)
+                    true
+                }
+            },
+        )
+
+        category.addPreference(
+            Preference(context).apply {
+                isIconSpaceReserved = false
+                title = context.getString(R.string.page_zoom_reset_sites_title)
+                summary = context.getString(R.string.page_zoom_reset_sites_summary, state.value.sites.size)
+                setOnPreferenceClickListener { preference ->
+                    update { it.copy(sites = emptyMap(), privateSites = emptyMap()) }
+                    preference.summary = context.getString(R.string.page_zoom_reset_sites_summary, 0)
+                    Toast.makeText(context, R.string.page_zoom_sites_reset, Toast.LENGTH_SHORT).show()
+                    true
+                }
+            },
+        )
+    }
+
+    /** Changes the zoom of the site of the selected tab, and returns the new zoom (`null` if it can't be zoomed). */
+    private fun changeZoom(shortcut: PageZoomShortcut): Int? {
+        val (url, isPrivate) = selectedPage.value ?: return null
+        if (zoomSite(url) == null) return null
+        val current = state.value
+        val zoom =
+            when (shortcut) {
+                PageZoomShortcut.ZOOM_IN -> zoomedIn(current.siteZoom(url, isPrivate))
+                PageZoomShortcut.ZOOM_OUT -> zoomedOut(current.siteZoom(url, isPrivate))
+                PageZoomShortcut.RESET -> current.defaultZoom
+            }
+        update { it.withSiteZoom(url, isPrivate, zoom) }
+        return zoom
+    }
+
+    private fun update(change: (PageZoomState) -> PageZoomState) {
+        val old = state.value
+        val new = change(old)
+        if (new == old) return
+        state.value = new
+        if (new.defaultZoom != old.defaultZoom || new.sites != old.sites) {
+            preferences?.let { saveState(it, new) }
+        }
+    }
+
+    private fun send(state: PageZoomState) {
+        port?.postMessage(
+            JSONObject()
+                .put("type", "state")
+                .put("enabled", state.isEnabled)
+                .put("defaultZoom", state.defaultZoom)
+                .put("sites", JSONObject(state.sites))
+                .put("privateSites", JSONObject(state.privateSites)),
+        )
+    }
+
+    private fun loadState(preferences: SharedPreferences) =
+        PageZoomState(
+            defaultZoom = preferences.getInt(PREF_DEFAULT_ZOOM, NO_PAGE_ZOOM),
+            sites =
+                preferences.all
+                    .filterKeys { it.startsWith(PREF_SITE_PREFIX) }
+                    .mapNotNull { (key, value) -> (value as? Int)?.let { key.removePrefix(PREF_SITE_PREFIX) to it } }
+                    .toMap(),
+        )
+
+    private fun saveState(
+        preferences: SharedPreferences,
+        state: PageZoomState,
+    ) {
+        preferences.edit {
+            clear()
+            putInt(PREF_DEFAULT_ZOOM, state.defaultZoom)
+            state.sites.forEach { (site, zoom) -> putInt(PREF_SITE_PREFIX + site, zoom) }
+        }
+    }
+}
+
+/** The − 100% + buttons of the zoom item of the main menu; the percentage goes back to the default zoom. */
+@Composable
+private fun PageZoomControls(
+    zoom: Int,
+    defaultZoom: Int,
+    onZoomOut: () -> Unit,
+    onReset: () -> Unit,
+    onZoomIn: () -> Unit,
+) {
+    val zoomOutDescription = stringResource(R.string.page_zoom_zoom_out)
+    val resetDescription =
+        stringResource(R.string.page_zoom_reset, stringResource(R.string.page_zoom_percent, defaultZoom))
+    val zoomInDescription = stringResource(R.string.page_zoom_zoom_in)
+    Row(verticalAlignment = Alignment.CenterVertically) {
+        TextButton(
+            onClick = onZoomOut,
+            enabled = zoom > PAGE_ZOOM_LEVELS.first(),
+            modifier = Modifier.semantics { contentDescription = zoomOutDescription },
+        ) {
+            Text("−")
+        }
+        TextButton(
+            onClick = onReset,
+            enabled = zoom != defaultZoom,
+            modifier = Modifier.semantics { contentDescription = resetDescription },
+        ) {
+            Text(stringResource(R.string.page_zoom_percent, zoom))
+        }
+        TextButton(
+            onClick = onZoomIn,
+            enabled = zoom < PAGE_ZOOM_LEVELS.last(),
+            modifier = Modifier.semantics { contentDescription = zoomInDescription },
+        ) {
+            Text("+")
+        }
+    }
+}
