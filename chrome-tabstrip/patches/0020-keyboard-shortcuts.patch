+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import android.view.KeyEvent
+
+/** A keyboard shortcut of a physical keyboard (see [keyboardShortcut]). */
+internal sealed interface KeyboardShortcut {
+    /** Whether the shortcut acts again while its keys are held down, like switching tabs in Chrome. */
+    val repeats: Boolean
+        get() = false
+
+    /** Whether the shortcut also works away from the browser and the homepage, e.g. in the settings. */
+    val worksEverywhere: Boolean
+        get() = false
+
+    data object NewTab : KeyboardShortcut {
+        override val worksEverywhere = true
+    }
+
+    data object CloseTab : KeyboardShortcut
+
+    data object ReopenClosedTab : KeyboardShortcut
+
+    data object NextTab : KeyboardShortcut {
+        override val repeats = true
+    }
+
+    data object PreviousTab : KeyboardShortcut {
+        override val repeats = true
+    }
+
+    /**
+     * Selects the tab at [index] in the tab strip.
+     *
+     * @property index The position of the tab, starting from 0.
+     */
+    data class SelectTab(
+        val index: Int,
+    ) : KeyboardShortcut
+
+    data object LastTab : KeyboardShortcut
+
+    data object FocusAddressBar : KeyboardShortcut
+
+    data object Reload : KeyboardShortcut
+
+    data object ReloadBypassingCache : KeyboardShortcut
+
+    data object Back : KeyboardShortcut
+
+    data object Forward : KeyboardShortcut
+
+    data object FindInPage : KeyboardShortcut
+
+    data object Bookmark : KeyboardShortcut
+
+    data object OpenMenu : KeyboardShortcut
+
+    data object Quit : KeyboardShortcut {
+        override val worksEverywhere = true
+    }
+}
+
+private const val SELECTABLE_TABS = 8
+
+/**
+ * Returns the keyboard shortcut of a key pressed with the given modifiers, like in Chrome and Firefox for desktop, or
+ * `null` if it isn't one. Combinations with the Meta key and with AltGr (the right Alt key, used to type characters
+ * like @ or [ on many layouts) are never shortcuts.
+ *
+ * @param keyCode The key, see [KeyEvent.getKeyCode].
+ * @param metaState The modifiers, see [KeyEvent.getMetaState].
+ */
+internal fun keyboardShortcut(
+    keyCode: Int,
+    metaState: Int,
+): KeyboardShortcut? {
+    if ((metaState and (KeyEvent.META_META_ON or KeyEvent.META_ALT_RIGHT_ON)) != 0) return null
+    val ctrl = (metaState and KeyEvent.META_CTRL_ON) != 0
+    val shift = (metaState and KeyEvent.META_SHIFT_ON) != 0
+    val alt = (metaState and KeyEvent.META_ALT_ON) != 0
+    return when {
+        ctrl && !alt && shift -> ctrlShiftShortcut(keyCode)
+        ctrl && !alt -> ctrlShortcut(keyCode)
+        alt && !ctrl && !shift -> altShortcut(keyCode)
+        !ctrl && !alt && !shift -> plainShortcut(keyCode)
+        else -> null
+    }
+}
+
+private fun ctrlShortcut(keyCode: Int): KeyboardShortcut? =
+    when (keyCode) {
+        KeyEvent.KEYCODE_T -> KeyboardShortcut.NewTab
+        KeyEvent.KEYCODE_W, KeyEvent.KEYCODE_F4 -> KeyboardShortcut.CloseTab
+        KeyEvent.KEYCODE_TAB, KeyEvent.KEYCODE_PAGE_DOWN -> KeyboardShortcut.NextTab
+        KeyEvent.KEYCODE_PAGE_UP -> KeyboardShortcut.PreviousTab
+        in KeyEvent.KEYCODE_1 until KeyEvent.KEYCODE_1 + SELECTABLE_TABS ->
+            KeyboardShortcut.SelectTab(keyCode - KeyEvent.KEYCODE_1)
+        KeyEvent.KEYCODE_9 -> KeyboardShortcut.LastTab
+        KeyEvent.KEYCODE_L -> KeyboardShortcut.FocusAddressBar
+        KeyEvent.KEYCODE_R -> KeyboardShortcut.Reload
+        KeyEvent.KEYCODE_F5 -> KeyboardShortcut.ReloadBypassingCache
+        KeyEvent.KEYCODE_F -> KeyboardShortcut.FindInPage
+        KeyEvent.KEYCODE_D -> KeyboardShortcut.Bookmark
+        KeyEvent.KEYCODE_Q -> KeyboardShortcut.Quit
+        else -> null
+    }
+
+private fun ctrlShiftShortcut(keyCode: Int): KeyboardShortcut? =
+    when (keyCode) {
+        KeyEvent.KEYCODE_T -> KeyboardShortcut.ReopenClosedTab
+        KeyEvent.KEYCODE_TAB -> KeyboardShortcut.PreviousTab
+        KeyEvent.KEYCODE_R -> KeyboardShortcut.ReloadBypassingCache
+        else -> null
+    }
+
+private fun altShortcut(keyCode: Int): KeyboardShortcut? =
+    when (keyCode) {
+        KeyEvent.KEYCODE_D -> KeyboardShortcut.FocusAddressBar
+        KeyEvent.KEYCODE_DPAD_LEFT -> KeyboardShortcut.Back
+        KeyEvent.KEYCODE_DPAD_RIGHT -> KeyboardShortcut.Forward
+        else -> null
+    }
+
+private fun plainShortcut(keyCode: Int): KeyboardShortcut? =
+    when (keyCode) {
+        KeyEvent.KEYCODE_F5 -> KeyboardShortcut.Reload
+        KeyEvent.KEYCODE_F6 -> KeyboardShortcut.FocusAddressBar
+        KeyEvent.KEYCODE_F10 -> KeyboardShortcut.OpenMenu
+        else -> null
+    }
+
+/**
+ * Returns the id of the tab to select for a tab switching [shortcut], or `null` if there is none.
+ *
+ * @param shortcut The shortcut.
+ * @param tabIds The ids of the tabs, in the order of the tab strip.
+ * @param selectedTabId The id of the selected tab, if it is one of [tabIds].
+ */
+internal fun tabToSelect(
+    shortcut: KeyboardShortcut,
+    tabIds: List<String>,
+    selectedTabId: String?,
+): String? {
+    if (tabIds.isEmpty()) return null
+    val selectedIndex = tabIds.indexOf(selectedTabId)
+    return when (shortcut) {
+        // Like Chrome, cycles through the tabs.
+        KeyboardShortcut.NextTab -> tabIds[(selectedIndex + 1).mod(tabIds.size)]
+        KeyboardShortcut.PreviousTab ->
+            tabIds[(if (selectedIndex < 0) tabIds.lastIndex else selectedIndex - 1).mod(tabIds.size)]
+        is KeyboardShortcut.SelectTab -> tabIds.getOrNull(shortcut.index)
+        KeyboardShortcut.LastTab -> tabIds.last()
+        else -> null
+    }
+}
+
+/**
+ * Tells when the left Alt key is pressed and released alone, which opens the menu like in Firefox for desktop.
+ */
+internal class AltKeyTracker {
+    private var altDownTime: Long? = null
+
+    /**
+     * Records a key event and returns whether it releases the left Alt key pressed alone: no other key was pressed in
+     * between, and it was pressed in this window (when switching windows with Alt+Tab, the Alt key is pressed in
+     * another window).
+     *
+     * @param keyCode The key, see [KeyEvent.getKeyCode].
+     * @param action The action, see [KeyEvent.getAction].
+     * @param metaState The modifiers, see [KeyEvent.getMetaState].
+     * @param downTime When the key was pressed, see [KeyEvent.getDownTime].
+     * @param repeatCount See [KeyEvent.getRepeatCount].
+     */
+    fun isAltReleasedAlone(
+        keyCode: Int,
+        action: Int,
+        metaState: Int,
+        downTime: Long,
+        repeatCount: Int,
+    ): Boolean {
+        if (keyCode != KeyEvent.KEYCODE_ALT_LEFT) {
+            if (action == KeyEvent.ACTION_DOWN) altDownTime = null
+            return false
+        }
+        return when (action) {
+            KeyEvent.ACTION_DOWN -> {
+                if (repeatCount == 0) {
+                    val otherModifiers = metaState and (KeyEvent.META_ALT_ON or KeyEvent.META_ALT_LEFT_ON).inv()
+                    altDownTime = if (otherModifiers == 0) downTime else null
+                }
+                false
+            }
+            KeyEvent.ACTION_UP -> (altDownTime == downTime).also { altDownTime = null }
+            else -> false
+        }
+    }
+}
