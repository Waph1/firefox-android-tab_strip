diff --git a/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/patchfeatures/KeyboardShortcutsTest.kt b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/patchfeatures/KeyboardShortcutsTest.kt
