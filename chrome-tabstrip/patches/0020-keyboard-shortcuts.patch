+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import android.content.Context
+import android.view.KeyEvent
+import android.view.KeyboardShortcutInfo
+import androidx.lifecycle.lifecycleScope
+import androidx.navigation.NavController
+import androidx.navigation.findNavController
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import mozilla.components.browser.state.action.RecentlyClosedAction
+import mozilla.components.browser.state.selector.getNormalOrPrivateTabs
+import mozilla.components.browser.state.selector.selectedTab
+import mozilla.components.concept.engine.EngineSession.LoadUrlFlags
+import mozilla.components.concept.engine.utils.ABOUT_HOME_URL
+import org.mozilla.fenix.HomeActivity
+import org.mozilla.fenix.NavGraphDirections
+import org.mozilla.fenix.R
+import org.mozilla.fenix.components.appstate.AppAction
+import org.mozilla.fenix.components.metrics.MetricsUtils
+import org.mozilla.fenix.ext.components
+import org.mozilla.fenix.ext.openToBrowser
+
+/**
+ * Optional feature "keyboard shortcuts" (`0020-keyboard-shortcuts.patch`): the shortcuts of Chrome and Firefox for
+ * desktop on a physical keyboard (see [keyboardShortcut]). They get the keys before the page, like in Chrome, and are
+ * listed by the keyboard shortcuts helper of Android (Meta+/).
+ *
+ * Ctrl+T opens the new tab through [PatchFeatureHooks.openNewTab], so that it focuses the address bar when the
+ * feature "new tab with the address bar focused" is included.
+ */
+object KeyboardShortcutsFeature : PatchFeatureHooks {
+    private val altKeyTracker = AltKeyTracker()
+
+    override fun onKeyEvent(
+        activity: HomeActivity,
+        event: KeyEvent,
+    ): Boolean {
+        // Not available yet while the activity starts.
+        val navController = runCatching { activity.findNavController(R.id.container) }.getOrNull() ?: return false
+        val isOnBrowserOrHome = navController.currentDestination?.id in setOf(R.id.browserFragment, R.id.homeFragment)
+
+        val isAltReleasedAlone =
+            altKeyTracker.isAltReleasedAlone(
+                keyCode = event.keyCode,
+                action = event.action,
+                metaState = event.metaState,
+                downTime = event.downTime,
+                repeatCount = event.repeatCount,
+            )
+        if (isAltReleasedAlone && isOnBrowserOrHome) {
+            perform(activity, navController, KeyboardShortcut.OpenMenu)
+            return true
+        }
+
+        val shortcut = keyboardShortcut(event.keyCode, event.metaState) ?: return false
+        if (!isOnBrowserOrHome && !shortcut.worksEverywhere) return false
+        // The release of the keys is consumed too, so that the page doesn't get half a shortcut.
+        if (event.action == KeyEvent.ACTION_DOWN && (event.repeatCount == 0 || shortcut.repeats)) {
+            perform(activity, navController, shortcut)
+        }
+        return true
+    }
+
+    override fun keyboardShortcuts(context: Context): List<KeyboardShortcutInfo> {
+        fun shortcut(
+            label: Int,
+            keyCode: Int,
+            modifiers: Int = KeyEvent.META_CTRL_ON,
+        ) = KeyboardShortcutInfo(context.getString(label), keyCode, modifiers)
+        val ctrlShift = KeyEvent.META_CTRL_ON or KeyEvent.META_SHIFT_ON
+        val alt = KeyEvent.META_ALT_ON
+        return listOf(
+            shortcut(R.string.home_screen_shortcut_open_new_tab_2, KeyEvent.KEYCODE_T),
+            shortcut(R.string.close_tab, KeyEvent.KEYCODE_W),
+            shortcut(R.string.keyboard_shortcut_reopen_closed_tab, KeyEvent.KEYCODE_T, ctrlShift),
+            shortcut(R.string.keyboard_shortcut_next_tab, KeyEvent.KEYCODE_TAB),
+            shortcut(R.string.keyboard_shortcut_previous_tab, KeyEvent.KEYCODE_TAB, ctrlShift),
+            shortcut(R.string.keyboard_shortcut_first_tabs, KeyEvent.KEYCODE_1),
+            shortcut(R.string.keyboard_shortcut_last_tab, KeyEvent.KEYCODE_9),
+            shortcut(R.string.keyboard_shortcut_address_bar, KeyEvent.KEYCODE_L),
+            shortcut(R.string.browser_menu_refresh, KeyEvent.KEYCODE_R),
+            shortcut(R.string.keyboard_shortcut_reload_bypassing_cache, KeyEvent.KEYCODE_R, ctrlShift),
+            shortcut(R.string.browser_menu_back, KeyEvent.KEYCODE_DPAD_LEFT, alt),
+            shortcut(R.string.browser_menu_forward, KeyEvent.KEYCODE_DPAD_RIGHT, alt),
+            shortcut(R.string.browser_menu_find_in_page, KeyEvent.KEYCODE_F),
+            shortcut(R.string.browser_menu_bookmark_this_page_2, KeyEvent.KEYCODE_D),
+            shortcut(R.string.keyboard_shortcut_menu, KeyEvent.KEYCODE_F10, 0),
+            KeyboardShortcutInfo(
+                context.getString(
+                    R.string.browser_menu_delete_browsing_data_on_quit,
+                    context.getString(R.string.app_name),
+                ),
+                KeyEvent.KEYCODE_Q,
+                KeyEvent.META_CTRL_ON,
+            ),
+        )
+    }
+
+    @Suppress("CyclomaticComplexMethod", "LongMethod")
+    private fun perform(
+        activity: HomeActivity,
+        navController: NavController,
+        shortcut: KeyboardShortcut,
+    ) {
+        val components = activity.components
+        val store = components.core.store
+        val selectedTab = store.state.selectedTab
+        val isOnBrowser = navController.currentDestination?.id == R.id.browserFragment
+        when (shortcut) {
+            KeyboardShortcut.NewTab ->
+                if (!PatchFeatureHooks.newTabOpened(activity)) openNewTabLikeFirefox(activity, navController)
+
+            KeyboardShortcut.CloseTab -> {
+                val tab = selectedTab ?: return
+                val isLastTab = store.state.getNormalOrPrivateTabs(tab.content.private).size == 1
+                components.useCases.tabsUseCases.removeTab(tab.id)
+                if (isLastTab && isOnBrowser) navController.navigate(NavGraphDirections.actionGlobalHome())
+            }
+
+            KeyboardShortcut.ReopenClosedTab -> reopenClosedTab(activity, navController)
+
+            KeyboardShortcut.NextTab,
+            KeyboardShortcut.PreviousTab,
+            is KeyboardShortcut.SelectTab,
+            KeyboardShortcut.LastTab,
+            -> {
+                val isPrivate = selectedTab?.content?.private ?: activity.browsingModeManager.mode.isPrivate
+                val tabs = store.state.getNormalOrPrivateTabs(isPrivate)
+                val tabId = tabToSelect(shortcut, tabs.map { it.id }, selectedTab?.id) ?: return
+                components.useCases.tabsUseCases.selectTab(tabId)
+                // On the browser, selecting a tab showing the homepage shows the homepage (AboutHomeBinding).
+                if (tabs.first { it.id == tabId }.content.url != ABOUT_HOME_URL) navController.openToBrowser()
+            }
+
+            KeyboardShortcut.FocusAddressBar ->
+                navController.navigate(
+                    NavGraphDirections.actionGlobalHome(
+                        focusOnAddressBar = true,
+                        // Like tapping the address bar of a page: edits its address.
+                        sessionToStartSearchFor = if (isOnBrowser) selectedTab?.id else null,
+                    ),
+                )
+
+            KeyboardShortcut.Reload -> selectedTab?.let { components.useCases.sessionUseCases.reload(it.id) }
+
+            KeyboardShortcut.ReloadBypassingCache ->
+                selectedTab?.let {
+                    components.useCases.sessionUseCases.reload(it.id, LoadUrlFlags.select(LoadUrlFlags.BYPASS_CACHE))
+                }
+
+            KeyboardShortcut.Back ->
+                selectedTab?.takeIf { it.content.canGoBack }?.let { components.useCases.sessionUseCases.goBack(it.id) }
+
+            KeyboardShortcut.Forward ->
+                selectedTab?.takeIf { it.content.canGoForward }?.let {
+                    components.useCases.sessionUseCases.goForward(it.id)
+                }
+
+            KeyboardShortcut.FindInPage ->
+                if (isOnBrowser) components.appStore.dispatch(AppAction.FindInPageAction.FindInPageStarted)
+
+            KeyboardShortcut.Bookmark -> {
+                val tab = selectedTab?.takeIf { isOnBrowser } ?: return
+                // Like the bookmark button of the toolbar, which shows the "Bookmark saved" message.
+                activity.lifecycleScope.launch(Dispatchers.IO) {
+                    val result = components.useCases.bookmarksUseCases.addBookmark(tab.content.url, tab.content.title)
+                    components.appStore.dispatch(
+                        AppAction.BookmarkAction.BookmarkAdded(
+                            guidToEdit = result.guidToEdit,
+                            parentNode = result.parentNode,
+                            source = MetricsUtils.BookmarkAction.Source.BROWSER_TOOLBAR,
+                        ),
+                    )
+                }
+            }
+
+            // Like the menu key of the keyboard.
+            KeyboardShortcut.OpenMenu ->
+                activity.dispatchKeyEvent(KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_MENU))
+
+            // Closes Firefox without asking: the tabs are there the next time it opens.
+            KeyboardShortcut.Quit -> activity.finishAndRemoveTask()
+        }
+    }
+
+    /** Opens a new tab like the new tab button of the tab strip does in Firefox. */
+    private fun openNewTabLikeFirefox(
+        activity: HomeActivity,
+        navController: NavController,
+    ) {
+        val settings = activity.components.settings
+        if (settings.enableHomepageAsNewTab) {
+            activity.components.useCases.fenixBrowserUseCases.addNewHomepageTab(
+                private = activity.browsingModeManager.mode.isPrivate,
+            )
+        } else {
+            navController.navigate(
+                NavGraphDirections.actionGlobalHome(focusOnAddressBar = !settings.enableHomepageTrendingRecentSearch),
+            )
+        }
+    }
+
+    /**
+     * Reopens the last closed tab: the tabs that can still be restored with "Undo" (private ones too), otherwise the
+     * last tab of the recently closed tabs (like History → Recently closed tabs, only for normal tabs).
+     */
+    private fun reopenClosedTab(
+        activity: HomeActivity,
+        navController: NavController,
+    ) {
+        val components = activity.components
+        val store = components.core.store
+        if (store.state.undoHistory.tabs.isNotEmpty()) {
+            components.useCases.tabsUseCases.undo()
+            return
+        }
+        if (activity.browsingModeManager.mode.isPrivate) return
+        val tab = store.state.closedTabs.maxByOrNull { it.lastAccess } ?: return
+        activity.lifecycleScope.launch {
+            val engineStateStorage = components.core.recentlyClosedTabsStorage.value.engineStateStorage()
+            components.useCases.tabsUseCases.restore(tab, engineStateStorage)
+            store.dispatch(RecentlyClosedAction.RemoveClosedTabAction(tab))
+            navController.openToBrowser()
+        }
+    }
+}
