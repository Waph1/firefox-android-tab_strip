@@ -0,0 +1,137 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import android.view.KeyEvent
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+private const val CTRL = KeyEvent.META_CTRL_ON or KeyEvent.META_CTRL_LEFT_ON
+private const val SHIFT = KeyEvent.META_SHIFT_ON or KeyEvent.META_SHIFT_LEFT_ON
+private const val ALT = KeyEvent.META_ALT_ON or KeyEvent.META_ALT_LEFT_ON
+private const val ALT_GR = KeyEvent.META_ALT_ON or KeyEvent.META_ALT_RIGHT_ON
+
+class KeyboardShortcutsTest {
+    @Test
+    fun `WHEN keys are pressed with Ctrl THEN they are the shortcuts of Chrome`() {
+        assertEquals(KeyboardShortcut.NewTab, keyboardShortcut(KeyEvent.KEYCODE_T, CTRL))
+        assertEquals(KeyboardShortcut.CloseTab, keyboardShortcut(KeyEvent.KEYCODE_W, CTRL))
+        assertEquals(KeyboardShortcut.CloseTab, keyboardShortcut(KeyEvent.KEYCODE_F4, CTRL))
+        assertEquals(KeyboardShortcut.NextTab, keyboardShortcut(KeyEvent.KEYCODE_TAB, CTRL))
+        assertEquals(KeyboardShortcut.NextTab, keyboardShortcut(KeyEvent.KEYCODE_PAGE_DOWN, CTRL))
+        assertEquals(KeyboardShortcut.PreviousTab, keyboardShortcut(KeyEvent.KEYCODE_PAGE_UP, CTRL))
+        assertEquals(KeyboardShortcut.SelectTab(0), keyboardShortcut(KeyEvent.KEYCODE_1, CTRL))
+        assertEquals(KeyboardShortcut.SelectTab(7), keyboardShortcut(KeyEvent.KEYCODE_8, CTRL))
+        assertEquals(KeyboardShortcut.LastTab, keyboardShortcut(KeyEvent.KEYCODE_9, CTRL))
+        assertEquals(KeyboardShortcut.FocusAddressBar, keyboardShortcut(KeyEvent.KEYCODE_L, CTRL))
+        assertEquals(KeyboardShortcut.Reload, keyboardShortcut(KeyEvent.KEYCODE_R, CTRL))
+        assertEquals(KeyboardShortcut.ReloadBypassingCache, keyboardShortcut(KeyEvent.KEYCODE_F5, CTRL))
+        assertEquals(KeyboardShortcut.FindInPage, keyboardShortcut(KeyEvent.KEYCODE_F, CTRL))
+        assertEquals(KeyboardShortcut.Bookmark, keyboardShortcut(KeyEvent.KEYCODE_D, CTRL))
+        assertEquals(KeyboardShortcut.Quit, keyboardShortcut(KeyEvent.KEYCODE_Q, CTRL))
+        assertNull(keyboardShortcut(KeyEvent.KEYCODE_N, CTRL))
+        assertNull(keyboardShortcut(KeyEvent.KEYCODE_0, CTRL))
+    }
+
+    @Test
+    fun `WHEN keys are pressed with Ctrl and Shift THEN they are the shortcuts of Chrome`() {
+        assertEquals(KeyboardShortcut.ReopenClosedTab, keyboardShortcut(KeyEvent.KEYCODE_T, CTRL or SHIFT))
+        assertEquals(KeyboardShortcut.PreviousTab, keyboardShortcut(KeyEvent.KEYCODE_TAB, CTRL or SHIFT))
+        assertEquals(KeyboardShortcut.ReloadBypassingCache, keyboardShortcut(KeyEvent.KEYCODE_R, CTRL or SHIFT))
+        assertNull(keyboardShortcut(KeyEvent.KEYCODE_W, CTRL or SHIFT))
+    }
+
+    @Test
+    fun `WHEN keys are pressed with Alt or alone THEN they are the shortcuts of Chrome`() {
+        assertEquals(KeyboardShortcut.FocusAddressBar, keyboardShortcut(KeyEvent.KEYCODE_D, ALT))
+        assertEquals(KeyboardShortcut.Back, keyboardShortcut(KeyEvent.KEYCODE_DPAD_LEFT, ALT))
+        assertEquals(KeyboardShortcut.Forward, keyboardShortcut(KeyEvent.KEYCODE_DPAD_RIGHT, ALT))
+        assertEquals(KeyboardShortcut.Reload, keyboardShortcut(KeyEvent.KEYCODE_F5, 0))
+        assertEquals(KeyboardShortcut.FocusAddressBar, keyboardShortcut(KeyEvent.KEYCODE_F6, 0))
+        assertEquals(KeyboardShortcut.OpenMenu, keyboardShortcut(KeyEvent.KEYCODE_F10, 0))
+        // Typing isn't a shortcut.
+        assertNull(keyboardShortcut(KeyEvent.KEYCODE_T, 0))
+        assertNull(keyboardShortcut(KeyEvent.KEYCODE_T, SHIFT))
+        assertNull(keyboardShortcut(KeyEvent.KEYCODE_DPAD_LEFT, 0))
+    }
+
+    @Test
+    fun `WHEN keys are pressed with AltGr or Meta THEN they aren't shortcuts`() {
+        // AltGr types characters like @ or [ on many layouts.
+        assertNull(keyboardShortcut(KeyEvent.KEYCODE_D, ALT_GR))
+        assertNull(keyboardShortcut(KeyEvent.KEYCODE_T, CTRL or ALT_GR))
+        assertNull(keyboardShortcut(KeyEvent.KEYCODE_T, CTRL or KeyEvent.META_META_ON))
+        assertNull(keyboardShortcut(KeyEvent.KEYCODE_T, CTRL or ALT))
+    }
+
+    @Test
+    fun `WHEN switching tabs THEN the tabs are cycled in the order of the tab strip`() {
+        val tabs = listOf("a", "b", "c")
+
+        assertEquals("b", tabToSelect(KeyboardShortcut.NextTab, tabs, "a"))
+        assertEquals("a", tabToSelect(KeyboardShortcut.NextTab, tabs, "c"))
+        assertEquals("c", tabToSelect(KeyboardShortcut.PreviousTab, tabs, "a"))
+        assertEquals("a", tabToSelect(KeyboardShortcut.PreviousTab, tabs, "b"))
+        // No tab of the strip is selected, e.g. on the homepage.
+        assertEquals("a", tabToSelect(KeyboardShortcut.NextTab, tabs, null))
+        assertEquals("c", tabToSelect(KeyboardShortcut.PreviousTab, tabs, null))
+    }
+
+    @Test
+    fun `WHEN selecting a tab by position THEN only existing tabs are selected`() {
+        val tabs = listOf("a", "b", "c")
+
+        assertEquals("a", tabToSelect(KeyboardShortcut.SelectTab(0), tabs, "c"))
+        assertEquals("c", tabToSelect(KeyboardShortcut.SelectTab(2), tabs, "a"))
+        assertNull(tabToSelect(KeyboardShortcut.SelectTab(5), tabs, "a"))
+        assertEquals("c", tabToSelect(KeyboardShortcut.LastTab, tabs, "a"))
+        assertNull(tabToSelect(KeyboardShortcut.NextTab, emptyList(), null))
+        assertNull(tabToSelect(KeyboardShortcut.Reload, tabs, "a"))
+    }
+
+    @Test
+    fun `WHEN the left Alt key is pressed and released alone THEN it opens the menu`() {
+        val tracker = AltKeyTracker()
+
+        assertFalse(tracker.event(KeyEvent.KEYCODE_ALT_LEFT, KeyEvent.ACTION_DOWN, ALT, downTime = 1))
+        assertTrue(tracker.event(KeyEvent.KEYCODE_ALT_LEFT, KeyEvent.ACTION_UP, 0, downTime = 1))
+    }
+
+    @Test
+    fun `WHEN the left Alt key is used with another key THEN it doesn't open the menu`() {
+        val tracker = AltKeyTracker()
+
+        // Alt+D.
+        tracker.event(KeyEvent.KEYCODE_ALT_LEFT, KeyEvent.ACTION_DOWN, ALT, downTime = 1)
+        tracker.event(KeyEvent.KEYCODE_D, KeyEvent.ACTION_DOWN, ALT, downTime = 2)
+        assertFalse(tracker.event(KeyEvent.KEYCODE_ALT_LEFT, KeyEvent.ACTION_UP, 0, downTime = 1))
+
+        // Ctrl+Alt.
+        tracker.event(KeyEvent.KEYCODE_ALT_LEFT, KeyEvent.ACTION_DOWN, ALT or CTRL, downTime = 3)
+        assertFalse(tracker.event(KeyEvent.KEYCODE_ALT_LEFT, KeyEvent.ACTION_UP, CTRL, downTime = 3))
+
+        // Back to this window with Alt+Tab: Alt was pressed in another window.
+        assertFalse(tracker.event(KeyEvent.KEYCODE_ALT_LEFT, KeyEvent.ACTION_UP, 0, downTime = 4))
+
+        // AltGr.
+        tracker.event(KeyEvent.KEYCODE_ALT_RIGHT, KeyEvent.ACTION_DOWN, ALT_GR, downTime = 5)
+        assertFalse(tracker.event(KeyEvent.KEYCODE_ALT_RIGHT, KeyEvent.ACTION_UP, 0, downTime = 5))
+    }
+
+    @Test
+    fun `GIVEN the patch of the feature is applied THEN the feature gets the keys`() {
+        assertTrue(KeyboardShortcutsFeature in PatchFeatureHooks.all)
+    }
+
+    private fun AltKeyTracker.event(
+        keyCode: Int,
+        action: Int,
+        metaState: Int,
+        downTime: Long,
+    ) = isAltReleasedAlone(keyCode, action, metaState, downTime, repeatCount = 0)
+}
