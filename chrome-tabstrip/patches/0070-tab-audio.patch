+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.size
+import androidx.compose.foundation.shape.CircleShape
+import androidx.compose.material3.Icon
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.clip
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.painterResource
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.semantics.Role
+import androidx.compose.ui.semantics.contentDescription
+import androidx.compose.ui.semantics.role
+import androidx.compose.ui.semantics.semantics
+import androidx.compose.ui.unit.dp
+import mozilla.components.browser.state.selector.findTab
+import mozilla.components.browser.state.state.MediaSessionState
+import mozilla.components.browser.state.store.BrowserStore
+import mozilla.components.compose.base.menu.MenuItem
+import mozilla.components.compose.base.text.Text
+import mozilla.components.lib.state.ext.observeAsComposableState
+import mozilla.components.ui.icons.R as iconsR
+import org.mozilla.fenix.HomeActivity
+import org.mozilla.fenix.R
+import org.mozilla.fenix.ext.components
+
+private val ButtonSize = 24.dp
+private val IconSize = 16.dp
+
+/**
+ * Optional feature "audio icon on the tabs" (`0070-tab-audio.patch`): like in Chrome, a tab of the tab strip that is
+ * playing audio shows a speaker after its title, and a muted tab a crossed out speaker; tapping it mutes or unmutes
+ * the tab, like the item the feature adds to the menu of the tab.
+ *
+ * It follows the media session that Firefox keeps for each tab (the audio and video elements of the page), so the
+ * sounds of a page without them (e.g. some games) don't show the icon.
+ */
+object TabAudioFeature : PatchFeatureHooks {
+    private var store: BrowserStore? = null
+
+    override fun onActivityCreated(activity: HomeActivity) {
+        store = activity.components.core.store
+    }
+
+    @Composable
+    override fun TabStripTabIcons(tab: TabStripTabInfo) {
+        val store = LocalContext.current.components.core.store
+        val audioState by store.observeAsComposableState { state ->
+            state.findTab(tab.id)?.mediaSessionState.let { tabAudioState(it?.playbackState, it?.muted == true) }
+        }
+        if (audioState == TabAudioState.NONE) return
+
+        val isMuted = audioState == TabAudioState.MUTED
+        val description = stringResource(if (isMuted) R.string.tab_audio_unmute else R.string.tab_audio_mute)
+        Box(
+            modifier =
+                Modifier.size(ButtonSize)
+                    .clip(CircleShape)
+                    .clickable { store.state.findTab(tab.id)?.mediaSessionState?.toggleMute() }
+                    .semantics {
+                        contentDescription = description
+                        role = Role.Button
+                    },
+            contentAlignment = Alignment.Center,
+        ) {
+            Icon(
+                painter =
+                    painterResource(
+                        if (isMuted) iconsR.drawable.mozac_ic_audio_muted_24 else iconsR.drawable.mozac_ic_audio_24,
+                    ),
+                contentDescription = null,
+                modifier = Modifier.size(IconSize),
+                tint =
+                    if (tab.isSelected) {
+                        MaterialTheme.colorScheme.onSurface
+                    } else {
+                        MaterialTheme.colorScheme.onSurfaceVariant
+                    },
+            )
+        }
+    }
+
+    override fun tabStripMenuItems(tab: TabStripMenuTab): List<MenuItem> {
+        val media = store?.state?.findTab(tab.id)?.mediaSessionState ?: return emptyList()
+        val text = Text.Resource(if (media.muted) R.string.tab_audio_unmute else R.string.tab_audio_mute)
+        return listOf(MenuItem.TextItem(text = text) { media.toggleMute() })
+    }
+
+    private fun MediaSessionState.toggleMute() {
+        controller.muteAudio(!muted)
+    }
+}
