+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import mozilla.components.concept.engine.mediasession.MediaSession
+
+/** What the audio icon of a tab of the tab strip shows. */
+internal enum class TabAudioState {
+    /** No icon: the tab doesn't play audio. */
+    NONE,
+
+    /** A speaker: the tab is playing audio. */
+    PLAYING,
+
+    /** A crossed out speaker: the audio of the tab is muted. */
+    MUTED,
+}
+
+/**
+ * Returns what the audio icon of a tab shows, from the media session of the tab.
+ *
+ * @param playbackState The playback state of the media of the tab, or `null` if it has no media.
+ * @param isMuted Whether the media of the tab are muted.
+ */
+internal fun tabAudioState(
+    playbackState: MediaSession.PlaybackState?,
+    isMuted: Boolean,
+): TabAudioState =
+    when {
+        playbackState == null -> TabAudioState.NONE
+        isMuted -> TabAudioState.MUTED
+        playbackState == MediaSession.PlaybackState.PLAYING -> TabAudioState.PLAYING
+        else -> TabAudioState.NONE
+    }
