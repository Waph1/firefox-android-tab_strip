+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import mozilla.components.concept.engine.mediasession.MediaSession.PlaybackState
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class TabAudioTest {
+    @Test
+    fun `WHEN a tab plays audio THEN it shows a speaker`() {
+        assertEquals(TabAudioState.PLAYING, tabAudioState(PlaybackState.PLAYING, isMuted = false))
+    }
+
+    @Test
+    fun `WHEN a tab is muted THEN it shows a crossed out speaker, even while paused`() {
+        assertEquals(TabAudioState.MUTED, tabAudioState(PlaybackState.PLAYING, isMuted = true))
+        assertEquals(TabAudioState.MUTED, tabAudioState(PlaybackState.PAUSED, isMuted = true))
+    }
+
+    @Test
+    fun `WHEN a tab doesn't play audio THEN it shows no icon`() {
+        assertEquals(TabAudioState.NONE, tabAudioState(null, isMuted = false))
+        assertEquals(TabAudioState.NONE, tabAudioState(PlaybackState.PAUSED, isMuted = false))
+        assertEquals(TabAudioState.NONE, tabAudioState(PlaybackState.STOPPED, isMuted = false))
+    }
+}
