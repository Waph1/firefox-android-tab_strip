+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import java.net.URLEncoder
+import java.util.Collections
+import java.util.IdentityHashMap
+import kotlin.math.max
+
+/** The page that opens a new issue in the repository of the patch, where the crash reports go. */
+internal const val NEW_CRASH_ISSUE_URL = "https://github.com/Waph1/firefox-android-tab_strip/issues/new"
+
+/** How long the address of a new issue can be: GitHub refuses longer ones. */
+internal const val MAX_CRASH_ISSUE_URL_LENGTH = 7500
+
+private const val MAX_TITLE_LENGTH = 100
+private const val MAX_FRAMES = 30
+private const val MAX_CAUSE_FRAMES = 12
+
+/**
+ * What a crash report says about a crash, besides its stack trace.
+ *
+ * @property kind What crashed, e.g. the code of the app or the Gecko engine.
+ * @property appVersion The version of Firefox, with its version code.
+ * @property features The optional features of the patch included in this build.
+ * @property missingFeatures The optional features of the patch missing from this build.
+ * @property device The device and its Android version.
+ * @property time When the crash happened, in UTC.
+ * @property breadcrumbs The last things the app did before the crash, oldest first.
+ */
+internal data class CrashReportDetails(
+    val kind: String,
+    val appVersion: String,
+    val features: List<String>,
+    val missingFeatures: List<String>,
+    val device: String,
+    val time: String,
+    val breadcrumbs: List<String>,
+)
+
+/** Returns the title of the issue of a crash, e.g. the exception and its message, shortened if needed. */
+internal fun crashIssueTitle(summary: String): String {
+    val title = "Crash: ${summary.lineSequence().firstOrNull().orEmpty().trim()}"
+    return if (title.length <= MAX_TITLE_LENGTH) title else title.take(MAX_TITLE_LENGTH - 1) + "…"
+}
+
+/**
+ * Returns the stack trace of [throwable] and of its causes, with the first frames of each: the root cause, often the
+ * most useful part, stays in.
+ */
+internal fun crashStackTrace(throwable: Throwable): String {
+    val seen = Collections.newSetFromMap(IdentityHashMap<Throwable, Boolean>())
+    return buildString {
+        var current: Throwable? = throwable
+        while (current != null && seen.add(current)) {
+            val isCause = current !== throwable
+            if (isCause) append("Caused by: ")
+            appendLine(current.toString())
+            val frames = current.stackTrace
+            val maxFrames = if (isCause) MAX_CAUSE_FRAMES else MAX_FRAMES
+            frames.take(maxFrames).forEach { appendLine("\tat $it") }
+            if (frames.size > maxFrames) appendLine("\t... ${frames.size - maxFrames} more")
+            current = current.cause
+        }
+    }.trimEnd()
+}
+
+/** Returns the text of the issue of a crash, before its stack trace. */
+internal fun crashIssueDetails(details: CrashReportDetails): String =
+    buildString {
+        appendLine("Segnalazione inviata da Firefox dopo un crash.")
+        appendLine()
+        appendLine("- **Tipo:** ${details.kind}")
+        appendLine("- **Versione:** ${details.appVersion}")
+        appendLine("- **Funzioni della patch:** ${details.features.joinToString().ifEmpty { "nessuna" }}")
+        if (details.missingFeatures.isNotEmpty()) {
+            appendLine("- **Funzioni mancanti:** ${details.missingFeatures.joinToString()}")
+        }
+        appendLine("- **Dispositivo:** ${details.device}")
+        append("- **Data:** ${details.time} UTC")
+        if (details.breadcrumbs.isNotEmpty()) {
+            appendLine()
+            appendLine()
+            appendLine("Ultime azioni dell'app:")
+            details.breadcrumbs.forEach { appendLine("- $it") }
+        }
+    }.trimEnd()
+
+/**
+ * Returns the address of a new issue of the repository filled in with a crash: its title, its [details] and its
+ * [stackTrace]. The stack trace loses its last lines when the address would be too long for GitHub.
+ *
+ * @param title The title of the issue.
+ * @param details The text before the stack trace, see [crashIssueDetails].
+ * @param stackTrace The stack trace, see [crashStackTrace].
+ * @param newIssueUrl The page that opens a new issue.
+ * @param maxLength How long the address can be.
+ */
+internal fun crashIssueUrl(
+    title: String,
+    details: String,
+    stackTrace: String,
+    newIssueUrl: String = NEW_CRASH_ISSUE_URL,
+    maxLength: Int = MAX_CRASH_ISSUE_URL_LENGTH,
+): String {
+    var lines = stackTrace.lines()
+    var isShortened = false
+    while (true) {
+        val trace = lines.joinToString("\n") + if (isShortened) "\n\t…" else ""
+        val body = "$details\n\n```\n$trace\n```"
+        val url = "$newIssueUrl?labels=crash&title=${title.encoded()}&body=${body.encoded()}"
+        if (url.length <= maxLength || lines.isEmpty()) return url
+        lines = lines.dropLast(max(1, lines.size / 10))
+        isShortened = true
+    }
+}
+
+private fun String.encoded(): String = URLEncoder.encode(this, "UTF-8")
