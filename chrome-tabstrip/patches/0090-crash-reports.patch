+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.net.URLDecoder
+
+class CrashReportsTest {
+    private val details =
+        CrashReportDetails(
+            kind = "eccezione",
+            appVersion = "158.0.2 (2016191874)",
+            features = listOf("bookmarks-bar", "tab-groups"),
+            missingFeatures = listOf("page-zoom"),
+            device = "samsung SM-F966B, Android 16 (API 36)",
+            time = "2026-10-22 22:00",
+            breadcrumbs = listOf("onConfigurationChanged()"),
+        )
+
+    @Test
+    fun `WHEN titling a crash THEN it is its first line, shortened if needed`() {
+        assertEquals(
+            "Crash: java.lang.IllegalStateException: boom",
+            crashIssueTitle("java.lang.IllegalStateException: boom\nmore"),
+        )
+        val title = crashIssueTitle("x".repeat(200))
+        assertEquals(100, title.length)
+        assertTrue(title.endsWith("…"))
+    }
+
+    @Test
+    fun `WHEN writing the stack trace THEN it has the exception and its causes`() {
+        val cause = IllegalArgumentException("root")
+        val trace = crashStackTrace(IllegalStateException("top", cause))
+
+        assertTrue(trace.startsWith("java.lang.IllegalStateException: top\n\tat "))
+        assertTrue(trace.contains("Caused by: java.lang.IllegalArgumentException: root"))
+    }
+
+    @Test
+    fun `WHEN writing the details THEN they list the version, the features and the device`() {
+        val text = crashIssueDetails(details)
+
+        assertTrue(text.contains("158.0.2 (2016191874)"))
+        assertTrue(text.contains("bookmarks-bar, tab-groups"))
+        assertTrue(text.contains("**Funzioni mancanti:** page-zoom"))
+        assertTrue(text.contains("samsung SM-F966B"))
+        assertTrue(text.contains("- onConfigurationChanged()"))
+        assertFalse(crashIssueDetails(details.copy(missingFeatures = emptyList())).contains("mancanti"))
+    }
+
+    @Test
+    fun `WHEN building the address of the issue THEN it fills in the title and the body with the stack trace`() {
+        val url = crashIssueUrl("Crash: boom", "details", "line 1\nline 2")
+
+        assertTrue(url.startsWith("$NEW_CRASH_ISSUE_URL?labels=crash&title="))
+        val body = URLDecoder.decode(url.substringAfter("&body="), "UTF-8")
+        assertEquals("details\n\n```\nline 1\nline 2\n```", body)
+        assertEquals("Crash: boom", URLDecoder.decode(url.substringAfter("title=").substringBefore("&body="), "UTF-8"))
+    }
+
+    @Test
+    fun `GIVEN a long stack trace WHEN building the address of the issue THEN the end of the stack trace is cut`() {
+        val trace = (1..2000).joinToString("\n") { "\tat org.example.Class.method$it(Class.kt:$it)" }
+        val url = crashIssueUrl("Crash: boom", "details", trace)
+
+        assertTrue(url.length <= MAX_CRASH_ISSUE_URL_LENGTH)
+        val body = URLDecoder.decode(url.substringAfter("&body="), "UTF-8")
+        assertTrue(body.contains("method1("))
+        assertFalse(body.contains("method2000("))
+        assertTrue(body.endsWith("\t…\n```"))
+    }
+}
