+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import android.Manifest
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Build
+import androidx.core.app.NotificationChannelCompat
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import androidx.core.content.ContextCompat
+import androidx.core.content.pm.PackageInfoCompat
+import mozilla.components.concept.base.crash.Breadcrumb
+import mozilla.components.lib.crash.Crash
+import mozilla.components.lib.crash.service.CrashReporterService
+import mozilla.components.support.base.log.logger.Logger
+import mozilla.components.support.utils.ext.packageManagerCompatHelper
+import org.mozilla.fenix.R
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+
+private const val NOTIFICATION_CHANNEL_ID = "chrome_tabstrip_crash_reports"
+private const val MAX_BREADCRUMBS = 10
+
+/**
+ * Optional feature "crash reports on GitHub" (`0090-crash-reports.patch`): the crash reports go to the repository of
+ * the patch, so that its crashes can be fixed, instead of Mozilla (which doesn't fix the crashes of a modified
+ * Firefox, and doesn't show them to anyone else).
+ *
+ * When the user sends the report of a crash (from the crash prompt of Firefox), a notification opens a new issue of
+ * the repository filled in with the crash, which the user checks and submits on GitHub: the app holds no GitHub key,
+ * and nothing is sent without the user. The same issue opens from the list of the crashes (about:crashes).
+ */
+object CrashReportsFeature : PatchFeatureHooks {
+    override fun crashReporting(
+        context: Context,
+        default: CrashReporting,
+    ): CrashReporting = CrashReporting(listOf(GitHubCrashReporterService(context)), organizationName = "GitHub")
+}
+
+/**
+ * Turns the crash reports into new issues of the repository of the patch (see [CrashReportsFeature]): the report of a
+ * crash is the address of its issue, which a notification opens.
+ */
+private class GitHubCrashReporterService(
+    private val context: Context,
+) : CrashReporterService {
+    private val logger = Logger("GitHubCrashReporterService")
+
+    override val id: String = "github-chrome-tabstrip"
+
+    override val name: String = "GitHub"
+
+    override fun createCrashReportUrl(identifier: String): String? =
+        identifier.takeIf { it.startsWith(NEW_CRASH_ISSUE_URL) }
+
+    override fun report(crash: Crash.UncaughtExceptionCrash): String {
+        val throwable = crash.throwable
+        val details = details(crash, kind = "eccezione nel codice Android di Firefox (dove stanno le patch)")
+        val url =
+            crashIssueUrl(crashIssueTitle(throwable.toString()), crashIssueDetails(details), crashStackTrace(throwable))
+        notify(url)
+        return url
+    }
+
+    override fun report(crash: Crash.NativeCodeCrash): String {
+        val process = listOfNotNull(crash.processType, crash.remoteType).joinToString(", ").ifEmpty { "principale" }
+        val details = details(crash, kind = "crash nel motore Gecko (codice nativo, processo $process)")
+        val stackTrace = "Nessuno stack Java: il minidump del crash nativo resta sul telefono."
+        val title = crashIssueTitle("crash nativo di Gecko ($process)")
+        val url = crashIssueUrl(title, crashIssueDetails(details), stackTrace)
+        notify(url)
+        return url
+    }
+
+    // The exceptions that Firefox catches aren't crashes: they aren't reported.
+    override fun report(
+        throwable: Throwable,
+        breadcrumbs: ArrayList<Breadcrumb>,
+    ): String? = null
+
+    private fun details(
+        crash: Crash,
+        kind: String,
+    ): CrashReportDetails {
+        val features = PatchFeatures.current
+        val packageInfo = context.packageManagerCompatHelper.getPackageInfoCompat(context.packageName, 0)
+        val time =
+            SimpleDateFormat("yyyy-MM-dd HH:mm", Locale.ROOT)
+                .apply { timeZone = TimeZone.getTimeZone("UTC") }
+                .format(Date(crash.timestamp))
+        return CrashReportDetails(
+            kind = kind,
+            appVersion = "${packageInfo.versionName} (${PackageInfoCompat.getLongVersionCode(packageInfo)})",
+            features = features.included.map { it.id },
+            missingFeatures = features.missing.map { it.id },
+            device =
+                "${Build.MANUFACTURER} ${Build.MODEL}, Android ${Build.VERSION.RELEASE} (API ${Build.VERSION.SDK_INT})",
+            time = time,
+            breadcrumbs =
+                crash.breadcrumbs.takeLast(MAX_BREADCRUMBS).map { breadcrumb ->
+                    listOf(breadcrumb.category, breadcrumb.message).filter { it.isNotBlank() }.joinToString(": ")
+                },
+        )
+    }
+
+    /** Shows a notification that opens the issue of the crash in Firefox. */
+    private fun notify(url: String) {
+        val notifications = NotificationManagerCompat.from(context)
+        val canNotify =
+            Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU ||
+                ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) ==
+                PackageManager.PERMISSION_GRANTED
+        if (!canNotify || !notifications.areNotificationsEnabled()) {
+            logger.info("The crash report can't be notified: it opens from about:crashes")
+            return
+        }
+
+        notifications.createNotificationChannel(
+            NotificationChannelCompat.Builder(NOTIFICATION_CHANNEL_ID, NotificationManagerCompat.IMPORTANCE_DEFAULT)
+                .setName(context.getString(R.string.crash_reports_notification_channel))
+                .build(),
+        )
+        val intent =
+            Intent(Intent.ACTION_VIEW, Uri.parse(url)).apply {
+                setPackage(context.packageName)
+                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            }
+        val pendingIntent =
+            PendingIntent.getActivity(
+                context,
+                url.hashCode(),
+                intent,
+                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+            )
+        val notification =
+            NotificationCompat.Builder(context, NOTIFICATION_CHANNEL_ID)
+                .setSmallIcon(R.drawable.ic_status_logo)
+                .setContentTitle(context.getString(R.string.crash_reports_notification_title))
+                .setContentText(context.getString(R.string.crash_reports_notification_text))
+                .setContentIntent(pendingIntent)
+                .setAutoCancel(true)
+                .build()
+        try {
+            notifications.notify(url.hashCode(), notification)
+        } catch (e: SecurityException) {
+            logger.warn("Can't notify the crash report", e)
+        }
+    }
+}
