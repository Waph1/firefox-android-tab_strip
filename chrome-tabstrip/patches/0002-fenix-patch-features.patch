+private fun createCloseOtherTabsHandler(
+    browserStore: BrowserStore,
+    tabsUseCases: TabsUseCases,
+    onSelectedTabClick: (url: String) -> Unit,
+    onCloseTabsClick: (count: Int) -> Unit,
+): (tabId: String, isPrivate: Boolean) -> Unit = { tabId, isPrivate ->
+    val tab = browserStore.state.findTab(tabId)
+    val otherTabIds = browserStore.state.getNormalOrPrivateTabs(isPrivate).map { it.id }.filter { it != tabId }
+    if (tab != null && otherTabIds.isNotEmpty()) {
+        // The tab stays selected (or becomes so) instead of the closest one.
+        if (browserStore.state.selectedTabId != tabId) {
+            tabsUseCases.selectTab(tabId)
+            onSelectedTabClick(tab.content.url)
+        }
+        tabsUseCases.removeTabs(otherTabIds)
+        onCloseTabsClick(otherTabIds.size)
+    }
+}
