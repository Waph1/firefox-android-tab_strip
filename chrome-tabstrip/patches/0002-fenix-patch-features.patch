+import org.mozilla.fenix.patchfeatures.TabStripMenuTab
+
+/**
+ * Actions of the menu of a tab in the tab strip, shown by a long press on the tab like in Chrome (dragging the tab
+ * closes it and moves the tab instead).
+ *
+ * @property onReload Invoked when the tab is reloaded.
+ * @property onCloseOthers Invoked when the other tabs (normal or private, like the tab) are closed.
+ */
+internal data class TabStripTabMenuActions(
+    val onReload: (tabId: String) -> Unit,
+    val onCloseOthers: (tabId: String, isPrivate: Boolean) -> Unit,
+)
+
+/**
+ * Returns the items of the menu of [tab]: the basic ones, then the ones added by the optional features of the patch
+ * (see [PatchFeatureHooks.tabStripMenuItems]).
+ *
+ * @param tab The tab.
+ * @param hasOtherTabs Whether the tab strip shows other tabs than [tab].
+ * @param actions The actions of the basic items.
+ * @param onClose Invoked to close the tab (with the closing animation of the tab strip).
+ */
+internal fun tabStripTabMenuItems(
+    tab: TabStripItem,
+    hasOtherTabs: Boolean,
+    actions: TabStripTabMenuActions,
+    onClose: () -> Unit,
+): List<MenuItem> =
+    listOf(
+        MenuItem.TextItem(text = Text.Resource(R.string.browser_menu_refresh)) { actions.onReload(tab.id) },
+        MenuItem.TextItem(text = Text.Resource(R.string.close_tab), onClick = onClose),
+        MenuItem.TextItem(
+            text = Text.Resource(R.string.tab_strip_menu_close_other_tabs),
+            enabled = hasOtherTabs,
+        ) {
+            actions.onCloseOthers(tab.id, tab.isPrivate)
+        },
+    ) + PatchFeatureHooks.all.flatMap { it.tabStripMenuItems(TabStripMenuTab(tab.id, tab.isPrivate)) }
+
+/**
+ * Menu of a tab in the tab strip, anchored to the tab.
+ *
+ * @param expanded Whether the menu is shown.
+ * @param menuItems Returns the items of the menu, see [tabStripTabMenuItems]. Only invoked while the menu is shown.
+ * @param onDismissRequest Invoked when the menu is closed.
+ */
+@Composable
+internal fun TabStripTabMenu(
+    expanded: Boolean,
+    menuItems: () -> List<MenuItem>,
+    onDismissRequest: () -> Unit,
+) {
+    // While the menu closes, it keeps showing the items it was showing.
+    val shownItems = remember { arrayOfNulls<List<MenuItem>>(1) }
+    val items = if (expanded) menuItems().also { shownItems[0] = it } else shownItems[0].orEmpty()
+    DropdownMenu(
+        menuItems = items,
+        expanded = expanded,
+        onDismissRequest = onDismissRequest,
+    )
+}
