+   - file, You can obtain one at http://mozilla.org/MPL/2.0/. -->
+<!-- Optional features of the patch with the Chrome-like tab strip, and the menu of the tabs in the tab strip. Only
+     translated in Italian. -->
+<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
+    <!-- Part of the message of the update dialog, when the update leaves out optional features of the patch that the
+         installed version has. %1$s is the list of the features, one per line. -->
+    <string name="self_update_lost_features">⚠️ This version doesn’t include some features of the patch that you have in the installed version:\n%1$s\nThey’ll come back with a later update.</string>
+    <!-- Part of the message of the update dialog, when the update leaves out optional features of the patch that the
+         installed version doesn't have either. %1$s is the list of the features, one per line. -->
+    <string name="self_update_missing_features">Features of the patch not included in this version (you don’t have them now either):\n%1$s</string>
+    <!-- Part of the message of the update dialog, when the update includes again optional features of the patch
+         missing from the installed version. %1$s is the list of the features, one per line. -->
+    <string name="self_update_restored_features">This version brings back:\n%1$s</string>
+    <!-- Button of the update dialog, shown when the update leaves out some features: the update is no longer offered
+         by the daily check. -->
+    <string name="self_update_skip">Skip this version</string>
+    <!-- Item of the About page listing the optional features of the patch included in this version. -->
+    <string name="patch_features_title">Patch features</string>
+    <!-- Part of the dialog of the optional features of the patch. %1$s is the list of the features, one per line. -->
+    <string name="patch_features_included">Included in this version:\n%1$s</string>
+    <!-- Part of the dialog of the optional features of the patch. %1$s is the list of the features, one per line. -->
+    <string name="patch_features_missing">⚠️ Not included in this version, because their patch doesn’t apply or compile on this version of Firefox:\n%1$s\nThey’ll come back with a later update.</string>
+    <!-- Item of the menu of a tab in the tab strip, closing all the other tabs (normal or private, like the tab). -->
+    <string name="tab_strip_menu_close_other_tabs">Close other tabs</string>
+</resources>
