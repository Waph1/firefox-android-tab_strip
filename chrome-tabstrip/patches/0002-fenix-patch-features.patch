+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mozilla.fenix.selfupdate.SelfUpdateInfo
+import org.robolectric.RobolectricTestRunner
+import java.util.Locale
+
+@RunWith(RobolectricTestRunner::class)
+class PatchFeaturesTest {
+    private val tabGroups = feature("tab-groups", "Gruppi di schede", "Tab groups")
+    private val pageZoom = feature("page-zoom", "Zoom della pagina", "Page zoom")
+    private val tabAudio = feature("tab-audio", "Icona audio", "Tab audio")
+
+    private fun feature(
+        id: String,
+        italian: String,
+        english: String,
+    ) = PatchFeature(id = id, names = mapOf("it" to italian, "en" to english))
+
+    @Test
+    fun `GIVEN a feature WHEN its name is asked THEN it is in the language of the locale, or in English`() {
+        assertEquals("Gruppi di schede", tabGroups.name(Locale.ITALIAN))
+        assertEquals("Tab groups", tabGroups.name(Locale.ENGLISH))
+        assertEquals("Tab groups", tabGroups.name(Locale.GERMAN))
+        assertEquals("only", PatchFeature("only", mapOf("it" to "only")).name(Locale.GERMAN))
+        assertEquals("no-names", PatchFeature("no-names", emptyMap()).name(Locale.GERMAN))
+    }
+
+    @Test
+    fun `GIVEN an update json describing the features WHEN parsed THEN the features are returned`() {
+        val json =
+            JSONObject(
+                """
+                {
+                  "features": [{ "id": "page-zoom", "name": { "it": "Zoom della pagina", "en": "Page zoom" } }],
+                  "missingFeatures": [{ "id": "tab-groups", "name": { "it": "Gruppi di schede", "en": "Tab groups" } }]
+                }
+                """,
+            )
+
+        assertEquals(
+            PatchFeatures(included = listOf(pageZoom), missing = listOf(tabGroups)),
+            PatchFeatures.fromJson(json),
+        )
+    }
+
+    @Test
+    fun `GIVEN an update json that doesn't describe the features WHEN parsed THEN there are no features`() {
+        assertNull(PatchFeatures.fromJson(JSONObject("""{ "versionCode": 1 }""")))
+        assertNull(PatchFeatures.fromJson(JSONObject("""{ "features": [], "missingFeatures": [{ "id": 1 }] }""")))
+        assertNull(PatchFeatures.fromJson(JSONObject("""{ "features": "none", "missingFeatures": [] }""")))
+    }
+
+    @Test
+    fun `GIVEN the update json of a release WHEN parsed THEN its features are part of the update`() {
+        val update =
+            SelfUpdateInfo.fromJson(
+                """
+                {
+                  "packageName": "org.mozilla.firefox",
+                  "versionName": "159.0",
+                  "versionCode": 2017000000,
+                  "apkUrl": "https://github.com/owner/repo/releases/download/tag/firefox.apk",
+                  "signingCertSha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
+                  "features": [],
+                  "missingFeatures": [{ "id": "tab-groups", "name": { "it": "Gruppi di schede", "en": "Tab groups" } }]
+                }
+                """,
+            )
+
+        assertEquals(PatchFeatures(included = emptyList(), missing = listOf(tabGroups)), update?.features)
+    }
+
+    @Test
+    fun `GIVEN an update without some features WHEN compared THEN the lost ones are told apart from the others`() {
+        val installed = PatchFeatures(included = listOf(tabGroups, pageZoom), missing = listOf(tabAudio))
+        val update = PatchFeatures(included = listOf(pageZoom), missing = listOf(tabGroups, tabAudio))
+
+        val changes = PatchFeatureChanges.between(installed, update)
+
+        assertEquals(PatchFeatureChanges(lost = listOf(tabGroups), missing = listOf(tabAudio)), changes)
+        assertTrue(changes.isIncomplete)
+    }
+
+    @Test
+    fun `GIVEN an update including features missing from the installed build WHEN compared THEN they are restored`() {
+        val installed = PatchFeatures(included = listOf(pageZoom), missing = listOf(tabGroups, tabAudio))
+        val update = PatchFeatures(included = listOf(pageZoom, tabGroups, tabAudio), missing = emptyList())
+
+        val changes = PatchFeatureChanges.between(installed, update)
+
+        assertEquals(PatchFeatureChanges(restored = listOf(tabGroups, tabAudio)), changes)
+        assertFalse(changes.isIncomplete)
+    }
+
+    @Test
+    fun `GIVEN an update that doesn't describe its features WHEN compared THEN it is complete`() {
+        val installed = PatchFeatures(included = listOf(pageZoom), missing = listOf(tabGroups))
+
+        val changes = PatchFeatureChanges.between(installed, update = null)
+
+        assertEquals(PatchFeatureChanges(), changes)
+        assertFalse(changes.isIncomplete)
+    }
+}
