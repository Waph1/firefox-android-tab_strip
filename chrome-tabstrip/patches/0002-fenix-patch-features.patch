+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.browser.tabstrip
+
+import mozilla.components.compose.base.menu.MenuItem
+import mozilla.components.compose.base.text.Text
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.mozilla.fenix.R
+import org.mozilla.fenix.patchfeatures.PatchFeatureHooks
+import org.mozilla.fenix.patchfeatures.TabStripMenuTab
+
+class TabStripTabMenuTest {
+    private val tab =
+        TabStripItem(id = "tab", title = "Title", url = "https://example.com", isPrivate = true, isSelected = false)
+
+    private val reloaded = mutableListOf<String>()
+    private val closedOthers = mutableListOf<Pair<String, Boolean>>()
+    private var closeCount = 0
+    private val actions =
+        TabStripTabMenuActions(
+            onReload = { reloaded += it },
+            onCloseOthers = { tabId, isPrivate -> closedOthers += tabId to isPrivate },
+        )
+
+    private fun items(hasOtherTabs: Boolean = true) =
+        tabStripTabMenuItems(tab, hasOtherTabs, actions, onClose = { closeCount++ }).map { it as MenuItem.TextItem }
+
+    @Test
+    fun `WHEN the menu of a tab is built THEN it has the basic items, then the ones of the optional features`() {
+        val items = items()
+
+        assertEquals(
+            listOf(R.string.browser_menu_refresh, R.string.close_tab, R.string.tab_strip_menu_close_other_tabs),
+            items.take(3).map { (it.text as Text.Resource).value },
+        )
+        val featureItems = PatchFeatureHooks.all.sumOf { it.tabStripMenuItems(TabStripMenuTab("tab", true)).size }
+        assertEquals(3 + featureItems, items.size)
+    }
+
+    @Test
+    fun `WHEN an item of the menu is clicked THEN its action is invoked for the tab`() {
+        val (reload, close, closeOthers) = items()
+
+        reload.onClick()
+        close.onClick()
+        closeOthers.onClick()
+
+        assertEquals(listOf("tab"), reloaded)
+        assertEquals(1, closeCount)
+        assertEquals(listOf("tab" to true), closedOthers)
+    }
+
+    @Test
+    fun `GIVEN the only tab of the strip WHEN its menu is built THEN the other tabs can't be closed`() {
+        assertTrue(items(hasOtherTabs = true)[2].enabled)
+        assertFalse(items(hasOtherTabs = false)[2].enabled)
+    }}
