+package org.mozilla.fenix.patchfeatures
+
+import android.content.Context
+import androidx.core.os.ConfigurationCompat
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import org.mozilla.fenix.R
+import java.util.Locale
+
+/**
+ * Title of the item of the About page listing the optional features of this build (see [showPatchFeaturesDialog]),
+ * with a warning when some are missing, or `null` if the patch has no optional features.
+ */
+fun patchFeaturesAboutTitle(context: Context): String? {
+    val features = PatchFeatures.current
+    if (features.included.isEmpty() && features.missing.isEmpty()) return null
+    val title = context.getString(R.string.patch_features_title)
+    return if (features.missing.isEmpty()) title else "$title ⚠️"
+}
+
+/** Shows the optional features of the patch included in this build, and the missing ones. */
+fun showPatchFeaturesDialog(context: Context) {
+    val features = PatchFeatures.current
+    val locale = ConfigurationCompat.getLocales(context.resources.configuration)[0] ?: Locale.getDefault()
+    fun List<PatchFeature>.bulletList() = joinToString("\n") { "• ${it.name(locale)}" }
+    val message =
+        listOfNotNull(
+            features.included.takeIf { it.isNotEmpty() }?.let {
+                context.getString(R.string.patch_features_included, it.bulletList())
+            },
+            features.missing.takeIf { it.isNotEmpty() }?.let {
+                context.getString(R.string.patch_features_missing, it.bulletList())
+            },
+        ).joinToString("\n\n")
+    MaterialAlertDialogBuilder(context)
+        .setTitle(R.string.patch_features_title)
+        .setMessage(message)
+        .setPositiveButton(android.R.string.ok, null)
+        .show()
+}
