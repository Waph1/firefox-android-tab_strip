+ * An optional feature of the patch with the Chrome-like tab strip (see `chrome-tabstrip/patches/series`). Each one has
+ * its own patch: when it doesn't apply or compile on a new version of Firefox, the GitHub build leaves it out and
+ * publishes the release anyway, telling which features are missing.
+ *
+ * @property id The identifier of the feature: the name of its patch without number, e.g. "tab-groups".
+ * @property names The name of the feature shown to the user, by language (e.g. "it", "en").
+ */
+data class PatchFeature(
+    val id: String,
+    val names: Map<String, String>,
+) {
+    /** Returns the name of the feature in the language of [locale], in English if it isn't translated. */
+    fun name(locale: Locale): String =
+        names[locale.language] ?: names[DEFAULT_LANGUAGE] ?: names.values.firstOrNull() ?: id
+}
+
+/**
+ * The optional features of a build of the patch.
+ *
+ * @property included The features included in the build.
+ * @property missing The features left out of the build, because their patch didn't apply or compile.
+ */
+data class PatchFeatures(
+    val included: List<PatchFeature>,
+    val missing: List<PatchFeature>,
+) {
+    companion object {
+        /** The optional features of this build, written by `apply.sh` when the patches were applied. */
+        val current: PatchFeatures
+            get() = PatchFeatures(GeneratedPatchFeatures.included, GeneratedPatchFeatures.missing)
+
+        /**
+         * Reads the features of a release from its `update.json` (see `ci-update-info.sh`), or returns `null` if it
+         * doesn't describe them (a release published before the patch was split in optional features).
+         */
+        fun fromJson(json: JSONObject): PatchFeatures? =
+            try {
+                if (!json.has("features") || !json.has("missingFeatures")) {
+                    null
+                } else {
+                    PatchFeatures(
+                        included = json.getJSONArray("features").toFeatures(),
+                        missing = json.getJSONArray("missingFeatures").toFeatures(),
+                    )
+                }
+            } catch (e: JSONException) {
+                null
+            }
+
+        private fun JSONArray.toFeatures() =
+            List(length()) { i ->
+                val feature = getJSONObject(i)
+                val names = feature.getJSONObject("name")
+                PatchFeature(
+                    id = feature.getString("id"),
+                    names = names.keys().asSequence().associateWith { names.getString(it) },
+                )
+            }
+    }
+}
+
+/**
+ * How the optional features of an update differ from the ones of the installed build.
+ *
+ * @property lost The features of the installed build that the update doesn't include.
+ * @property missing The other features that the update doesn't include: the installed build doesn't have them either.
+ * @property restored The features missing from the installed build that the update includes again.
+ */
+data class PatchFeatureChanges(
+    val lost: List<PatchFeature> = emptyList(),
+    val missing: List<PatchFeature> = emptyList(),
+    val restored: List<PatchFeature> = emptyList(),
+) {
+    /** Whether the update leaves out some features. */
+    val isIncomplete: Boolean
+        get() = lost.isNotEmpty() || missing.isNotEmpty()
+
+    companion object {
+        /**
+         * Compares the features of the [installed] build with the ones of an [update]. An update that doesn't describe
+         * its features (`null`) is considered complete.
+         */
+        fun between(
+            installed: PatchFeatures,
+            update: PatchFeatures?,
+        ): PatchFeatureChanges {
+            if (update == null) return PatchFeatureChanges()
+            val installedIds = installed.included.mapTo(HashSet()) { it.id }
+            val updateIds = update.included.mapTo(HashSet()) { it.id }
+            val (lost, missing) = update.missing.partition { it.id in installedIds }
+            return PatchFeatureChanges(
+                lost = lost,
+                missing = missing,
+                restored = installed.missing.filter { it.id in updateIds },
+            )
+        }
+    }
+}
+
+/**
+ * The tab whose menu is shown in the tab strip.
+ *
+ * @property id The id of the tab.
+ * @property isPrivate Whether it's a private tab.
+ */
+data class TabStripMenuTab(
+    val id: String,
+    val isPrivate: Boolean,
+)
+
+/**
+ * Entry point of an optional feature, which the code of the mandatory patches calls (see [all]): every optional patch
+ * defines an object implementing it, named after the patch (e.g. `TabGroupsFeature` for `0080-tab-groups.patch`).
+ *
+ * Optional features hook into Firefox only through these methods, so that each optional patch applies and compiles
+ * whichever other optional patches are left out. Every method does nothing unless the feature overrides it.
+ */
+interface PatchFeatureHooks {
+    /**
+     * Invoked when the main activity of Firefox is created (not for the tabs opened by other apps), e.g. to start the
+     * feature.
+     *
+     * @param activity The activity.
+     */
+    fun onActivityCreated(activity: HomeActivity) = Unit
+
+    /** Items the feature adds to the menu of [tab] in the tab strip (long press, or right click). */
+    fun tabStripMenuItems(tab: TabStripMenuTab): List<MenuItem> = emptyList()
+
+    /**
+     * Opens a new tab in place of Firefox, when the new tab button of the tab strip is tapped (or a keyboard shortcut
+     * asks for a new tab). Returns whether the feature opened it: if no feature does, Firefox opens it as usual.
+     *
+     * @param activity The activity showing the tab strip.
+     */
+    fun openNewTab(activity: HomeActivity): Boolean = false
+
+    /**
+     * Handles a key event of [activity] before the page and the rest of Firefox, e.g. a keyboard shortcut. Returns
+     * whether the feature handled it.
+     *
+     * @param activity The activity receiving the key event.
+     * @param event The key event.
+     */
+    fun onKeyEvent(
+        activity: HomeActivity,
+        event: KeyEvent,
+    ): Boolean = false
+
+    /** The keyboard shortcuts of the feature, listed by the keyboard shortcuts helper of Android (Meta+/). */
+    fun keyboardShortcuts(context: Context): List<KeyboardShortcutInfo> = emptyList()
+
+    /**
+     * Returns the window showing the main menu in place of the bottom sheet of Firefox (e.g. a dropdown), or `null` to
+     * keep the bottom sheet. The menu fragment sets its content in it.
+     *
+     * @param fragment The fragment of the menu.
+     * @param accessPoint Where the menu is opened from.
+     */
+    fun menuDialog(
+        fragment: DialogFragment,
+        accessPoint: MenuAccessPoint,
+    ): Dialog? = null
+
+    /**
+     * Items the feature adds at the top of the main menu, above the ones of Firefox.
+     *
+     * @param accessPoint Where the menu is opened from.
+     */
+    @Composable
+    fun MainMenuItems(accessPoint: MenuAccessPoint) = Unit
+
+    /**
+     * Adds the preferences of the feature to Settings → Customize, after the ones of Firefox.
+     *
+     * @param fragment The fragment of the settings, see [PreferenceFragmentCompat.getPreferenceScreen].
+     */
+    fun addCustomizationPreferences(fragment: PreferenceFragmentCompat) = Unit
+
+    companion object {
+        /** The entry points of the optional features included in this build. */
+        val all: List<PatchFeatureHooks>
+            get() = GeneratedPatchFeatures.hooks
+
+        /**
+         * Lets the optional features open a new tab (see [PatchFeatureHooks.openNewTab]) and returns whether one of
+         * them did.
+         *
+         * @param context A context of the activity showing the tab strip.
+         */
+        fun newTabOpened(context: Context): Boolean {
+            val activity = context.findHomeActivity() ?: return false
+            return all.any { it.openNewTab(activity) }
+        }
+
+        /** The window showing the main menu in place of the bottom sheet, see [PatchFeatureHooks.menuDialog]. */
+        fun customMenuDialog(
+            fragment: DialogFragment,
+            accessPoint: MenuAccessPoint,
+        ): Dialog? = all.firstNotNullOfOrNull { it.menuDialog(fragment, accessPoint) }
+
+        /** Lets the optional features handle a key event (see [PatchFeatureHooks.onKeyEvent]). */
+        fun keyEventHandled(
+            activity: HomeActivity,
+            event: KeyEvent,
+        ): Boolean = all.any { it.onKeyEvent(activity, event) }
+
+        /**
+         * The keyboard shortcuts of the optional features (see [PatchFeatureHooks.keyboardShortcuts]), grouped under
+         * the name of the app, or `null` if there are none.
+         */
+        fun keyboardShortcutGroup(context: Context): KeyboardShortcutGroup? {
+            val shortcuts = all.flatMap { it.keyboardShortcuts(context) }
+            if (shortcuts.isEmpty()) return null
+            return KeyboardShortcutGroup(context.getString(R.string.app_name), shortcuts)
+        }
+    }
+}
+
+private tailrec fun Context.findHomeActivity(): HomeActivity? =
+    when (this) {
+        is HomeActivity -> this
+        is ContextWrapper -> baseContext.findHomeActivity()
+        else -> null
+    }
