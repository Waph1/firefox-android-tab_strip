+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import mozilla.components.feature.tabgroups.storage.data.TabGroup
+import mozilla.components.feature.tabgroups.storage.data.TabGroupData
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TabGroupsTest {
+    private val work = group("work", tabIds = listOf("b", "d"))
+    private val news = group("news", tabIds = listOf("e"), closed = true)
+    private val data =
+        TabGroupData(
+            tabGroups = listOf(work, news),
+            tabGroupAssignments = mapOf("b" to "work", "d" to "work", "e" to "news"),
+        )
+    private val tabIds = listOf("a", "b", "c", "d", "e")
+
+    @Test
+    fun `WHEN arranging the tab strip THEN each group shows its label and its tabs together at its first tab`() {
+        val entries = groupedTabStrip(tabIds, data, collapsedGroupIds = emptySet(), selectedTabId = "a")
+
+        assertEquals(listOf(tab("a"), label(work), tab("b"), tab("d"), tab("c")), entries)
+    }
+
+    @Test
+    fun `GIVEN a collapsed group WHEN arranging the tab strip THEN only its label is shown`() {
+        val entries = groupedTabStrip(tabIds, data, collapsedGroupIds = setOf("work"), selectedTabId = "a")
+
+        assertEquals(listOf(tab("a"), label(work, isCollapsed = true), tab("c")), entries)
+    }
+
+    @Test
+    fun `GIVEN a tab of a collapsed or closed group is selected WHEN arranging the tab strip THEN it is shown`() {
+        assertEquals(
+            listOf(tab("a"), label(work, isCollapsed = true), tab("d"), tab("c")),
+            groupedTabStrip(tabIds, data, collapsedGroupIds = setOf("work"), selectedTabId = "d"),
+        )
+        assertEquals(
+            listOf(tab("a"), label(work), tab("b"), tab("d"), tab("c"), tab("e")),
+            groupedTabStrip(tabIds, data, collapsedGroupIds = emptySet(), selectedTabId = "e"),
+        )
+    }
+
+    @Test
+    fun `WHEN checking if a tab is hidden THEN the tabs of collapsed and closed groups are, except the selected one`() {
+        assertTrue(isTabHiddenByGroup("b", data, setOf("work"), selectedTabId = "a"))
+        assertFalse(isTabHiddenByGroup("b", data, setOf("work"), selectedTabId = "b"))
+        assertFalse(isTabHiddenByGroup("b", data, emptySet(), selectedTabId = "a"))
+        assertTrue(isTabHiddenByGroup("e", data, emptySet(), selectedTabId = "a"))
+        assertFalse(isTabHiddenByGroup("a", data, setOf("work"), selectedTabId = null))
+    }
+
+    @Test
+    fun `GIVEN the tabs of a group are apart WHEN keeping them together THEN they move after the first one`() {
+        assertEquals(listOf("d") to "b", tabGroupMove(tabIds, data))
+        // Already together, and the closed groups don't move.
+        assertNull(tabGroupMove(listOf("a", "b", "d", "c", "e"), data))
+        assertNull(tabGroupMove(listOf("e", "a", "b", "d"), data))
+    }
+
+    @Test
+    fun `WHEN leaving a group THEN the nearest tab after it is selected, otherwise the one before it`() {
+        val inWork = { id: String -> data.tabGroupAssignments[id] == "work" }
+
+        assertEquals("c", nearestTabOutside(tabIds, "b", inWork))
+        assertEquals("e", nearestTabOutside(tabIds, "d", inWork))
+        assertEquals("a", nearestTabOutside(listOf("a", "b", "d"), "d", inWork))
+        assertNull(nearestTabOutside(listOf("b", "d"), "b", inWork))
+    }
+
+    @Test
+    fun `WHEN estimating the width of a label THEN it grows with the title, up to a limit`() {
+        assertTrue(tabGroupLabelWidthDp("", isCollapsed = false) < tabGroupLabelWidthDp("Work", isCollapsed = false))
+        assertTrue(tabGroupLabelWidthDp("Work", isCollapsed = false) < tabGroupLabelWidthDp("Work", isCollapsed = true))
+        assertEquals(
+            tabGroupLabelWidthDp("A very long title for a group", isCollapsed = false),
+            tabGroupLabelWidthDp("A very long title for a group, longer", isCollapsed = false),
+        )
+    }
+
+    private fun tab(id: String) = GroupedTabStripEntry.Tab(id)
+
+    private fun label(
+        group: TabGroup,
+        isCollapsed: Boolean = false,
+    ) = GroupedTabStripEntry.Label(group, isCollapsed, tabCount = group.tabIds.size)
+
+    private fun group(
+        id: String,
+        tabIds: List<String>,
+        closed: Boolean = false,
+    ) = TabGroup(id = id, title = id, theme = "Blue", closed = closed, lastModified = 0, tabIds = tabIds)
+}
