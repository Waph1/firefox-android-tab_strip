+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import mozilla.components.feature.tabgroups.storage.data.TabGroup
+import mozilla.components.feature.tabgroups.storage.data.TabGroupData
+
+/** The most characters of a group title that the width of its label counts, see [tabGroupLabelWidthDp]. */
+private const val LABEL_MAX_COUNTED_CHARACTERS = 16
+
+/** What the tab strip shows with the tab groups, see [groupedTabStrip]. */
+internal sealed interface GroupedTabStripEntry {
+    /**
+     * A tab.
+     *
+     * @property id The id of the tab.
+     */
+    data class Tab(
+        val id: String,
+    ) : GroupedTabStripEntry
+
+    /**
+     * The label of a tab group, before its tabs.
+     *
+     * @property group The group.
+     * @property isCollapsed Whether the group is collapsed: its tabs are hidden.
+     * @property tabCount How many tabs the group has.
+     */
+    data class Label(
+        val group: TabGroup,
+        val isCollapsed: Boolean,
+        val tabCount: Int,
+    ) : GroupedTabStripEntry
+}
+
+/**
+ * Arranges the tab strip with the tab groups, like Chrome: each group shows its label in place of its first tab,
+ * followed by all its tabs unless it's collapsed. The groups closed in the tabs tray of Firefox don't show their tabs.
+ * The selected tab is always shown.
+ *
+ * @param tabIds The tabs of the tab strip, in order.
+ * @param data The tab groups and the group of each tab.
+ * @param collapsedGroupIds The groups collapsed in the tab strip.
+ * @param selectedTabId The selected tab.
+ */
+internal fun groupedTabStrip(
+    tabIds: List<String>,
+    data: TabGroupData,
+    collapsedGroupIds: Set<String>,
+    selectedTabId: String?,
+): List<GroupedTabStripEntry> {
+    val groupsById = data.tabGroups.associateBy { it.id }
+    val tabsByGroupId = tabIds.groupBy { data.tabGroupAssignments[it] }
+    val shownGroupIds = mutableSetOf<String>()
+    val entries = mutableListOf<GroupedTabStripEntry>()
+    for (tabId in tabIds) {
+        val group = data.tabGroupAssignments[tabId]?.let { groupsById[it] }
+        when {
+            group == null -> entries.add(GroupedTabStripEntry.Tab(tabId))
+            group.closed -> if (tabId == selectedTabId) entries.add(GroupedTabStripEntry.Tab(tabId))
+            group.id !in shownGroupIds -> {
+                shownGroupIds.add(group.id)
+                val groupTabIds = tabsByGroupId[group.id].orEmpty()
+                val isCollapsed = group.id in collapsedGroupIds
+                entries.add(GroupedTabStripEntry.Label(group, isCollapsed, groupTabIds.size))
+                groupTabIds
+                    .filter { !isCollapsed || it == selectedTabId }
+                    .forEach { entries.add(GroupedTabStripEntry.Tab(it)) }
+            }
+        }
+    }
+    return entries
+}
+
+/**
+ * Whether the tab with [tabId] is hidden in the tab strip by its group (see [groupedTabStrip]): it's in a collapsed
+ * group, or in a group closed in the tabs tray, and it isn't the selected tab.
+ */
+internal fun isTabHiddenByGroup(
+    tabId: String,
+    data: TabGroupData,
+    collapsedGroupIds: Set<String>,
+    selectedTabId: String?,
+): Boolean {
+    if (tabId == selectedTabId) return false
+    val groupId = data.tabGroupAssignments[tabId] ?: return false
+    val group = data.tabGroups.firstOrNull { it.id == groupId } ?: return false
+    return group.closed || group.id in collapsedGroupIds
+}
+
+/**
+ * Returns the first move that brings the tabs of an open group together, so that they stay together like in Chrome:
+ * the other tabs of the group go after its first tab, in their order. Returns the tabs to move and the tab to put them
+ * after, or `null` if the tabs of every group are already together.
+ *
+ * @param tabIds The tabs, in order.
+ * @param data The tab groups and the group of each tab.
+ */
+internal fun tabGroupMove(
+    tabIds: List<String>,
+    data: TabGroupData,
+): Pair<List<String>, String>? {
+    for (group in data.tabGroups) {
+        if (group.closed) continue
+        val indices = tabIds.indices.filter { data.tabGroupAssignments[tabIds[it]] == group.id }
+        if (indices.size > 1 && indices.last() - indices.first() != indices.lastIndex) {
+            val groupTabIds = indices.map { tabIds[it] }
+            return groupTabIds.drop(1) to groupTabIds.first()
+        }
+    }
+    return null
+}
+
+/**
+ * Returns the tab to select in place of [selectedTabId] when its group is collapsed or closed: the nearest tab after
+ * it that [isLeft] doesn't exclude, otherwise the nearest one before it; `null` if there is none.
+ *
+ * @param tabIds The tabs, in order.
+ * @param selectedTabId The selected tab.
+ * @param isLeft Whether a tab can't be selected (e.g. it's in the group, or hidden).
+ */
+internal fun nearestTabOutside(
+    tabIds: List<String>,
+    selectedTabId: String,
+    isLeft: (String) -> Boolean,
+): String? {
+    val index = tabIds.indexOf(selectedTabId)
+    return tabIds.drop(index + 1).firstOrNull { !isLeft(it) }
+        ?: tabIds.take(index.coerceAtLeast(0)).lastOrNull { !isLeft(it) }
+}
+
+/**
+ * About how wide the label of a group is in the tab strip, in dp: a dot for a group without title, otherwise its title
+ * (the number of tabs is added when the group is collapsed).
+ */
+internal fun tabGroupLabelWidthDp(
+    title: String,
+    isCollapsed: Boolean,
+): Int {
+    val dotOrTitle = if (title.isBlank()) 12 else 16 + 7 * title.length.coerceAtMost(LABEL_MAX_COUNTED_CHARACTERS)
+    return dotOrTitle + (if (isCollapsed) 16 else 0) + 8
+}
