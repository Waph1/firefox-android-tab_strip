+import androidx.compose.ui.input.pointer.PointerInputScope
+import androidx.compose.ui.input.pointer.isSecondaryPressed
+import androidx.compose.ui.input.pointer.pointerInput
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.semantics.contentDescription
+import androidx.compose.ui.semantics.semantics
+import androidx.compose.ui.semantics.stateDescription
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.text.style.TextOverflow
+import androidx.compose.ui.unit.dp
+import androidx.core.content.edit
+import androidx.navigation.findNavController
+import kotlinx.coroutines.MainScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.launch
+import mozilla.components.browser.state.selector.getNormalOrPrivateTabs
+import mozilla.components.browser.state.selector.normalTabs
+import mozilla.components.browser.state.selector.selectedTab
+import mozilla.components.compose.base.menu.DropdownMenu
+import mozilla.components.compose.base.menu.MenuItem
+import mozilla.components.compose.base.text.Text
+import mozilla.components.feature.tabgroups.storage.data.TabGroup
+import mozilla.components.feature.tabgroups.storage.data.TabGroupData
+import org.mozilla.fenix.HomeActivity
+import org.mozilla.fenix.R
+import org.mozilla.fenix.components.Components
+import org.mozilla.fenix.ext.components
+import org.mozilla.fenix.tabgroups.flow.TabGroupFlowEntryPoint
+import org.mozilla.fenix.tabgroups.flow.TabGroupFlowFragmentArgs
+import org.mozilla.fenix.tabstray.data.TabGroupTheme
+import org.mozilla.fenix.theme.FirefoxTheme
+import java.lang.ref.WeakReference
+
+private const val PREFERENCES_NAME = "chrome_tabstrip_tab_groups"
+private const val PREF_COLLAPSED = "collapsed"
+
+private val LabelHeight = 24.dp
+private val LabelMaxWidth = 160.dp
+private val DotSize = 12.dp
+private val GroupLineHeight = 2.dp
+
+/**
+ * Optional feature "tab groups in the tab strip" (`0080-tab-groups.patch`): the tab groups of Firefox (the ones of the
+ * tabs tray) show in the tab strip like in Chrome. Each group has a label with its color and title before its tabs,
+ * which are underlined with the color of the group and kept together; tapping the label collapses or expands the
+ * group, and its menu (long press or right click) edits, ungroups or closes it. The menu of a tab adds it to a group,
+ * or removes it from its group.
+ *
+ * Tab groups are turned on (unless the user turned them off in Settings → Tabs). The collapsed groups are remembered;
+ * a collapsed group expands when one of its tabs is selected, e.g. from the tabs tray.
+ */
+object TabGroupsFeature : PatchFeatureHooks {
+    private val scope = MainScope()
+    private val groupData = MutableStateFlow(TabGroupData())
+    private val collapsedGroupIds = MutableStateFlow(emptySet<String>())
+    private var preferences: SharedPreferences? = null
+    private var components: Components? = null
+    private var activity = WeakReference<HomeActivity>(null)
+
+    override fun onActivityCreated(activity: HomeActivity) {
+        this.activity = WeakReference(activity)
+        if (preferences != null) return
+        val components = activity.components
+        this.components = components
+        val preferences = activity.applicationContext.getSharedPreferences(PREFERENCES_NAME, Context.MODE_PRIVATE)
+        this.preferences = preferences
+        collapsedGroupIds.value = preferences.getStringSet(PREF_COLLAPSED, null).orEmpty().toSet()
+
+        // Like Chrome, tab groups are on, unless the user turned them off.
+        val settings = components.settings
+        if (!settings.preferences.contains(activity.getString(R.string.pref_key_tab_groups))) {
+            settings.tabGroupsEnabled = true
+        }
+
+        scope.launch {
+            components.core.tabGroupRepository.tabGroupDataFlow.collect { data ->
+                groupData.value = data
+                // The deleted groups are forgotten.
+                val groupIds = data.tabGroups.mapTo(HashSet()) { it.id }
+                collapsedGroupIds.value.filterTo(HashSet()) { it in groupIds }.let { saveCollapsed(it) }
+            }
+        }
+
+        val store = components.core.store
+        // The tabs of a group stay together, so that the tab strip and the keyboard shortcuts follow the same order.
+        scope.launch {
+            val tabIds = store.stateFlow.map { state -> state.normalTabs.map { it.id } }.distinctUntilChanged()
+            combine(tabIds, groupData) { ids, data -> if (settings.tabGroupsEnabled) tabGroupMove(ids, data) else null }
+                .distinctUntilChanged()
+                .collect { move ->
+                    move?.let { (tabIds, targetTabId) ->
+                        components.useCases.tabsUseCases.moveTabs(tabIds, targetTabId, placeAfter = true)
+                    }
+                }
+        }
+        // Like Chrome, a collapsed group expands when one of its tabs is selected.
+        scope.launch {
+            combine(store.stateFlow.map { it.selectedTabId }.distinctUntilChanged(), groupData) { tabId, data ->
+                tabId?.let { data.tabGroupAssignments[it] }
+            }.distinctUntilChanged()
+                .collect { groupId -> if (groupId != null) saveCollapsed(collapsedGroupIds.value - groupId) }
+        }
+    }
+
+    @Composable
+    override fun tabStripEntries(tabs: List<TabStripTabInfo>): List<TabStripEntry>? {
+        val context = LocalContext.current
+        val data by groupData.collectAsState()
+        val collapsed by collapsedGroupIds.collectAsState()
+        if (!context.components.settings.tabGroupsEnabled || data.tabGroups.isEmpty()) return null
+
+        val selectedTabId = tabs.firstOrNull { it.isSelected }?.id
+        return groupedTabStrip(tabs.map { it.id }, data, collapsed, selectedTabId).map { entry ->
+            when (entry) {
+                is GroupedTabStripEntry.Tab -> TabStripEntry.Tab(entry.id)
+                is GroupedTabStripEntry.Label ->
+                    TabStripEntry.Item(
+                        key = "tab-group:${entry.group.id}",
+                        width = tabGroupLabelWidthDp(entry.group.title, entry.isCollapsed).dp,
+                    ) {
+                        TabGroupLabel(entry)
+                    }
+            }
+        }
+    }
+
+    override fun isTabHidden(tabId: String): Boolean {
+        val components = components ?: return false
+        return components.settings.tabGroupsEnabled &&
+            isTabHiddenByGroup(
+                tabId,
+                groupData.value,
+                collapsedGroupIds.value,
+                components.core.store.state.selectedTabId,
+            )
+    }
+
+    @Composable
+    override fun TabStripTab(
+        tab: TabStripTabInfo,
+        actions: TabStripTabActions,
+        content: @Composable () -> Unit,
+    ) {
+        val data by groupData.collectAsState()
+        val group = if (tab.isPrivate) null else data.groupOf(tab.id)
+        val color = group?.theme?.toTabGroupTheme()?.primary ?: Color.Unspecified
+        val isShown = group != null && LocalContext.current.components.settings.tabGroupsEnabled
+        // The tabs of a group are underlined with its color.
+        Box(
+            modifier =
+                Modifier.drawWithContent {
+                    drawContent()
+                    if (isShown) {
+                        val height = GroupLineHeight.toPx()
+                        drawRect(color, topLeft = Offset(0f, size.height - height), size = Size(size.width, height))
+                    }
+                },
+            propagateMinConstraints = true,
+        ) {
+            content()
+        }
+    }
+
+    override fun tabStripMenuItems(tab: TabStripMenuTab): List<MenuItem> {
+        val components = components ?: return emptyList()
+        if (tab.isPrivate || !components.settings.tabGroupsEnabled) return emptyList()
+        val isInGroup = groupData.value.tabGroupAssignments[tab.id] != null
+        return listOfNotNull(
+            MenuItem.TextItem(text = Text.Resource(R.string.tabstrip_groups_add_tab)) {
+                openTabGroupFlow(TabGroupFlowEntryPoint.AddTabToGroup(tab.id))
+            },
+            if (isInGroup) {
+                MenuItem.TextItem(text = Text.Resource(R.string.tabstrip_groups_remove_tab)) {
+                    scope.launch { components.core.tabGroupRepository.deleteTabGroupAssignmentById(tab.id) }
+                }
+            } else {
+                null
+            },
+        )
+    }
+
+    /** Collapses or expands [group]; it doesn't collapse if no tab outside it can be selected in place of its own. */
+    private fun toggleCollapsed(group: TabGroup) {
+        val collapsed = collapsedGroupIds.value
+        if (group.id in collapsed) {
+            saveCollapsed(collapsed - group.id)
+        } else if (leaveGroup(group.id)) {
+            saveCollapsed(collapsed + group.id)
+        }
+    }
+
+    /** Closes [group] like the tabs tray does: it disappears from the tab strip, and reopens from the tabs tray. */
+    private fun closeGroup(group: TabGroup) {
+        val components = components ?: return
+        if (leaveGroup(group.id)) {
+            scope.launch { components.core.tabGroupRepository.closeTabGroup(group.id) }
+        }
+    }
+
+    /**
+     * If the selected tab is in the group with [groupId], selects the nearest shown tab outside it. Returns `false` if
+     * there is none.
+     */
+    private fun leaveGroup(groupId: String): Boolean {
+        val components = components ?: return false
+        val state = components.core.store.state
+        val selectedTab = state.selectedTab ?: return true
+        val data = groupData.value
+        if (data.tabGroupAssignments[selectedTab.id] != groupId) return true
+        val tabIds = state.getNormalOrPrivateTabs(selectedTab.content.private).map { it.id }
+        val tabId =
+            nearestTabOutside(tabIds, selectedTab.id) {
+                data.tabGroupAssignments[it] == groupId ||
+                    isTabHiddenByGroup(it, data, collapsedGroupIds.value, selectedTabId = null)
+            } ?: return false
+        components.useCases.tabsUseCases.selectTab(tabId)
+        return true
+    }
+
+    private fun ungroup(group: TabGroup) {
+        val components = components ?: return
+        scope.launch { components.core.tabGroupRepository.ungroupTabGroup(group.id) }
+    }
+
+    private fun openTabGroupFlow(entryPoint: TabGroupFlowEntryPoint) {
+        activity
+            .get()
+            ?.findNavController(R.id.container)
+            ?.navigate(R.id.tabGroupFlowFragment, TabGroupFlowFragmentArgs(entryPoint).toBundle())
+    }
+
+    private fun saveCollapsed(groupIds: Set<String>) {
+        if (groupIds == collapsedGroupIds.value) return
+        collapsedGroupIds.value = groupIds
+        preferences?.edit { putStringSet(PREF_COLLAPSED, groupIds) }
+    }
+
+    /** The label of a tab group in the tab strip, which collapses or expands the group and has its menu. */
+    @Composable
+    private fun TabGroupLabel(label: GroupedTabStripEntry.Label) {
+        val group = label.group
+        val theme = group.theme.toTabGroupTheme()
+        var isMenuShown by remember { mutableStateOf(false) }
+        val currentGroup by rememberUpdatedState(group)
+        val unnamed = stringResource(R.string.tabstrip_groups_unnamed)
+        val description = stringResource(R.string.tabstrip_groups_label_description, group.title.ifBlank { unnamed })
+        val state =
+            stringResource(
+                if (label.isCollapsed) R.string.tabstrip_groups_collapsed else R.string.tabstrip_groups_expanded,
+            )
+
+        Box(modifier = Modifier.fillMaxHeight().padding(horizontal = 4.dp), contentAlignment = Alignment.Center) {
+            Row(
+                modifier =
+                    Modifier.height(LabelHeight)
+                        .widthIn(max = LabelMaxWidth)
+                        .clip(RoundedCornerShape(8.dp))
+                        .pointerInput(Unit) { detectRightClicks { isMenuShown = true } }
+                        .combinedClickable(
+                            onClick = { toggleCollapsed(currentGroup) },
+                            onLongClick = { isMenuShown = true },
+                        )
+                        .then(
+                            if (group.title.isBlank()) Modifier else Modifier.background(theme.primary),
+                        )
+                        .semantics {
+                            contentDescription = description
+                            stateDescription = state
+                        }
+                        .padding(horizontal = if (group.title.isBlank()) 4.dp else 8.dp),
+                verticalAlignment = Alignment.CenterVertically,
+            ) {
+                if (group.title.isBlank()) {
+                    Box(modifier = Modifier.size(DotSize).clip(CircleShape).background(theme.primary))
+                } else {
+                    Text(
+                        text = group.title,
+                        color = theme.onPrimary,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                        style = FirefoxTheme.typography.caption.copy(fontWeight = FontWeight.Bold),
+                    )
+                }
+                if (label.isCollapsed) {
+                    Spacer(modifier = Modifier.width(4.dp))
+                    Text(
+                        text = label.tabCount.toString(),
+                        color = if (group.title.isBlank()) theme.primary else theme.onPrimary,
+                        maxLines = 1,
+                        style = FirefoxTheme.typography.caption,
+                    )
+                }
+            }
+
+            DropdownMenu(
+                menuItems =
+                    listOf(
+                        MenuItem.TextItem(text = Text.Resource(R.string.tabstrip_groups_edit)) {
+                            openTabGroupFlow(TabGroupFlowEntryPoint.EditGroup(currentGroup.id))
+                        },
+                        MenuItem.TextItem(text = Text.Resource(R.string.tabstrip_groups_ungroup)) {
+                            ungroup(currentGroup)
+                        },
+                        MenuItem.TextItem(text = Text.Resource(R.string.tabstrip_groups_close)) {
+                            closeGroup(currentGroup)
+                        },
+                    ),
+                expanded = isMenuShown,
+                onDismissRequest = { isMenuShown = false },
+            )
+        }
+    }
+}
+
+private fun TabGroupData.groupOf(tabId: String): TabGroup? =
+    tabGroupAssignments[tabId]?.let { groupId -> tabGroups.firstOrNull { it.id == groupId } }
+
+/** The theme of a group, stored like Firefox does (the name of the theme); an unknown one is the first theme. */
+private fun String.toTabGroupTheme(): TabGroupTheme =
+    TabGroupTheme.entries.firstOrNull { it.name == this } ?: TabGroupTheme.entries.first()
+
+/** Handles the clicks with the right button of a mouse before the other gestures, which don't get them. */
+private suspend fun PointerInputScope.detectRightClicks(onRightClick: () -> Unit) {
+    awaitEachGesture {
+        val down = awaitPointerEvent(PointerEventPass.Initial)
+        if (down.type != PointerEventType.Press || !down.buttons.isSecondaryPressed) return@awaitEachGesture
+        down.changes.forEach { it.consume() }
+        val up = waitForUpOrCancellation(PointerEventPass.Initial) ?: return@awaitEachGesture
+        up.consume()
+        onRightClick()
+    }
+}
