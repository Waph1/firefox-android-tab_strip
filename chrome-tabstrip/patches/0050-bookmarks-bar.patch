+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.patchfeatures
+
+import android.view.KeyEvent
+import mozilla.components.concept.storage.BookmarkNode
+import mozilla.components.concept.storage.BookmarkNodeType
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+private const val CTRL = KeyEvent.META_CTRL_ON or KeyEvent.META_CTRL_LEFT_ON
+private const val SHIFT = KeyEvent.META_SHIFT_ON or KeyEvent.META_SHIFT_LEFT_ON
+
+class BookmarksBarTest {
+    @Test
+    fun `WHEN listing the items of a folder THEN the bookmarks without an address are left out`() {
+        val bookmark = node("1", BookmarkNodeType.ITEM, url = "https://example.com")
+        val folder = node("2", BookmarkNodeType.FOLDER, children = emptyList())
+        val separator = node("3", BookmarkNodeType.SEPARATOR)
+        val noUrl = node("4", BookmarkNodeType.ITEM, url = " ")
+        val toolbar = node("toolbar", BookmarkNodeType.FOLDER, children = listOf(bookmark, noUrl, folder, separator))
+
+        assertEquals(listOf(bookmark, folder, separator), bookmarksBarItems(toolbar))
+        assertEquals(emptyList<BookmarkNode>(), bookmarksBarItems(null))
+        assertEquals(emptyList<BookmarkNode>(), bookmarksBarItems(node("5", BookmarkNodeType.FOLDER)))
+    }
+
+    @Test
+    fun `WHEN naming a bookmark THEN it is its title, or its address without title`() {
+        assertEquals("Example", bookmarkLabel(node("1", BookmarkNodeType.ITEM, title = "Example", url = "https://e.com")))
+        assertEquals("https://e.com", bookmarkLabel(node("1", BookmarkNodeType.ITEM, title = " ", url = "https://e.com")))
+        assertEquals("https://e.com", bookmarkLabel(node("1", BookmarkNodeType.ITEM, url = "https://e.com")))
+    }
+
+    @Test
+    fun `GIVEN items that fit WHEN laying out the bookmarks toolbar THEN all are shown without the overflow button`() {
+        assertEquals(3, visibleBookmarksCount(listOf(30, 30, 30), 100, overflowButtonWidth = 40, spacing = 5))
+        assertEquals(0, visibleBookmarksCount(emptyList(), 100, overflowButtonWidth = 40, spacing = 5))
+    }
+
+    @Test
+    fun `GIVEN too many items WHEN laying out the bookmarks toolbar THEN the overflow button takes room at the end`() {
+        // 30 + 5 + 30 + 5 + 30 = 100 > 99: the overflow button leaves 99 - 40 - 5 = 54 for the items.
+        assertEquals(1, visibleBookmarksCount(listOf(30, 30, 30), 99, overflowButtonWidth = 40, spacing = 5))
+        assertEquals(2, visibleBookmarksCount(listOf(20, 20, 30, 10), 80, overflowButtonWidth = 10, spacing = 5))
+        // Not even the first one fits.
+        assertEquals(0, visibleBookmarksCount(listOf(80, 10), 85, overflowButtonWidth = 40, spacing = 5))
+    }
+
+    @Test
+    fun `WHEN pressing Ctrl+Shift+B THEN it is the shortcut of the bookmarks toolbar`() {
+        assertTrue(isBookmarksBarShortcut(KeyEvent.KEYCODE_B, CTRL or SHIFT))
+        assertFalse(isBookmarksBarShortcut(KeyEvent.KEYCODE_B, CTRL))
+        assertFalse(isBookmarksBarShortcut(KeyEvent.KEYCODE_B, SHIFT))
+        assertFalse(isBookmarksBarShortcut(KeyEvent.KEYCODE_B, CTRL or SHIFT or KeyEvent.META_ALT_ON))
+        assertFalse(isBookmarksBarShortcut(KeyEvent.KEYCODE_N, CTRL or SHIFT))
+    }
+
+    private fun node(
+        guid: String,
+        type: BookmarkNodeType,
+        title: String? = null,
+        url: String? = null,
+        children: List<BookmarkNode>? = null,
+    ) = BookmarkNode(
+        type = type,
+        guid = guid,
+        parentGuid = null,
+        position = null,
+        title = title,
+        url = url,
+        dateAdded = 0,
+        lastModified = 0,
+        children = children,
+    )
+}
