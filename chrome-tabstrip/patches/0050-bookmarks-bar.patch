+package org.mozilla.fenix.patchfeatures
+
+import android.view.KeyEvent
+import mozilla.components.concept.storage.BookmarkNode
+import mozilla.components.concept.storage.BookmarkNodeType
+
+/** The height of the bookmarks toolbar, in dp. */
+internal const val BOOKMARKS_BAR_HEIGHT_DP = 40
+
+/** How a bookmark of the bookmarks toolbar is opened. */
+internal enum class BookmarkOpening {
+    /** In the current tab (a tap or a click); from the homepage, like the bookmarks of the homepage. */
+    CURRENT_TAB,
+
+    /** In a new tab, which is shown (menu of the bookmark). */
+    NEW_TAB,
+
+    /** In a new tab left in the background (Ctrl and click, or middle click), like in Firefox for desktop. */
+    BACKGROUND_TAB,
+
+    /** In a new private tab, which is shown (menu of the bookmark). */
+    PRIVATE_TAB,
+}
+
+/**
+ * The bookmarks, folders and separators that the bookmarks toolbar (or one of its menus) shows from [folder], in
+ * order: the bookmarks without an address are left out.
+ */
+internal fun bookmarksBarItems(folder: BookmarkNode?): List<BookmarkNode> =
+    folder?.children.orEmpty().filter { it.type != BookmarkNodeType.ITEM || !it.url.isNullOrBlank() }
+
+/** The text that names [bookmark]: its title, or its address if it has no title. */
+internal fun bookmarkLabel(bookmark: BookmarkNode): String =
+    bookmark.title?.takeIf { it.isNotBlank() } ?: bookmark.url.orEmpty()
+
+/**
+ * Returns how many items of the bookmarks toolbar fit in it, from the first one: when they don't all fit, the » button
+ * takes room at the end and shows the others.
+ *
+ * @param itemWidths The width of each item.
+ * @param availableWidth The width of the bookmarks toolbar.
+ * @param overflowButtonWidth The width of the » button.
+ * @param spacing The space between two items, and between the last one and the » button.
+ */
+internal fun visibleBookmarksCount(
+    itemWidths: List<Int>,
+    availableWidth: Int,
+    overflowButtonWidth: Int,
+    spacing: Int,
+): Int {
+    val totalWidth = itemWidths.sum() + spacing * (itemWidths.size - 1).coerceAtLeast(0)
+    if (totalWidth <= availableWidth) return itemWidths.size
+
+    val room = availableWidth - overflowButtonWidth - spacing
+    var usedWidth = 0
+    var count = 0
+    for (width in itemWidths) {
+        val newWidth = usedWidth + width + if (count > 0) spacing else 0
+        if (newWidth > room) break
+        usedWidth = newWidth
+        count++
+    }
+    return count
+}
+
+/**
+ * Whether a key pressed with the given modifiers is Ctrl+Shift+B, which shows or hides the bookmarks toolbar like in
+ * Firefox for desktop.
+ *
+ * @param keyCode The key, see [KeyEvent.getKeyCode].
+ * @param metaState The modifiers, see [KeyEvent.getMetaState].
+ */
+internal fun isBookmarksBarShortcut(
+    keyCode: Int,
+    metaState: Int,
+): Boolean {
+    val modifiers = KeyEvent.META_CTRL_ON or KeyEvent.META_SHIFT_ON or KeyEvent.META_ALT_ON or KeyEvent.META_META_ON
+    return keyCode == KeyEvent.KEYCODE_B &&
+        (metaState and modifiers) == (KeyEvent.META_CTRL_ON or KeyEvent.META_SHIFT_ON)
+}
