+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.collectLatest
+import kotlinx.coroutines.flow.onStart
+import kotlinx.coroutines.launch
+import mozilla.appservices.places.BookmarkRoot
+import mozilla.components.concept.engine.EngineSession.LoadUrlFlags
+import mozilla.components.concept.engine.EngineSession.LoadUrlFlags.Companion.ALLOW_JAVASCRIPT_URL
+import mozilla.components.concept.storage.BookmarkNode
+import mozilla.components.lib.state.ext.observeAsComposableState
+import mozilla.components.service.fxa.sync.SyncStatusObserver
+import org.mozilla.fenix.BrowserDirection
+import org.mozilla.fenix.HomeActivity
+import org.mozilla.fenix.NavGraphDirections
+import org.mozilla.fenix.R
+import org.mozilla.fenix.browser.tabstrip.AdaptiveTabStrip
+import org.mozilla.fenix.components.appstate.AppAction.SearchAction.SearchEnded
+import org.mozilla.fenix.ext.components
+import kotlin.math.roundToInt
+
+private const val PREFERENCES_NAME = "chrome_tabstrip_bookmarks_bar"
+private const val PREF_IS_SHOWN = "is_shown"
+
+/**
+ * Optional feature "bookmarks toolbar" (`0050-bookmarks-bar.patch`): on large screens (the ones showing the tab strip)
+ * a row next to the address bar of the pages and of the homepage shows the bookmarks of the "Bookmarks Toolbar"
+ * folder, the one of the bookmarks toolbar of Firefox for desktop (synced with Sync), like on the desktop: the folders
+ * open in menus, and the bookmarks that don't fit go in a » menu.
+ *
+ * A bookmark opens in the current tab, or in a new tab in the background with Ctrl or the middle button of the mouse;
+ * a long press (or a right click) shows its menu. The bookmarks toolbar is shown or hidden in Settings → Customize, or
+ * with Ctrl+Shift+B. It reads the bookmarks again when it's shown and after each sync.
+ */
+object BookmarksBarFeature : PatchFeatureHooks {
+    private val scope = MainScope()
+
+    /** Whether the user shows the bookmarks toolbar (the default), read once the feature starts. */
+    private val isBarShown = MutableStateFlow(false)
+
+    /** The "Bookmarks Toolbar" folder with all its bookmarks, or `null` until it's read. */
+    private val toolbarFolder = MutableStateFlow<BookmarkNode?>(null)
+    private val refreshRequests = MutableSharedFlow<Unit>(
+        extraBufferCapacity = 1,
+        onBufferOverflow = BufferOverflow.DROP_OLDEST,
+    )
+    private var preferences: SharedPreferences? = null
+
+    override fun onActivityCreated(activity: HomeActivity) {
+        // The bookmarks may change with each sync. Like Firefox, wait for the accounts to be ready.
+        val backgroundServices = activity.components.backgroundServices
+        backgroundServices.accountManagerAvailableQueue.runIfReadyOrQueue {
+            activity.lifecycleScope.launch {
+                backgroundServices.accountManager.registerForSyncEvents(
+                    object : SyncStatusObserver {
+                        override fun onStarted() = Unit
+
+                        override fun onIdle() = refresh()
+
+                        override fun onError(error: Exception?) = Unit
+                    },
+                    owner = activity,
+                    autoPause = false,
+                )
+            }
+        }
+
+        if (preferences != null) return
+        val preferences = activity.applicationContext.getSharedPreferences(PREFERENCES_NAME, Context.MODE_PRIVATE)
+        this.preferences = preferences
+        isBarShown.value = preferences.getBoolean(PREF_IS_SHOWN, true)
+
+        val bookmarksStorage = activity.components.core.bookmarksStorage
+        scope.launch {
+            // Also reads them right away: the requests made before don't wait for the first reading.
+            refreshRequests.onStart { emit(Unit) }.collectLatest {
+                bookmarksStorage.getTree(BookmarkRoot.Toolbar.id, recursive = true).getOrNull()?.let {
+                    toolbarFolder.value = it
+                }
+            }
+        }
+    }
+
+    override fun onKeyEvent(
+        activity: HomeActivity,
+        event: KeyEvent,
+    ): Boolean {
+        if (!isBookmarksBarShortcut(event.keyCode, event.metaState) || !AdaptiveTabStrip.isTabStripAllowed) {
+            return false
+        }
+        if (event.action == KeyEvent.ACTION_DOWN && event.repeatCount == 0) setBarShown(!isBarShown.value)
+        return true
+    }
+
+    override fun keyboardShortcuts(context: Context): List<KeyboardShortcutInfo> =
+        listOf(
+            KeyboardShortcutInfo(
+                context.getString(R.string.bookmarks_bar_shortcut),
+                KeyEvent.KEYCODE_B,
+                KeyEvent.META_CTRL_ON or KeyEvent.META_SHIFT_ON,
+            ),
+        )
+
+    override fun addCustomizationPreferences(fragment: PreferenceFragmentCompat) {
+        val context = fragment.requireContext()
+        val category =
+            PreferenceCategory(context).apply {
+                title = context.getString(R.string.bookmarks_bar_preferences_category)
+                isIconSpaceReserved = false
+            }
+        fragment.preferenceScreen.addPreference(category)
+        category.addPreference(
+            SwitchPreferenceCompat(context).apply {
+                isPersistent = false
+                isIconSpaceReserved = false
+                title = context.getString(R.string.bookmarks_bar_preference_title)
+                summary = context.getString(R.string.bookmarks_bar_preference_summary)
+                isChecked = isBarShown.value
+                setOnPreferenceChangeListener { _, newValue ->
+                    setBarShown(newValue as Boolean)
+                    true
+                }
+            },
+        )
+    }
+
+    @Composable
+    override fun AddressBarRow(isHomepage: Boolean) {
+        val isShown by isBarShown.collectAsState()
+        if (!isShown || !AdaptiveTabStrip.isTabStripAllowed) return
+
+        val context = LocalContext.current
+        val lifecycleOwner = LocalLifecycleOwner.current
+        LaunchedEffect(lifecycleOwner) {
+            lifecycleOwner.repeatOnLifecycle(Lifecycle.State.RESUMED) { refresh() }
+        }
+        val folder by toolbarFolder.collectAsState()
+        val mode by context.components.appStore.observeAsComposableState { it.mode }
+
+        BookmarksBar(
+            folder = folder,
+            isPrivate = mode.isPrivate,
+            actions =
+                BookmarksBarActions(
+                    onOpen = { bookmark, opening -> open(context, bookmark, opening, isHomepage) },
+                    onEdit = { edit(context, it) },
+                    onDelete = { delete(context, it) },
+                ),
+        )
+    }
+
+    override fun addressBarRowHeight(context: Context): Int =
+        if (isBarShown.value && AdaptiveTabStrip.isTabStripAllowed) {
+            (BOOKMARKS_BAR_HEIGHT_DP * context.resources.displayMetrics.density).roundToInt()
+        } else {
+            0
+        }
+
+    private fun refresh() {
+        refreshRequests.tryEmit(Unit)
+    }
+
+    private fun setBarShown(isShown: Boolean) {
+        if (isBarShown.value == isShown) return
+        isBarShown.value = isShown
+        preferences?.edit { putBoolean(PREF_IS_SHOWN, isShown) }
+        PatchFeatureHooks.onAddressBarRowsChanged()
+    }
+
+    private fun open(
+        context: Context,
+        bookmark: BookmarkNode,
+        opening: BookmarkOpening,
+        isHomepage: Boolean,
+    ) {
+        val url = bookmark.url ?: return
+        val activity = context.findHomeActivity() ?: return
+        val components = activity.components
+        val isPrivate = components.appStore.state.mode.isPrivate
+        // Like the bookmarks of the homepage, which may be bookmarklets.
+        val flags = LoadUrlFlags.select(ALLOW_JAVASCRIPT_URL)
+        if (opening == BookmarkOpening.BACKGROUND_TAB) {
+            components.useCases.tabsUseCases.addTab(url = url, selectTab = false, flags = flags, private = isPrivate)
+            return
+        }
+
+        endSearch(activity)
+        activity.openToBrowser(if (isHomepage) BrowserDirection.FromHome else BrowserDirection.FromGlobal)
+        components.useCases.fenixBrowserUseCases.loadUrlOrSearch(
+            searchTermOrURL = url,
+            // From the homepage, like its bookmarks: in its tab when the homepage is a tab, otherwise in a new tab.
+            newTab =
+                opening != BookmarkOpening.CURRENT_TAB ||
+                    (isHomepage && !components.settings.enableHomepageAsNewTab),
+            private = isPrivate || opening == BookmarkOpening.PRIVATE_TAB,
+            flags = flags,
+        )
+    }
+
+    private fun edit(
+        context: Context,
+        bookmark: BookmarkNode,
+    ) {
+        val activity = context.findHomeActivity() ?: return
+        endSearch(activity)
+        activity
+            .findNavController(R.id.container)
+            .navigate(
+                NavGraphDirections.actionGlobalBookmarkEditFragment(
+                    guidToEdit = bookmark.guid,
+                    requiresSnackbarPaddingForToolbar = true,
+                ),
+            )
+    }
+
+    private fun delete(
+        context: Context,
+        bookmark: BookmarkNode,
+    ) {
+        val bookmarksStorage = context.components.core.bookmarksStorage
+        scope.launch {
+            bookmarksStorage.deleteNode(bookmark.guid)
+            refresh()
+        }
+    }
+
+    /** Leaves the address bar if the user is typing in it, as the page changes. */
+    private fun endSearch(activity: HomeActivity) {
+        val appStore = activity.components.appStore
+        if (appStore.state.searchState.isSearchActive) appStore.dispatch(SearchEnded)
+    }
+}
