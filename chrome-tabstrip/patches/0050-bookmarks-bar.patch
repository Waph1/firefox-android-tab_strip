+import org.mozilla.fenix.theme.FirefoxTheme
+
+private val ItemHeight = 32.dp
+private val ItemMaxWidth = 180.dp
+private val ItemSpacing = 2.dp
+private val ItemShape = RoundedCornerShape(8.dp)
+private val OverflowButtonWidth = 40.dp
+private val IconSize = 16.dp
+private val MenuMaxWidth = 320.dp
+
+/** The slot of the » button in the layout of the bookmarks toolbar (the other slots are the guids of the items). */
+private object OverflowButtonSlot
+
+/**
+ * What the bookmarks toolbar does with the bookmarks.
+ *
+ * @property onOpen Opens a bookmark.
+ * @property onEdit Opens the bookmark editor of Firefox for a bookmark.
+ * @property onDelete Deletes a bookmark.
+ */
+internal data class BookmarksBarActions(
+    val onOpen: (BookmarkNode, BookmarkOpening) -> Unit,
+    val onEdit: (BookmarkNode) -> Unit,
+    val onDelete: (BookmarkNode) -> Unit,
+)
+
+/**
+ * The bookmarks toolbar: the bookmarks, folders and separators of [folder] in a row, with a » menu for the ones that
+ * don't fit, or a hint when the folder is empty. It's [BOOKMARKS_BAR_HEIGHT_DP] high.
+ *
+ * @param folder The "Bookmarks Toolbar" folder with all its bookmarks, or `null` while it's read.
+ * @param isPrivate Whether the browser is in private mode (for the icons of the sites).
+ * @param actions What the bookmarks toolbar does with the bookmarks.
+ */
+@Composable
+internal fun BookmarksBar(
+    folder: BookmarkNode?,
+    isPrivate: Boolean,
+    actions: BookmarksBarActions,
+) {
+    Box(
+        modifier =
+            Modifier.fillMaxWidth()
+                .height(BOOKMARKS_BAR_HEIGHT_DP.dp)
+                .background(MaterialTheme.colorScheme.surface)
+                .padding(horizontal = 8.dp),
+        contentAlignment = Alignment.CenterStart,
+    ) {
+        val items = bookmarksBarItems(folder)
+        when {
+            folder == null -> Unit
+            items.isEmpty() ->
+                Text(
+                    text = stringResource(R.string.bookmarks_bar_empty),
+                    modifier = Modifier.padding(horizontal = 8.dp),
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                    style = FirefoxTheme.typography.caption,
+                )
+            else -> BookmarksBarItems(items = items, isPrivate = isPrivate, actions = actions)
+        }
+    }
+}
+
+/** The items of the bookmarks toolbar that fit, from the first one, and the » button with the others. */
+@Composable
+private fun BookmarksBarItems(
+    items: List<BookmarkNode>,
+    isPrivate: Boolean,
+    actions: BookmarksBarActions,
+) {
+    SubcomposeLayout(modifier = Modifier.fillMaxSize()) { constraints ->
+        val height = constraints.maxHeight
+        val itemConstraints = Constraints(maxWidth = ItemMaxWidth.roundToPx(), maxHeight = height)
+        val placeables =
+            items.map { item ->
+                subcompose(item.guid) { BookmarksBarItem(item, isPrivate, actions) }.first().measure(itemConstraints)
+            }
+        val spacing = ItemSpacing.roundToPx()
+        val overflowButtonWidth = OverflowButtonWidth.roundToPx()
+        val count =
+            visibleBookmarksCount(placeables.map { it.width }, constraints.maxWidth, overflowButtonWidth, spacing)
+        val overflowButton =
+            if (count < items.size) {
+                subcompose(OverflowButtonSlot) { OverflowButton(items.drop(count), isPrivate, actions) }
+                    .first()
+                    .measure(Constraints.fixed(overflowButtonWidth, ItemHeight.roundToPx()))
+            } else {
+                null
+            }
+
+        layout(constraints.maxWidth, height) {
+            var x = 0
+            placeables.take(count).forEach {
+                it.placeRelative(x, (height - it.height) / 2)
+                x += it.width + spacing
+            }
+            overflowButton?.let { it.placeRelative(constraints.maxWidth - it.width, (height - it.height) / 2) }
+        }
+    }
+}
+
+/** A bookmark, folder or separator of the bookmarks toolbar. */
+@Composable
+private fun BookmarksBarItem(
+    item: BookmarkNode,
+    isPrivate: Boolean,
+    actions: BookmarksBarActions,
+) {
+    when (item.type) {
+        BookmarkNodeType.SEPARATOR ->
+            Box(
+                modifier = Modifier.height(ItemHeight).padding(horizontal = 4.dp),
+                contentAlignment = Alignment.Center,
+            ) {
+                VerticalDivider(
+                    modifier = Modifier.height(IconSize + 4.dp),
+                    color = MaterialTheme.colorScheme.outlineVariant,
+                )
+            }
+
+        BookmarkNodeType.FOLDER -> {
+            var isMenuShown by remember { mutableStateOf(false) }
+            Box {
+                BookmarkButton(
+                    title = item.title.orEmpty(),
+                    icon = { FolderIcon() },
+                    onClick = { isMenuShown = true },
+                )
+                BookmarksMenu(
+                    items = bookmarksBarItems(item),
+                    expanded = isMenuShown,
+                    isPrivate = isPrivate,
+                    actions = actions,
+                    onDismissRequest = { isMenuShown = false },
+                    onBookmarkOpened = { isMenuShown = false },
+                )
+            }
+        }
+
+        BookmarkNodeType.ITEM -> {
+            var isMenuShown by remember { mutableStateOf(false) }
+            Box {
+                BookmarkButton(
+                    title = item.title.orEmpty(),
+                    description = bookmarkLabel(item),
+                    icon = { Favicon(url = item.url.orEmpty(), size = IconSize, isPrivate = isPrivate) },
+                    onClick = { isCtrlPressed ->
+                        val opening = if (isCtrlPressed) BookmarkOpening.BACKGROUND_TAB else BookmarkOpening.CURRENT_TAB
+                        actions.onOpen(item, opening)
+                    },
+                    onMiddleClick = { actions.onOpen(item, BookmarkOpening.BACKGROUND_TAB) },
+                    onContextMenu = { isMenuShown = true },
+                )
+                AcornDropdownMenu(
+                    menuItems =
+                        listOf(
+                            MenuItem.TextItem(text = Text.Resource(R.string.bookmarks_bar_open_in_new_tab)) {
+                                actions.onOpen(item, BookmarkOpening.NEW_TAB)
+                            },
+                            MenuItem.TextItem(text = Text.Resource(R.string.bookmarks_bar_open_in_private_tab)) {
+                                actions.onOpen(item, BookmarkOpening.PRIVATE_TAB)
+                            },
+                            MenuItem.TextItem(text = Text.Resource(R.string.bookmarks_bar_edit)) {
+                                actions.onEdit(item)
+                            },
+                            MenuItem.TextItem(
+                                text = Text.Resource(R.string.bookmarks_bar_delete),
+                                level = MenuItem.FixedItem.Level.Critical,
+                            ) {
+                                actions.onDelete(item)
+                            },
+                        ),
+                    expanded = isMenuShown,
+                    onDismissRequest = { isMenuShown = false },
+                )
+            }
+        }
+    }
+}
+
+/**
+ * A bookmark or a folder in the bookmarks toolbar: its icon and its title, if it has one (like on the desktop, a
+ * bookmark without title shows only the icon of the site).
+ *
+ * @param title The title of the bookmark or folder.
+ * @param icon The icon of the site, or of the folder.
+ * @param onClick Invoked when it's tapped or clicked, with whether Ctrl was pressed.
+ * @param description What the screen readers say for a bookmark without title.
+ * @param onMiddleClick Invoked when it's clicked with the middle button of the mouse.
+ * @param onContextMenu Invoked to show its menu, with a long press or a right click.
+ */
+@Composable
+private fun BookmarkButton(
+    title: String,
+    icon: @Composable () -> Unit,
+    onClick: (isCtrlPressed: Boolean) -> Unit,
+    description: String = title,
+    onMiddleClick: (() -> Unit)? = null,
+    onContextMenu: (() -> Unit)? = null,
+) {
+    val press = remember { BookmarkPress() }
+    val currentOnMiddleClick by rememberUpdatedState(onMiddleClick)
+    val currentOnContextMenu by rememberUpdatedState(onContextMenu)
+    Row(
+        modifier =
+            Modifier.height(ItemHeight)
+                .widthIn(max = ItemMaxWidth)
+                .clip(ItemShape)
+                .pointerInput(press) {
+                    detectMouseClicks(
+                        press = press,
+                        onMiddleClick = { currentOnMiddleClick?.invoke() },
+                        onRightClick = { currentOnContextMenu?.invoke() },
+                    )
+                }
+                .combinedClickable(onClick = { onClick(press.isCtrlPressed) }, onLongClick = onContextMenu)
+                .semantics { if (title.isEmpty()) contentDescription = description }
+                .padding(horizontal = 8.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        icon()
+        if (title.isNotEmpty()) {
+            Spacer(modifier = Modifier.width(8.dp))
+            Text(
+                text = title,
+                color = MaterialTheme.colorScheme.onSurface,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+                style = FirefoxTheme.typography.body2,
+            )
+        }
+    }
+}
+
+/** The » button of the bookmarks toolbar, with the menu of the [items] that don't fit in it. */
+@Composable
+private fun OverflowButton(
+    items: List<BookmarkNode>,
+    isPrivate: Boolean,
+    actions: BookmarksBarActions,
+) {
+    var isMenuShown by remember { mutableStateOf(false) }
+    val description = stringResource(R.string.bookmarks_bar_more)
+    Box(
+        modifier =
+            Modifier.size(OverflowButtonWidth, ItemHeight)
+                .clip(ItemShape)
+                .clickable { isMenuShown = true }
+                .semantics { contentDescription = description },
+        contentAlignment = Alignment.Center,
+    ) {
+        Text(text = "»", color = MaterialTheme.colorScheme.onSurface, style = FirefoxTheme.typography.headline7)
+        BookmarksMenu(
+            items = items,
+            expanded = isMenuShown,
+            isPrivate = isPrivate,
+            actions = actions,
+            onDismissRequest = { isMenuShown = false },
+            onBookmarkOpened = { isMenuShown = false },
+        )
+    }
+}
+
+/**
+ * The menu of a folder (or of the » button) with its [items]: its subfolders open in menus next to it.
+ *
+ * @param items The bookmarks, folders and separators of the menu.
+ * @param expanded Whether the menu is shown.
+ * @param isPrivate Whether the browser is in private mode (for the icons of the sites).
+ * @param actions What the bookmarks toolbar does with the bookmarks.
+ * @param onDismissRequest Invoked to close the menu.
+ * @param onBookmarkOpened Invoked when a bookmark is opened from the menu or a submenu, to close all of them.
+ * @param offset Where the menu is shown, from the bottom of its anchor.
+ */
+@Composable
+private fun BookmarksMenu(
+    items: List<BookmarkNode>,
+    expanded: Boolean,
+    isPrivate: Boolean,
+    actions: BookmarksBarActions,
+    onDismissRequest: () -> Unit,
+    onBookmarkOpened: () -> Unit,
+    offset: DpOffset = DpOffset(0.dp, 0.dp),
+) {
+    DropdownMenu(
+        expanded = expanded,
+        onDismissRequest = onDismissRequest,
+        modifier = Modifier.widthIn(max = MenuMaxWidth),
+        offset = offset,
+        shape = MaterialTheme.shapes.large,
+        containerColor = MaterialTheme.colorScheme.surfaceBright,
+    ) {
+        if (items.isEmpty()) {
+            DropdownMenuItem(
+                text = { MenuText(stringResource(R.string.bookmarks_bar_empty_folder)) },
+                onClick = {},
+                enabled = false,
+            )
+        }
+        items.forEach { item ->
+            when (item.type) {
+                BookmarkNodeType.SEPARATOR -> HorizontalDivider(modifier = Modifier.padding(vertical = 4.dp))
+                BookmarkNodeType.FOLDER -> BookmarksSubmenu(item, isPrivate, actions, onBookmarkOpened)
+                BookmarkNodeType.ITEM -> BookmarksMenuItem(item, isPrivate, actions, onBookmarkOpened)
+            }
+        }
+    }
+}
+
+/** A folder in a menu of the bookmarks toolbar, which opens its menu next to it. */
+@Composable
+private fun BookmarksSubmenu(
+    folder: BookmarkNode,
+    isPrivate: Boolean,
+    actions: BookmarksBarActions,
+    onBookmarkOpened: () -> Unit,
+) {
+    var isMenuShown by remember { mutableStateOf(false) }
+    var width by remember { mutableIntStateOf(0) }
+    var height by remember { mutableIntStateOf(0) }
+    val density = LocalDensity.current
+    Box(
+        modifier =
+            Modifier.onSizeChanged {
+                width = it.width
+                height = it.height
+            },
+    ) {
+        DropdownMenuItem(
+            text = { MenuText(folder.title.orEmpty()) },
+            onClick = { isMenuShown = true },
+            leadingIcon = { FolderIcon() },
+            trailingIcon = {
+                Icon(painter = painterResource(iconsR.drawable.mozac_ic_chevron_right_16), contentDescription = null)
+            },
+        )
+        BookmarksMenu(
+            items = bookmarksBarItems(folder),
+            expanded = isMenuShown,
+            isPrivate = isPrivate,
+            actions = actions,
+            onDismissRequest = { isMenuShown = false },
+            onBookmarkOpened = onBookmarkOpened,
+            // Next to the folder, like the menus of the desktop.
+            offset = with(density) { DpOffset(width.toDp(), -height.toDp()) },
+        )
+    }
+}
+
+/** A bookmark in a menu of the bookmarks toolbar. */
+@Composable
+private fun BookmarksMenuItem(
+    bookmark: BookmarkNode,
+    isPrivate: Boolean,
+    actions: BookmarksBarActions,
+    onBookmarkOpened: () -> Unit,
+) {
+    val press = remember { BookmarkPress() }
+    val currentBookmark by rememberUpdatedState(bookmark)
+    val currentActions by rememberUpdatedState(actions)
+    val currentOnBookmarkOpened by rememberUpdatedState(onBookmarkOpened)
+    val open = { opening: BookmarkOpening ->
+        currentOnBookmarkOpened()
+        currentActions.onOpen(currentBookmark, opening)
+    }
+    DropdownMenuItem(
+        text = { MenuText(bookmarkLabel(bookmark)) },
+        onClick = {
+            open(if (press.isCtrlPressed) BookmarkOpening.BACKGROUND_TAB else BookmarkOpening.CURRENT_TAB)
+        },
+        modifier =
+            Modifier.pointerInput(press) {
+                detectMouseClicks(
+                    press = press,
+                    onMiddleClick = { open(BookmarkOpening.BACKGROUND_TAB) },
+                    onRightClick = {},
+                )
+            },
+        leadingIcon = { Favicon(url = bookmark.url.orEmpty(), size = IconSize, isPrivate = isPrivate) },
+    )
+}
+
+@Composable
+private fun MenuText(text: String) {
+    Text(text = text, maxLines = 1, overflow = TextOverflow.Ellipsis, style = FirefoxTheme.typography.subtitle1)
+}
+
+@Composable
+private fun FolderIcon() {
+    Icon(
+        painter = painterResource(iconsR.drawable.mozac_ic_folder_24),
+        contentDescription = null,
+        modifier = Modifier.size(IconSize),
+        tint = MaterialTheme.colorScheme.onSurface,
+    )
+}
+
+/** Whether Ctrl was pressed with the last press on a bookmark, read when the bookmark is clicked. */
+private class BookmarkPress {
+    var isCtrlPressed = false
+}
+
+/**
+ * Handles the clicks with the middle and the right button of a mouse, before the other gestures (which don't get
+ * them), and remembers in [press] whether Ctrl is pressed with the other presses.
+ */
+private suspend fun PointerInputScope.detectMouseClicks(
+    press: BookmarkPress,
+    onMiddleClick: () -> Unit,
+    onRightClick: () -> Unit,
+) {
+    awaitEachGesture {
+        val down = awaitPointerEvent(PointerEventPass.Initial)
+        if (down.type != PointerEventType.Press) return@awaitEachGesture
+        press.isCtrlPressed = down.keyboardModifiers.isCtrlPressed
+        val onClick =
+            when {
+                down.buttons.isTertiaryPressed -> onMiddleClick
+                down.buttons.isSecondaryPressed -> onRightClick
+                else -> return@awaitEachGesture
+            }
+        down.changes.forEach { it.consume() }
+        val up = waitForUpOrCancellation(PointerEventPass.Initial) ?: return@awaitEachGesture
+        up.consume()
+        onClick()
+    }
+}
